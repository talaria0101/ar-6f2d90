<script>
window.addEventListener("load", function(){
// Get the elements
let dropdown_menu = document.getElementsByClassName('menu-item-has-children');
// Set the aria-haspopup and aria-expanded attributes
for (let i = 0; i < dropdown_menu.length; i++) {
    dropdown_menu[i].setAttribute('aria-haspopup',true);
    dropdown_menu[i].setAttribute('aria-expanded',false);
}

});

jQuery(".menu-item-has-children").mouseover(function(){
   if(jQuery(this).hasClass('et-hover')) {
       jQuery(this).attr('aria-expanded',true);
   }
}).mouseout(function(){
    jQuery(this).attr('aria-expanded',false);
});
	</script>
