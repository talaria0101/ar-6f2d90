function gtag(){
    ga4(...arguments);
    
    if (arguments[0] == 'event' && arguments[1] == 'page_view'){
        gua('send', 'pageview');
        return;
    }

    if (arguments[0] == 'event'){
        let category = arguments[1] || '';
        let o = arguments[2];
        let action = o?.type || o?.action || '';
