    <!-- starts document body content -->
    <body id="arquivo-404" class="arquivo-404-cl">

        <!-- starts skip to main content -->
        <a href="#main-content" id="skip-navigation-links" class="button" role="main" aria-label="skip navigation links and jump to main content">Saltar para o conteúdo principal</a>        <!-- ends skip to main content -->

        <!-- starts 404 main content -->
        <script>
        function initArquivo404(){
            ARQUIVO_NOT_FOUND_404
                .message('<a href=\'{archivedURL}\'>Visite uma versão arquivada da página de {date}</a>')
                .messageElementId('arquivo404-message')
                .call();
        }
        </script>
        <script type="text/javascript" src="/arquivo404.js" async defer onload="initArquivo404()"></script>

        <main> 
            <a id="logo-arquivo-link" href="/"><img id="logo-arquivo" src="/img/logoFace.png" alt="Arquivo.pt"></a>
            <h3>Não conseguimos encontrar a página.</h3>
            <p>Pedimos desculpa por este imprevisto.</p>
            <a href="https://sobre.arquivo.pt/pt/contacto/">Avise-nos do problema</a>
            <a href="/?l=pt">Voltar à página principal</a>
            <div id="arquivo404-message" style="margin-top: 4px;"></div>
        </main>
        <!-- ends 404 main content -->

    </body>
    <!-- ends document body content -->

