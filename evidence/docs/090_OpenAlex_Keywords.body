</style></head><body data-astro-cid-hkbrpulz><header data-astro-cid-hkbrpulz><div class="topbar" data-astro-cid-hkbrpulz><a href="/" class="logo" aria-label="OpenAlex Help home" data-astro-cid-hkbrpulz><img src="/favicon.svg" alt="" height="22" data-astro-cid-hkbrpulz><span class="logo-name" data-astro-cid-hkbrpulz>OpenAlex</span><span class="logo-help" data-astro-cid-hkbrpulz>Help</span></a><div class="nav-right" data-astro-cid-hkbrpulz><button id="search-open" aria-label="Search" title="Search (⌘K)" data-astro-cid-ac66eqjo><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" data-astro-cid-ac66eqjo><circle cx="11" cy="11" r="7" data-astro-cid-ac66eqjo></circle><path d="m20 20-3.5-3.5" data-astro-cid-ac66eqjo></path></svg><span class="search-label" data-astro-cid-ac66eqjo>Search help center…</span><kbd data-kbd-shortcut data-astro-cid-ac66eqjo>⌘K</kbd></button><script type="module">if(!/mac|iphone|ipad|ipod/i.test(navigator.platform||``)){for(let e of document.querySelectorAll(`[data-kbd-shortcut]`))e.textContent=`Ctrl K`;let e=document.getElementById(`search-open`);e&&(e.title=`Search (Ctrl K)`)}</script><dialog id="search-dialog" aria-label="Search the help center" data-astro-cid-ac66eqjo><div class="sd-head" data-astro-cid-ac66eqjo><svg class="sd-head-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" data-astro-cid-ac66eqjo><circle cx="11" cy="11" r="7" data-astro-cid-ac66eqjo></circle><path d="m20 20-3.5-3.5" data-astro-cid-ac66eqjo></path></svg><input id="sd-input" type="search" placeholder="Search (eg: &quot;rate limit&quot;)" autocomplete="off" autocorrect="off" spellcheck="false" aria-controls="sd-body" data-astro-cid-ac66eqjo><button id="sd-clear" type="button" aria-label="Clear search" hidden data-astro-cid-ac66eqjo><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stro