36L5.43,16.66L7.86,15.62C8.63,16.5 9.68,17.14 10.87,17.38L11.24,20H12.76L13.13,17.39C14.32,17.14 15.37,16.5 16.14,15.62L18.57,16.66L19.32,15.36L17.2,13.81C17.6,12.64 17.6,11.37 17.2,10.2L19.31,8.65L18.56,7.35L16.15,8.39C15.38,7.5 14.32,6.86 13.12,6.62L12.75,4H11.25Z"></path></svg></span><span class="label" data-astro-cid-ekafmyw5>API</span></a></div></div><div class="rail-foot" data-astro-cid-ekafmyw5><a href="https://openalex.org" class="item" data-tip-title="App" data-tip-desc="Jump to openalex.org" data-astro-cid-ekafmyw5><span class="pill" data-astro-cid-ekafmyw5><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"></path></svg></span><span class="label" data-astro-cid-ekafmyw5>App</span></a></div><div class="rail-tip" role="tooltip" hidden data-astro-cid-ekafmyw5><span class="rail-tip-desc" data-astro-cid-ekafmyw5></span></div></nav><script type="module">var e=document.querySelector(`.rail`),t=document.querySelector(`.rail-tip`);if(e&&t){let n=t.querySelector(`.rail-tip-desc`),r,i=()=>{clearTimeout(r),t.hidden=!0};for(let a of e.querySelectorAll(`[data-tip-title]`)){let e=()=>{clearTimeout(r),r=window.setTimeout(()=>{n.textContent=a.dataset.tipDesc??``,`tipExt`in a.dataset&&n.insertAdjacentHTML(`beforeend`,`<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/></svg>`),t.hidden=!1;let e=a.getBoundingClientRect();t.style.left=`${e.right+8}px`;let r=Math.min(Math.max(8,e.top+e.height/2-t.offsetHeight/2),window.innerHeight-t.offsetHeight-8);t.style.top=`${r}px`},100)};a.addEventListener(`mouseenter`,e),a.addEventListener(`mouseleave`,i),a.addEventListener(`focus`,e),a.addEventListener(`blur`,i),a.addEventListener(`click`,i)}}</script><main data-astro-cid-hkbrpulz><div class="wrap home" data-astro-cid-lcdefpme><section class="hero reveal" data-astro-cid-lcdefpme><h1 data-astro-cid-lcdefpme>OpenAlex Help Center</h1><p class="subtitle" data-astro-cid-lcdefpme>Get help with <a href="https://openalex.org" data-astro-cid-lcdefpme>OpenAlex</a>, a comprehensive index of the world's research.</p></section><section class="intro reveal" style="animation-delay: 0.08s" data-astro-cid-lcdefpme><p data-astro-cid-lcdefpme><strong data-astro-cid-lcdefpme>Search.</strong> The fastest way to answer a specific question: <button class="search-link" data-search-trigger data-astro-cid-lcdefpme>search the full help center</button>.</p><p data-astro-cid-lcdefpme><strong data-astro-cid-lcdefpme>Learn.</strong> Just starting? Work through the five-minute <a href="/quickstart/" data-astro-cid-lcdefpme>Quickstart</a>, browse the <a href="/how-to/" data-astro-cid-lcdefpme>How-to guides</a> for simple answers, or follow the <a href="/tutorials/" data-astro-cid-lcdefpme>Tutorials</a> for longer, step-by-step recipes.</p><p data-astro-cid-lcdefpme><strong data-astro-cid-lcdefpme>Ask Claude.</strong> Most of what you'd do with OpenAlex, Claude can do for you. Add the free <a href="/how-to/ai-assistants/" data-astro-cid-lcdefpme>OpenAlex connector</a> and ask in plain language. You don't need it, but it makes most things easier. A ChatGPT version is coming soon.</p><p data-astro-cid-lcdefpme><strong data-astro-cid-lcdefpme>Reference.</strong> Dig into the details: <a href="/access/" data-astro-cid-lcdefpme>Access</a> covers getting the data, pricing, and fixing errors; <a href="/data/" data-astro-cid-lcdefpme>Data</a> defines and describes OpenAlex's contents; and the <a href="/api/" data-astro-cid-lcdefpme>API</a> reference documents the REST API.</p><p data-astro-cid-lcdefpme><strong data-astro-cid-lcdefpme>AI agents.</strong> Start at <a href="/llms.txt" data-astro-cid-lcdefpme>help.openalex.org/llms.txt</a>, a plain-text index of every page. Each page also has a markdown version: add <code data-astro-cid-lcdefpme>.md</code> to its URL. No API key? An agent can<a href="/api/authentication/#getting-a-key-for-your-user" data-astro-cid-lcdefpme>get one for its user</a> in one call.</p><p class="chat-para" data-astro-cid-lcdefpme><strong data-astro-cid-lcdefpme>Chat.</strong> Prefer to talk it through? Ask other users in the <a href="https://groups.google.com/g/openalex-community" target="_blank" rel="noopener" data-astro-cid-lcdefpme>Google Group</a>, <a href="https://openalex.org/contact" target="_blank" rel="noopener" data-astro-cid-lcdefpme>report a bug</a> to our team, or <button class="search-link" id="ask-ai-link" data-astro-cid-lcdefpme>ask our docs with your AI</button>.<span class="ai-menu" id="ai-menu" hidden data-astro-cid-lcdefpme><a href="https://claude.ai/new?q=Answer%20my%20question%20using%20the%20OpenAlex%20documentation%20at%20https%3A%2F%2Fhelp.openalex.org%2F%20(machine%20index%3A%20https%3A%2F%2Fhelp.openalex.org%2Fllms.txt).%20My%20question%3A%20" target="_blank" rel="noopener" data-astro-cid-lcdefpme>Claude<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z" data-astro-cid-lcdefpme></path></svg></a><a href="https://chatgpt.com/?q=Answer%20my%20question%20using%20the%20OpenAlex%20documentation%20at%20https%3A%2F%2Fhelp.openalex.org%2F%20(machine%20index%3A%20https%3A%2F%2Fhelp.openalex.org%2Fllms.txt).%20My%20question%3A%20" target="_blank" rel="noopener" data-astro-cid-lcdefpme>ChatGPT<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z" data-astro-cid-lcdefpme></path></svg></a><a href="https://www.perplexity.ai/search?q=Answer%20my%20question%20using%20the%20OpenAlex%20documentation%20at%20https%3A%2F%2Fhelp.openalex.org%2F%20(machine%20index%3A%20https%3A%2F%2Fhelp.openalex.org%2Fllms.txt).%20My%20question%3A%20" target="_blank" rel="noopener" data-astro-cid-lcdefpme>Perplexity<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-astro-cid-lcdefpme><path d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z" data-astro-cid-lcdefpme></path></svg></a></span></p></section></div></main></div><script type="module">var e=`<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`;for(let t of document.querySelectorAll(`.prose h2[id], .prose h3[id], .prose h4[id]`)){let n=document.createElement(`a`);n.className=`h-anchor`,n.href=`#`+t.id,n.setAttribute(`aria-label`,`Link to this section`),n.innerHTML=e,t.appendChild(n),t.classList.add(`has-anchor`),t.addEventListener(`click`,e=>{e.target.closest(`a`)||(location.hash=t.id)})}var t=document.querySelector(`.menu-toggle`),n=document.getElementById(`mobile-menu`);t&&n&&(t.addEventListener(`click`,()=>{let e=n.classList.toggle(`open`);n.hidden=!1,t.setAttribute(`aria-expanded`,String(e))}),document.addEventListener(`keydown`,e=>{e.key===`Escape`&&n.classList.contains(`open`)&&(n.classList.remove(`open`),t.setAttribute(`aria-expanded`,`false`))}));</script></body></html><script type="module">var e=document.getElementById(`ask-ai-link`),t=document.getElementById(`ai-menu`);e&&t&&(e.addEventListener(`click`,()=>{if(t.hidden=!t.hidden,!t.hidden){let n=t.parentElement.getBoundingClientRect(),r=e.getBoundingClientR