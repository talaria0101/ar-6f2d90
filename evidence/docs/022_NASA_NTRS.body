{"stats":{"took":128,"total":75259,"estimate":false,"maxScore":76.62105},"results":[{"_meta":{"score":76.62105},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"approverComments":"Items in TRS are protected by copyright, but are furnished with U.S. government purpose use rights.","containsIndication":true,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"OTHER","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20210004466,"containsThirdPartyMaterial":false,"belongsToPublisher":true,"id":"0cd3ccad283147ec867bf81dc82a7847","belongsToAuthors":false},"keywords":["software","testing","test","designs","software","life","cycle","testing","life","cycle","formal","test","representation","test","specifications","category-partition","method","test","representation","language","TRL"],"exportControl":{"isExportControl":"UNSET","submissionId":20210004466,"ear":"UNSET","id":"6d22a2e65fd44f11a22186e1f208eecc","itar":"UNSET"},"created":"1993-05-25T00:00:00.0000000+00:00","distributionDate":"1993-05-25T00:00:00.0000000+00:00","center":{"code":"JPL","name":"Jet Propulsion Laboratory","id":"efbc9c123a0f47caafa95d99b7d2e1a1"},"onlyAbstract":false,"sensitiveInformation":0,"abstract":"This article discusses the application of the Category-Partition Method to the test design phase. The method provides a formal framework for reducing the total number of possible test cases to a minimum logical subset for effective testing. An automatic tool and a formal language have been developed to implement the method and produce the specification of test cases","title":"Formal Functional Test Designs with a Test Representation Language","stiType":"OTHER","distribution":"PUBLIC","authorAffiliations":[{"sequence":0,"submissionId":20210004466,"meta":{"author":{"name":"Hops, Jonathan M."}},"id":"eef04612a1e04c9fae12f406f57d937d"}],"disseminated":"METADATA_ONLY","stiTypeDetails":"Other","technicalReviewType":"NOT_SET","modified":"2025-08-31T18:39:21.7150190+00:00","id":20210004466,"sourceIdentifiers":[{"number":"2014/35094","submissionId":20210004466,"id":"6b56ecaf5f5c4d398456ed230d8bc3a5","type":"HANDLE"}],"publications":[{"submissionId":20210004466,"publisher":"UNKNOWN","id":"67090f0500e64905a805caa119032203","publicationDate":"1993-05-25T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":false,"index":"submissions-2026-10-15-05-24"},{"_meta":{"score":74.41109},"copyright":{"disclosedToPublic":false,"approverComments":"Distribution within the U.S. granted by agreement","containsIndication":true,"publisherPermissionOrRightsToDistribute":true,"belongsToUsGov":false,"determinationType":"MAY_INCLUDE_COPYRIGHT_MATERIAL","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":19840026325,"containsThirdPartyMaterial":false,"belongsToPublisher":true,"id":"beccfd4d21544d9eaa50868fcb2d05d6","belongsToAuthors":false},"subjectCategories":["Aircraft Design, Testing and Performance"],"keywords":["Checkout","Avionic test units","Performance tests","Flight characteristics","Flight tests"],"exportControl":{"isExportControl":"NO","submissionId":19840026325,"ear":"NO","id":"8d3e1b859f964aea8eaaf0007afec124","itar":"NO"},"distributionDate":"1995-11-13T05:00:00.0000000+00:00","otherReportNumbers":["AD-A147625","AGARD-CP-373"],"title":"Flight Test Techniques","stiType":"CONFERENCE_PROCEEDINGS","distribution":"PUBLIC","submittedDate":"2013-09-04T16:20:00.0000000+00:00","authorAffiliations":[{"organizationId":"79adfde0cfc65da1887f20a9dbafffbf","sequence":0,"submissionId":19840026325,"meta":{"author":{"name":"Advisory Group for Aerospace Research and Development"},"organization":{"name":"North Atlantic Treaty Organization","location":"Brussels, Belgium"}},"id":"55594ce2e18641f8ac9d4128d4cb3ccd","userType":"OTHER"}],"stiTypeDetails":"Conference Proceedings","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":19840026325,"sourceIdentifiers":[{"number":"https://apps.dtic.mil/sti/citations/ADA147625","submissionId":19840026325,"id":"94811bad6dc34a758e5cc0076d507ab9","descriptor":"DTIC","type":"URL"}],"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"84N34396"},"created":"2013-09-04T16:20:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"These proceedings contain the twenty-five papers presented a the AGARD Flight Mechanics Panel Symposium on Flight Test Techniques, held in Lisbon, Portugal, 2-5 April 1984. Under main headings of Performance and Flying Qualities, Systems Testing, and Instrumentation and Facilities, papers were given on Lift-Drag; Parameter Identification; High-Angle Testing; Flight and Release of External Stores; Pilot Workload; Avionics, Navigation and Weapons Systems; H.U.D.; Real-Time Analysis and Test Control; Airborne Computation and Calibration; Laser Measurement of True Airspeed and Windshear; Clearance for Repaired Runway Operation.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":19840026325,"id":"7cb5a3d12f9e40f1a04f4b75498d0909"},"meetings":[{"country":"PT","submissionId":19840026325,"endDate":"1984-04-05T05:00:00.0000000+00:00","sponsors":[{"organizationId":"79adfde0cfc65da1887f20a9dbafffbf","meta":{"organization":{"name":"North Atlantic Treaty Organization","location":"Brussels, Belgium"}},"meetingId":"901d3dfca12b4d87a95c0aaf3f7009ec","id":"4ecea6ba907d4e958648f6df68902f22"}],"name":"AGARD Flight Mechanics Panel Symposium","location":"Lisbon","id":"901d3dfca12b4d87a95c0aaf3f7009ec","startDate":"1984-04-02T05:00:00.0000000+00:00"}],"publications":[{"submissionId":19840026325,"isbn":"9283503597","publisher":"North Atlantic Treaty Organization","id":"a3b9d00cf2964d8e95637e46655ac01b","publicationName":"Flight Test Techniques","publicationDate":"1984-07-01T04:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":19840026350,"type":"ANALYTIC_SUBSIDIARY","title":"The Development of an Airborne Instrumentation Computer System for Flight Test","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"METADATA_ONLY","id":19840026326,"type":"ANALYTIC_SUBSIDIARY","title":"Determination of External Store Drag","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"METADATA_ONLY","id":19840026327,"type":"ANALYTIC_SUBSIDIARY","title":"The Flight Test of an Automatic Spin Prevention System","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"19840026325.pdf","type":"STI","links":{"original":"/api/citations/19840026325/downloads/19840026325.pdf","pdf":"/api/citations/19840026325/downloads/19840026325.pdf","fulltext":"/api/citations/19840026325/downloads/19840026325.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-15-05-24"},{"_meta":{"score":73.803},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20240007574,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"137a9dc62776490a8e90b9090fe4e609","belongsToAuthors":false},"subjectCategories":["Spacecraft Propulsion and Power","Spacecraft Design, Testing and Performance"],"keywords":["spacecraft","priming","waterhammer","test","analysis","Thermal Desktop","FloCAD","data","fluid","transient","peak pressure","natural frequency","vacuum priming","in-space","propulsion","surge","testing"],"exportControl":{"isExportControl":"NO","submissionId":20240007574,"ear":"NO","id":"3dd7b260365142f1af87fe521af37584","itar":"NO"},"distributionDate":"2024-06-28T05:00:00.0000000+00:00","fundingNumbers":[{"number":"981698.01.01.62.40.02","submissionId":20240007574,"id":"5c2a23de875c4767846378e377113754","type":"WBS"},{"number":"829688.13.05.02.01.01","submissionId":20240007574,"id":"bafd810df67440fda6bf54240e9d995c","type":"WBS"}],"title":"Spacecraft Priming Analysis and Research Test Apparatus: Number 1 (SPARTAN 1), Test and Analysis Results","stiType":"TECHNICAL_PUBLICATION","distribution":"PUBLIC","submittedDate":"2024-06-12T21:01:29.1834360+00:00","authorAffiliations":[{"organizationId":"ff293352e05b51ca965411fc94f5e325","sequence":0,"submissionId":20240007574,"meta":{"author":{"orcidId":"","name":"Jonathan A Bentley"},"organization":{"name":"Marshall Space Flight Center","location":"Redstone Arsenal, United States"}},"id":"095fc97f47d141398653575264bd65e8","userType":"CIVIL","userId":"6399e0c6b94b455ba690391fe5136348"},{"organizationId":"ff293352e05b51ca965411fc94f5e325","sequence":1,"submissionId":20240007574,"meta":{"author":{"orcidId":"","name":"Cody L Gilliland"},"organization":{"name":"Marshall Space Flight Center","location":"Redstone Arsenal, United States"}},"id":"649bfd71e2c84d1481cbd8596b3b39f3","userType":"CIVIL","userId":"4701bf6dfaf54c6fa092389ce5762ab9"},{"organizationId":"ff293352e05b51ca965411fc94f5e325","sequence":2,"submissionId":20240007574,"meta":{"author":{"orcidId":"","name":"Joshua D Rogan"},"organization":{"name":"Marshall Space Flight Center","location":"Redstone Arsenal, United States"}},"id":"f84faa996a11412aa50f138fe2edf500","userType":"CIVIL","userId":"6838e003f5ed40f3a74151a38d9404e8"}],"stiTypeDetails":"Technical Publication (TP)","technicalReviewType":"NASA_PEER_COMMITTEE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20240007574,"created":"2024-06-12T20:11:54.2047510+00:00","center":{"code":"MSFC","name":"Marshall Space Flight Center","id":"a589fc1e68af409f9d2214bb08863d11"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Spacecraft with Earth-storable propellants are required by range safety to launch with propellant isolated from the thrusters for ground operations, which is often accomplished by placing a pyrotechnic, or a latching isolation valve between the tank and the thrusters. Once on-orbit, downstream lines are vented out to space through the thrusters and are left evacuated and at vacuum pressure. Propellant isolation valve then opens and floods the lines with high velocity propellant which can lead to a significant pressure surge upon filling. Replicating this event during ground testing using water as a propellant simulant has always been difficult and costly to accurately perform due to the low vacuum pressure targeted on the downstream side of the system. This report describes the Spacecraft Priming Analysis and Research Test Apparatus (SPARTA) at Marshall Space Flight Center’s (MSFC) Component Development Area (CDA) and the initial test series meant to be a pathfinder for construction methods and test procedures to reduce the cost of future testing. The test data collected are critical to analytical models as the details to replicate prior ground tests are often lacking in enough detail to adequately model the test that was conducted. This report also describes the Thermal Desktop/FloCAD analysis that was performed alongside the test series. The test methods defined for this campaign showed a dramatic improvement on heritage test procedures. Test pace increased due to faster drying and pulling vacuum more effectively. Results generated in this test matched analytical predictions very well and provide a releasable set of test data to be leveraged on future NASA and commercial partner spacecraft development programs.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":20240007574,"id":"53bd74b59bde477484dd1495ce8e89ef"},"publications":[{"submissionId":20240007574,"id":"94460059b000417cb09d6989445659e4","publicationDate":"2024-06-01T04:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"2024 SPARTAN 1 Test and Analysis Report.pdf","notes":"false positive - no proprietary info in STI","type":"STI","links":{"original":"/api/citations/20240007574/downloads/2024%20SPARTAN%201%20Test%20and%20Analysis%20Report.pdf","pdf":"/api/citations/20240007574/downloads/2024%20SPARTAN%201%20Test%20and%20Analysis%20Report.pdf","fulltext":"/api/citations/20240007574/downloads/2024%20SPARTAN%201%20Test%20and%20Analysis%20Report.pdf.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-15-05-24"},{"_meta":{"score":73.54867},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"licenseType":"NO","submissionId":20205011830,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"9bb13e17126f410b86da2e2580bccedb","belongsToAuthors":false},"subjectCategories":["Engineering (General)"],"keywords":["Cryogenic Fluid Management","Leak Test"],"exportControl":{"isExportControl":"NO","submissionId":20205011830,"ear":"NO","id":"2a81fa0f3e1942ae886ed0726d4635f0","itar":"NO"},"distributionDate":"2021-01-25T05:00:00.0000000+00:00","fundingNumbers":[{"number":" 954879.04.20.76.01 ","submissionId":20205011830,"id":"045672ba311846fa8c714f21af11961f","type":"WBS"}],"title":"Fitting Leak Test Report","stiType":"OTHER","distribution":"PUBLIC","submittedDate":"2020-12-29T15:27:03.6053590+00:00","authorAffiliations":[{"organizationId":"5c929cce29b0585fb37efe77c6e9d156","sequence":0,"submissionId":20205011830,"meta":{"author":{"orcidId":"","name":"Jared Sass"},"organization":{"name":"Kennedy Space Center","location":"Merritt Island, Florida, United States"}},"id":"862d23e4e4ad439eb114528efb68f50e","userType":"CIVIL","userId":"753bdd1bd95344bfb844f9c99f3a8482"},{"organizationId":"5c929cce29b0585fb37efe77c6e9d156","sequence":1,"submissionId":20205011830,"meta":{"author":{"orcidId":"","name":"Angela Krenn"},"organization":{"name":"Kennedy Space Center","location":"Merritt Island, Florida, United States"}},"id":"e5411038e74c44c2ae4d8ebd25f1b00d","userType":"CIVIL","userId":"ecf0aed850ff41a0804ce9bf60b8799a"}],"stiTypeDetails":"Other - Test Report","technicalReviewType":"NASA_PEER_COMMITTEE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20205011830,"created":"2020-12-29T00:36:33.6623140+00:00","center":{"code":"KSC","name":"Kennedy Space Center","id":"a74d241e0e974719b03cb45cbace6b20"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Many Human Landing System flight elements are anticipated to implement mechanically connected joints in cryogenic fluid lines to simplify system assembly. These joints will need to survive launch vibration, while cold, and remain as leak‐free as possible to minimize commodity loss. Threaded fluid fittings should be qualified for use in their expected environments to reduce risk and ensure mission success. A new ground‐based test apparatus was developed and validated to obtain quantifiable low leak rate test data for a small component, such as a pressurized threaded fluid fitting, while in the temperature range of liquid hydrogen. A cryocooler is used to attain the cold test temperature and helium leakage from a pressurized fitting mounted within a vacuum test chamber is measured using a mass spectrometer leak detector. Two different sizes of Swagelok VCR fittings with three different types of seal rings were selected as the test articles for the initial proof of concept testing. Each fitting configuration was subjected to two consecutive cryogenic thermal cycles and cold leak measurement tests, followed by exposure to a high vibration test profile at ambient temperature on a shaker table, and then two additional cold leak measurement tests. Very low leak rates, below the acceptable leak rate threshold, were measured at the pressures tested. Several enhancements to the test hardware are discussed that would facilitate a comprehensive fitting qualification test campaign by enabling a higher test throughput rate and ensuring a repeatable test profile.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","meetings":[{"country":"US","submissionId":20205011830,"name":"","location":"","id":"fbfb798e300140ab89a000000e9ac5d8"}],"publications":[{"submissionId":20205011830,"id":"cb1be3954c774e27baa00ae3077cbb81","publicationDate":"2020-12-28T05:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"Fitting Leak Test Report Public Release - Dec 2020.pdf","type":"STI","links":{"original":"/api/citations/20205011830/downloads/Fitting%20Leak%20Test%20Report%20Public%20Release%20-%20Dec%202020.pdf","pdf":"/api/citations/20205011830/downloads/Fitting%20Leak%20Test%20Report%20Public%20Release%20-%20Dec%202020.pdf","fulltext":"/api/citations/20205011830/downloads/Fitting%20Leak%20Test%20Report%20Public%20Release%20-%20Dec%202020.pdf.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-15-05-24"},{"_meta":{"score":73.20074},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"approverComments":"Distribution within the U.S. granted by agreement","containsIndication":true,"publisherPermissionOrRightsToDistribute":true,"belongsToUsGov":false,"determinationType":"MAY_INCLUDE_COPYRIGHT_MATERIAL","thirdPartyContentCondition":"SUBMITTER_HAS_BEEN_ADVISED","belongsToContractor":false,"disclosedInvention":false,"licenseType":"OPEN_ACCESS","submissionId":19940029434,"containsThirdPartyMaterial":true,"belongsToPublisher":true,"thirdPartyAgreement":true,"id":"b0389c26c72c4dd892c455e4a0e4b36c","belongsToAuthors":false},"subjectCategories":["Aircraft Design, Testing and Performance","Instrumentation And Photography"],"keywords":["procedures","information flow","data processing equipment","costs","flight tests automatic control","flight test instruments","engineers","data processing","data acquisition","civil aviation","channels (data transmission)"],"exportControl":{"isExportControl":"NO","submissionId":19940029434,"ear":"NO","id":"9f581963a75c469fa89db3ead43afae2","category":[{"submissionExportControlId":"9f581963a75c469fa89db3ead43afae2","id":"5874d860f8f6453e90e151aea13a1046","category":0}],"itar":"NO"},"distributionDate":"1995-12-28T08:00:00.0000000+00:00","otherReportNumbers":["ISBN: 92-835-0731-2","AD-A282984","AGARD-AG-160-VOL-1-ISSUE-2"],"title":"Basic principles of flight test instrumentation engineering, volume 1, issue 2","stiType":"OTHER","distribution":"PUBLIC","submittedDate":"2013-08-16T14:06:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":19940029434,"meta":{"author":{"name":"R.W. Borek"},"organization":{"name":"Dryden Flight Research Center","location":"Edwards, CA., United States"}},"id":"ca3387f3bb8840e9b4281077a6a84c3b","userType":"OTHER"},{"organizationId":"935914e06be7572d8cc83ab20250f9fb","sequence":1,"submissionId":19940029434,"meta":{"author":{"name":"A. Pool "},"organization":{"name":"National Aerospace Laboratory","location":"Amsterdam, Netherlands"}},"id":"448656ad32954a689499ac33959835d9","userType":"OTHER"}],"stiTypeDetails":"Other - Technical Report","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2026-03-27T17:58:50.1605280+00:00","id":19940029434,"sourceIdentifiers":[{"number":"https://www.sto.nato.int/document/basic-principles-of-flight-test-instrumentation-engineering-volume-1-issue-2/","submissionId":19940029434,"id":"e11fb6992e4e4a128c4e107a982521c9","descriptor":"AGARD-AG-160-VOL-1-ISSUE-2","type":"URL"}],"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"94N33940"},"created":"2013-08-16T14:06:00.0000000+00:00","center":{"code":"AFRC","name":"Armstrong Flight Research Center","id":"e73d2557fd354e1990dafbf2de9bce78"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Volume 1 of the AG 300 series on ´Flight Test Instrumentation´ gives a general introduction to the basic principles of flight test instrumentation. The other volumes in the series provide more detailed treatments of selected topics on flight test instrumentation. Volume 1, first published in 1974, has been used extensively as an introduction for instrumentation courses and symposia, as well as being a reference work on the desk of most flight test and instrumentation engineers. It is hoped that this second edition, fully revised, will be used with as much enthusiasm as the first edition. In this edition a flight test system is considered to include both the data collection and data processing systems. In order to obtain an optimal data flow, the overall design of these two subsystems must be carefully matched; the detail development and the operation may have to be done by separate groups of specialists. \n\nThe main emphasis is on the large automated instrumentation systems used for the initial flight testing of modern military and civil aircraft. This is done because there, many of the problems, which are discussed here, are more critical. It does not imply, however, that smaller systems with manual data processing are no longer used. In general, the systems should be designed to provide the required results at the lowest possible cost. For many tests which require only a few parameters, relatively simple systems are justified, especially if no complex equipment is available to the user. Although many of the aspects discussed in this volume apply to both small and large systems, aspects of the smaller systems are mentioned only when they are of special interest. \n\nThe volume has been divided into three main parts. Part 1 defines the main starting points for the design of a flight test instrumentation system, as seen from the points of view of the flight test engineer and the instrumentation engineer. In Part 2 the discussion is concentrated on those aspects which apply to each individual measuring channel, and in Part 3 the main emphasis is on the integration of the individual data channels into one data collection system and on those aspects of the data processing which apply to the complete system.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","cui":{"isCui":false,"submissionId":19940029434,"id":"0e4ceccf527f44da99066bd280abef15"},"publications":[{"volume":"1","submissionId":19940029434,"issue":"2","isbn":"92-835-0731-2","publisher":"Advisory Group for Aerospace Research & Development","id":"5828b7f6c5644f3096b339859f1be4a4","publicationName":"AGARDograph 160 Flight Test Instrumentation Series","publicationDate":"1994-03-01T05:00:00.0000000+00:00","issuePublicationDate":"1994-03-01T05:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":true,"index":"submissions-2026-10-15-05-24"},{"_meta":{"score":72.69012},"copyright":{"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":19860013130,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"1c30435cdd4245638d78e5927dbd9f9c","belongsToAuthors":false},"subjectCategories":["Ground Support Systems And Facilities (Space)"],"keywords":["Alloys","Metals","Aerospace Fluids","Oxygen","Impact","Flammability","Components Test","Materials Test"],"exportControl":{"isExportControl":"NO","submissionId":19860013130,"ear":"NO","id":"2c1f387467c64001955f8a643598d5bd","category":[{"submissionExportControlId":"2c1f387467c64001955f8a643598d5bd","id":"56589c436c8343b886ed7e1a248d0cc8","category":0}],"itar":"NO"},"distributionDate":"1995-11-04T05:00:00.0000000+00:00","title":"Materials Test Laboratory activities at the NASA-Johnson Space Center White Sands Test Facility (WSTF)","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-12T17:40:00.0000000+00:00","authorAffiliations":[{"organizationId":"51d92752487149f08037942e2302fbf7","sequence":0,"submissionId":19860013130,"meta":{"author":{"name":"J Stradling"},"organization":{"name":"White Sands Test Facility","location":"Las Cruces, United States"}},"id":"2c8542edd70f4fba886fd15f0d378497","userType":"OTHER"},{"organizationId":"51d92752487149f08037942e2302fbf7","sequence":1,"submissionId":19860013130,"meta":{"author":{"name":"D L Pippen"},"organization":{"name":"White Sands Test Facility","location":"Las Cruces, United States"}},"id":"ee7586f3411b483789859f9a37f7b186","userType":"OTHER"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2026-02-06T16:59:17.1792850+00:00","id":19860013130,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"86N22601"},"created":"2013-08-12T17:40:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The NASA Johnson Space Center White Sands Test Facility (WSTF) performs aerospace materials testing and evaluation. Established in 1963, the facility grew from a NASA site dedicated to the development of space engines for the Apollo project to a major test facility. In addition to propulsion tests, it tests materials and components, aerospace fluids, and metals and alloys in simulated space environments.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","cui":{"isCui":false,"submissionId":19860013130,"id":"6c7a2b75a6a4404fab90fcb63147b30e"},"meetings":[{"country":"NL","submissionId":19860013130,"endDate":"1985-10-04T04:00:00.0000000+00:00","sponsors":[{"organizationId":"76126afc7b1740acbb11eff188aed944","meta":{"organization":{"name":"Centre d'Etudes et de Recherches de Toulouse"}},"meetingId":"de75138db2ac4a8a843374d80bf814b7","id":"48186ce526a54c7da9566c95ff98ee39"},{"organizationId":"b0221f1ce1ef51ee8a631a09496c2364","meta":{"organization":{"name":"Centre National d'Études Spatiales","location":"Paris, France"}},"meetingId":"de75138db2ac4a8a843374d80bf814b7","id":"74e32a7b894246029f45eed7beef510d"},{"organizationId":"d843f4f3dd0352f2808ffc1b2eadd095","meta":{"organization":{"name":"European Space Agency","location":"Paris, France"}},"meetingId":"de75138db2ac4a8a843374d80bf814b7","id":"b7fc52180aa345bb9e23b6148b739312"}],"name":"Third European Symposium on Spacecraft Materials in Space Environment","location":"Noordwijk","id":"de75138db2ac4a8a843374d80bf814b7","startDate":"1985-10-01T04:00:00.0000000+00:00"}],"publications":[{"submissionId":19860013130,"issn":"0379-6566","publisher":"European Space Agency","id":"3cbc37b65bb44d128841543a259a34d4","publicationName":"Proceedings of the Third European Symposium on Spacecraft Materials in Space Environment","publicationDate":"1985-11-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":true,"index":"submissions-2026-10-15-05-24"},{"_meta":{"score":71.27368},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20140013077,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"c3b60187daba47b49bca606ccb8d8f9d","belongsToAuthors":false},"subjectCategories":["Aircraft Design, Testing And Performance"],"keywords":["Large Rotor Test Apparatus","Dynamic Calibration Efforts","Shake Test Results"],"exportControl":{"isExportControl":"NO","submissionId":20140013077,"ear":"NO","id":"584d1ddbda354633a44edf220e033ab7","itar":"NO"},"distributionDate":"2019-07-12T00:00:00.0000000+00:00","otherReportNumbers":["ARC-E-DAA-TN12524","Report Number: ARC-E-DAA-TN12524"],"title":"Shake Test Results and Dynamic Calibration Efforts for the Large Rotor Test Apparatus","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2014-10-17T08:37:25.4930000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20140013077,"meta":{"author":{"name":"Russell, Carl R."},"organization":{"name":"NASA Ames Research Center","location":"Moffett Field, CA United States"}},"id":"523b5425aa0a471a84c653961e4076fc"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20140013077,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2014-10-17T08:37:25.4930000+00:00","center":{"code":"ARC","name":"Ames Research Center","id":"4540cd94d24c4bf29f8773a27faf96b2"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Prior to the full-scale wind tunnel test of the UH-60A Airloads rotor, a shake test was completed on the Large Rotor Test Apparatus. The goal of the shake test was to characterize the oscillatory response of the test rig and provide a dynamic calibration of the balance to accurately measure vibratory hub loads. This paper provides a summary of the shake test results, including balance, shaft bending gauge, and accelerometer measurements. Sensitivity to hub mass and angle of attack were investigated during the shake test. Hub mass was found to have an important impact on the vibratory forces and moments measured at the balance, especially near the UH-60A 4/rev frequency. Comparisons were made between the accelerometer data and an existing finite-element model, showing agreement on mode shapes, but not on natural frequencies. Finally, the results of a simple dynamic calibration are presented, showing the effects of changes in hub mass. The results show that the shake test data can be used to correct in-plane loads measurements up to 10 Hz and normal loads up to 30 Hz.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","meetings":[{"country":"United States","submissionId":20140013077,"endDate":"2014-01-24T00:00:00.0000000+00:00","sponsors":[{"organizationId":"bd27934555aa4c0fb8d7cd2b03c65c48","meta":{"organization":{"name":"AHS International"}},"meetingId":"5874fee59fdc40e4bcef93f36dd25d5e","id":"badab0f73a4949ce8039e101cf322af4"}],"name":"Decennial AHS Aeromechanics Specialists'' Conference","location":"San Francisco, CA","id":"5874fee59fdc40e4bcef93f36dd25d5e","startDate":"2014-01-22T00:00:00.0000000+00:00"}],"publications":[{"submissionId":20140013077,"id":"43ca205af80646d8a020a68ff6142b63","publicationDate":"2014-01-22T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":20140011306,"type":"SEE_ALSO","title":"Shake Test Results and Dynamic Calibration Efforts for the Large Rotor Test Apparatus","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":20140011306,"type":"SEE_ALSO","title":"Shake Test Results and Dynamic Calibration Efforts for the Large Rotor Test Apparatus","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20140013077.pdf","type":"STI","links":{"original":"/api/citations/20140013077/downloads/20140013077.pdf","pdf":"/api/citations/20140013077/downloads/20140013077.pdf","fulltext":"/api/citations/20140013077/downloads/20140013077.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-15-05-24"},{"_meta":{"score":70.241486},"copyright":{"disclosedToPublic":false,"approverComments":"Distribution within the U.S. granted by agreement","containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"OTHER","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20050209972,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"b0528513ebe64196af3927a2c78e8fec","belongsToAuthors":false},"subjectCategories":["Aircraft Communications and Navigation","Avionics and Aircraft Instrumentation"],"exportControl":{"isExportControl":"NO","submissionId":20050209972,"ear":"NO","id":"4ac0534347d7429fb2c339b80287ca63","category":[{"submissionExportControlId":"4ac0534347d7429fb2c339b80287ca63","id":"7d88f2a262514c449750445591f4e5d3","category":0}],"itar":"NO"},"distributionDate":"2005-09-07T04:00:00.0000000+00:00","otherReportNumbers":["RTO-AG-300-V14"],"title":"Chapter 6 - Flight Test Instrumentation","stiType":"OTHER","distribution":"PUBLIC","submittedDate":"2013-08-23T11:49:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20050209972,"meta":{"author":{"name":"David R Crounse"},"organization":{"name":"US Air Force Flight Test Center","location":"Edwards AFB, CA, United States"}},"id":"206a616c0a004d88bf8df3aad69f4542","userType":"OTHER"}],"stiTypeDetails":"Other - Technical Report","technicalReviewType":"SINGLE_EXPERT","modified":"2026-07-15T19:50:47.1200940+00:00","id":20050209972,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-23T11:49:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The purpose of a flight test instrumentation system is to acquire data about the operation of the test vehicle and provide the data to the data processing group. As a flight test engineer (FTE), no matter what discipline, the FTE needs to define the measurands needed for the assigned tasks to the instrumentation engineer. In general, a test article will support multiple discipline testing. Many measurands are requested by more than one user and the FTE needs to coordinate with engineers from other disciplines to define those measurands. Other measurands are exclusively the lead FTE's. All must be defined in detail. A great deal of detailed information is required to prepare and implement an adequate instrumentation specification. This section will provide some general information on the elements that make up an instrumentation system and provide guidance on where to find additional information. AGARDograph 160, the Flight Test Instrumentation Series of volumes, provides a wealth of information equally useful to the neophyte or journeyman engineer.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","cui":{"isCui":false,"submissionId":20050209972,"id":"ec045af4936c46bdbfb9a483f9ed1c6c"},"publications":[{"volume":"14","submissionId":20050209972,"isbn":"9283711262","publisher":"North Atlantic Treaty Organization","id":"355d70b796de4718adaba527f9c8d2f9","publicationName":"Introduction to Flight Test Engineering [Introduction Aux Techniques Des Essais En Vol]","publicationDate":"2005-07-01T04:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"METADATA_ONLY","id":20050209967,"type":"ANALYTIC_PRIMARY","title":"Introduction to Flight Test Engineering [Introduction Aux Techniques Des Essais En Vol]","stiType":"OTHER","distribution":"PUBLIC","status":"CURATED"}],"downloads":[],"downloadsAvailable":true,"index":"submissions-2026-10-15-05-24"},{"_meta":{"score":69.69554},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20140010193,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"cd9c92b8db5340699b7a8f5a9fd0ec06","belongsToAuthors":false},"subjectCategories":["Air Transportation And Safety","Aircraft Stability And Control","Aircraft Design, Testing And Performance"],"keywords":["sideslip","crosswind","flight test technique"],"exportControl":{"isExportControl":"NO","submissionId":20140010193,"ear":"NO","id":"8d906846b9a44f6da966ed8494b9c4b0","itar":"NO"},"distributionDate":"2019-07-17T00:00:00.0000000+00:00","otherReportNumbers":["DFRC-E-DAA-TN11330","Report Number: DFRC-E-DAA-TN11330"],"fundingNumbers":[{"number":"WBS 699959.02.23.02.03.02.07","submissionId":20140010193,"id":"ccb6e4826e5045a28360afd90a0a338b","type":"WBS"}],"title":"Reverse Engineering Crosswind Limits - A New Flight Test Technique?","stiType":"PRESENTATION","distribution":"PUBLIC","submittedDate":"2014-07-28T12:52:39.3430000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20140010193,"meta":{"author":{"name":"Asher, Troy A."},"organization":{"name":"NASA Dryden Flight Research Center","location":"Edwards, CA United States"}},"id":"89bae7eb5b1e49f78c80415c3ba86130"},{"sequence":1,"submissionId":20140010193,"meta":{"author":{"name":"Willliams, Timothy L."},"organization":{"name":"NASA Dryden Flight Research Center","location":"Edwards, CA United States"}},"id":"8917f17240a8426c9bd48c5642e2bbbc"},{"sequence":2,"submissionId":20140010193,"meta":{"author":{"name":"Strovers, Brian K."},"organization":{"name":"NASA Dryden Flight Research Center","location":"Edwards, CA United States"}},"id":"187a9e5abbf1431f961c3d5e491f2d31"}],"stiTypeDetails":"Presentation","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20140010193,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2014-07-28T12:52:39.3430000+00:00","center":{"code":"AFRC","name":"Armstrong Flight Research Center","id":"e73d2557fd354e1990dafbf2de9bce78"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"During modification of a Gulfstream III test bed aircraft for an experimental flap project, all roll spoiler hardware had to be removed to accommodate the test article. In addition to evaluating the effects on performance and flying qualities resulting from the modification, the test team had to determine crosswind limits for an airplane previously certified with roll spoilers. Predictions for the modified aircraft indicated the maximum amount of steady state sideslip available during the approach and landing phase would be limited by aileron authority rather than by rudder. Operating out of a location that tends to be very windy, an arbitrary and conservative wind limit would have either been overly restrictive or potentially unsafe if chosen poorly. When determining a crosswind limit, how much reserve roll authority was necessary? Would the aircraft, as configured, have suitable handling qualities for long-term use as a flying test bed? To answer these questions, the test team combined two typical flight test techniques into a new maneuver called the sideslip-to-bank maneuver, and was able to gather flying qualities data, evaluate aircraft response and measure trends for various crosswind scenarios. This paper will describe the research conducted, the maneuver, flight conditions, predictions, and results from this in-flight evaluation of crosswind capability.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","meetings":[{"submissionId":20140010193,"name":"Society of Experimental Test Pilots","location":"Lancaster, CA, United States","id":"5ccbd547fbe9416988ea51ef4722e4ff"},{"country":"United States","submissionId":20140010193,"sponsors":[{"meta":{"organization":{"name":"Society of Experimental Test Pilots","location":"Lancaster, CA, United States"}},"meetingId":"18b1293a19c74af09abd5fdd03dd64c0","id":"749796f230df4c459cf1c5068a40e277"}],"name":"Society of Experimental Test Pilots","location":"Anahiem/CA","id":"18b1293a19c74af09abd5fdd03dd64c0"}],"publications":[{"submissionId":20140010193,"id":"ac6112f2c2224873b25d2e85ae0ddb51","publicationDate":"2013-09-27T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20140010193.pdf","type":"STI","links":{"original":"/api/citations/20140010193/downloads/20140010193.pdf","pdf":"/api/citations/20140010193/downloads/20140010193.pdf","fulltext":"/api/citations/20140010193/downloads/20140010193.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-15-05-24"},{"_meta":{"score":69.56035},"copyright":{"thirdPartyPermissionsProduced":true,"disclosedToPublic":false,"approverComments":"Distribution within the U.S. granted by agreement","containsIndication":true,"publisherPermissionOrRightsToDistribute":true,"belongsToUsGov":false,"determinationType":"MAY_INCLUDE_COPYRIGHT_MATERIAL","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"licenseType":"OPEN_ACCESS","submissionId":20050209967,"containsThirdPartyMaterial":true,"belongsToPublisher":true,"thirdPartyAgreement":true,"id":"88aa139af50842a4ba05da89a6b8fc16","belongsToAuthors":false},"subjectCategories":["Aircraft Design, Testing and Performance"],"keywords":["Test facilities","Test equipment","Systems analysis","Strain measurement","Specifications","Safety engineering","Reporting","Project planning","Project management","Operational effectiveness","Methodology","Hydraulic equipment","Flight tests","Flight maneuvers","Flight control","External stores","Experimental data","Data acquisition","Certification","Avionics","Aviation safety","Aircraft","Airborne equipment","AGARD","Aeroelasticity","Aerodynamic stability"],"exportControl":{"isExportControl":"NO","submissionId":20050209967,"ear":"NO","id":"6bc40ee7b5414c728d5faa4832bcaf9a","category":[{"submissionExportControlId":"6bc40ee7b5414c728d5faa4832bcaf9a","id":"d5399edba5a94566a1bc42d3109d9c13","category":0}],"itar":"NO"},"distributionDate":"2005-09-07T04:00:00.0000000+00:00","otherReportNumbers":["RTO-AG-300-V14","AC/323(SCI-FT3)TP/74 ","SCI-FT3"],"title":"Introduction to Flight Test Engineering [Introduction Aux Techniques Des Essais En Vol]","stiType":"OTHER","distribution":"PUBLIC","submittedDate":"2013-08-23T11:49:00.0000000+00:00","authorAffiliations":[{"organizationId":"79adfde0cfc65da1887f20a9dbafffbf","sequence":0,"submissionId":20050209967,"meta":{"author":{"name":"Fred N Stoliker"},"organization":{"name":"North Atlantic Treaty Organization","location":"Brussels, Belgium"}},"id":"44ab0290a0704da1958692bf0c575f61","userType":"OTHER"}],"stiTypeDetails":"Other - AGARDograph 300","technicalReviewType":"NASA_TECHNICAL_MANAGEMENT","modified":"2026-07-15T19:44:26.4285640+00:00","id":20050209967,"sourceIdentifiers":[{"number":"https://www.sto.nato.int/document/introduction-to-flight-test-engineering-2/","submissionId":20050209967,"id":"3df061c519aa43459eb6753939c41b56","type":"URL"}],"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-23T11:49:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Flight test is at the core of what organizations must do in order to validate the operation and systems on an aircraft. While the AGARDograph series 300 and 160 series deal with aspects of this testing, this volume pulls it all together as an introduction to the process required to do effective flight test engineering. This volume was originally published in 1995. Its utility has been proven in that many flight test organizations and universities have requested copies for their engineers and students. It was felt that re-issuing it in a new format designed for electronic publication would be valuable to the community. This second printing changes none of the text, but rather reformats it. All the original references to AGARD (instead of RTO) are left in place so that none of the flavor of the original publication is lost. This is the Introductory Volume to the Flight Test Techniques Series. It is a general introduction to the various activities and aspects of Flight Test Engineering that must be considered when planning, conducting, and reporting a flight test program. Its main intent is to provide a broad overview to the novice engineer or to other people who have a need to interface with specialists within the flight test community. The first two Sections provide some insight into the question of why flight test and give a short history of flight test engineering. Sections 3 through 10 deal with the preparation for flight testing. They provide guidance on the preliminary factors that must be considered; the composition of the test team; the logistic support requirements; the instrumentation and data processing requirements; the flight test plan; the associated preliminary ground tests; and last, but by no means least, discuss safety aspects. Sections 11 through 27 describe the various types of flight tests that are usually conducted during the development and certification of a new or modified aircraft type. Each Section offers a brief introduction to the topic under consideration, and the nature and the objectives of the tests to be conducted. It lists the test instrumentation (and, where appropriate, other test equipment and facilities) required, describes the test maneuvers to be executed, and indicates the way in which the test data is selected, analyzed, and presented. The various activities that should take place between test flights are presented next. Items that are covered are: who to debrief; what type of reports to send where: types of data analysis required for next flight; review of test data to make a comparison to predicted data and some courses of action if there is not good agreement; and comments on selecting the next test flight. The activities that must take place upon completion of the test program are presented. The types of reports and briefings that should take place and a discussion of some of the uses of the flight test data are covered. A brief forecast is presented of where present trends may be leading.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","cui":{"isCui":false,"submissionId":20050209967,"id":"9a535d4fc55644e8bd4f2afa18e5f784"},"publications":[{"volume":"14","submissionId":20050209967,"isbn":"9283711262","publisher":"North Atlantic Treaty Organization","id":"0ef7f9b2f2c040cd83a3bf61285ef843","publicationName":"","publicationDate":"2005-07-01T04:00:00.0000000+00:00"}],"status":"CURATED","redistributedDate":"2026-06-22T17:07:31.2092090","related":[{"disseminated":"METADATA_ONLY","id":20050209986,"type":"ANALYTIC_SUBSIDIARY","title":"Chapter 3 - Background Considerations","stiType":"OTHER","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"METADATA_ONLY","id":20050209991,"type":"ANALYTIC_SUBSIDIARY","title":"Chapter 7 - Data Processing","stiType":"OTHER","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"METADATA_ONLY","id":20050209970,"type":"ANALYTIC_SUBSIDIARY","title":"Chapter 28 - Post Flight Operations","stiType":"OTHER","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"METADATA_ONLY","id":20050209992,"type":"ANALYTIC_SUBSIDIARY","title":"Chapter 9 - Pre-Flight Tests","stiType":"OTHER","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"METADATA_ONLY","id":20050209969,"type":"ANALYTIC_SUBSIDIARY","title":"Chapter 25 - Armament Testing and Stores Separation","stiType":"OTHER","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"METADATA_ONLY","id":20050209990,"type":"ANALYTIC_SUBSIDIARY","title":"Chapter 11 - Airdata Measurement and Calibration","stiType":"OTHER","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"METADATA_ONLY","id":20050209993,"type":"ANALYTIC_SUBSIDIARY","title":"Chapter 8 - Preparation of the Flight Test Plan","stiType":"OTHER","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"METADATA_ONLY","id":20050209972,"type":"ANALYTIC_SUBSID