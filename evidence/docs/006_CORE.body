                        "   }<br/>" +
                        "<br/>" +
                        "   data = {<br/>" +
                        "       \"q\": query,<br/>" +
                        "       \"aggregations\": [\"documentType\"]<br/>" +
                        "   }<br/>" +
                        "<br/>" +
                        "   try:<br/>" +
                        "       response = requests.post(URL, json=data, headers=headers)<br/>" +
                        "<br/>" +
