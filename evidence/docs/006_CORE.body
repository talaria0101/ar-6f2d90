                        "<br/>" +
                        "Example - https://api.core.ac.uk/v3/search/data-providers/?q=name:Glasgow</td>" +
                        "  <td class='bold'>single</td>" +
                        "</tr>" +

                        "<tr>" +
                        "  <td class='bold'>'oaiPmhUrl'</td>" +
