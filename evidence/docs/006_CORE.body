            const introDataProviders = {
                options: {
                    summary: "Introduction",
                    description: "Data-providers  entity gives access to the collection of sources that supply content to CORE. " +
                        "These include – Institutional repositories, disciplinary repositories, preprint servers,  journals and publishers. " +
                        "Each data provider record includes details about the source, such as its name, OAI-PMH endpoint, metadata format, software used, " +
                        "institutional identifiers, and geographic location." +
