                        "<code class='codePython'>" +
                        "q=title:\\\"<b>AI</b>\\\" OR fullText:\\\"<b>Deep Learning</b>\\\"" +
                        "</code>" +
                        "</pre>" +
                        "<br/>" +
                        "5. <b>Exists queries:</b> Find works with full-text available" +
                        "<pre class='preCode'>" +
                        "<code class='codePython'>" +
                        "q=_exists_:fullText" +
                        "</code>" +
                        "</pre>" +
                        "<br/>" +
                        "6. <b>Grouping:</b> Search works using multiple conditions" +
                        "<pre class='preCode'>" +
                        "<code class='codePython'>" +
                        "q=(title:\"<b>Artificial Intelligence</b>\" OR title:\"<b>Machine Learning</b>\") AND yearPublished>\"<b>2020</b>\"" +
                        "</code>" +
                        "</pre>"
                    ,
                    operationId: "optionsCustomQueryLanguage",
                    tags: ["Search"],
                },
            };

            spec.paths["/v3/search/search-aggregation"] = {
                options: {
                    summary: "Search using aggregation",
                    description: "The CORE API provides an aggregation feature to summarise and group search results " +
                        "based on specific fields. Aggregation queries differ from normal search queries as they provide " +
                        "summarised counts instead of detailed individual document records. To get the details of records, " +
                        "please check the CORE API Query Language page." +
                        "<h4>Aggregation Endpoint Structure</h4>" +
                        "<pre class='preCode'>" +
                        "<code class='codePython'>" +
                        "POST https://api.core.ac.uk/v3/search/{entityType}/aggregate" +
                        "</code>" +
                        "</pre>" +
                        "Replace <b>{entityType}</b> with one of the supported entities." +
                        "<h4>Request Body Format</h4>" +
                        "<pre class='preCode'>" +
                        "<code class='codePython'>" +
                        "{<br/>" +
                        "   \"q\": \"< search_query>\", <br/>" +
                        "   \"aggregations\": [\"< field_1>\", \"< field_2>\", \"...\"]<br/>" +
                        "}" +
                        "</code>" +
                        "</pre>" +
                        "<table>" +
                        "<tr>" +
                        "<td><span class='bold'>Field</span></td>" +
                        "<td><span class='bold'>Type</span></td>" +
                        "<td><span class='bold'>Description</span></td>" +
                        "</tr>" +
                        "<tr>" +
                        "<td>q</td>" +
                        "<td>string</td>" +
                        "<td>The query string is written using CORE’s query language.</td>" +
                        "</tr>" +
                        "<tr>" +
                        "<td>aggregations</td>" +
                        "<td>List</td>" +
                        "<td>A list of fields to aggregate results by. Only supported fields are allowed.</td>" +
                        "</tr>" +
                        "</table>" +
                        "<b>Note:</b> The aggregation feature does not support all fields returned by the API entity responses. " +
                        "Only certain fields can be used effectively." +
                        "<br/><br/>For instance, you can aggregate works using the following fields: " +
                        "<pre class='preCode'>" +
                        "<code class='codePython'>" +
                        "\"yearPublished\"<br/>" +
                        "\"authors\"<br/>" +
                        "\"dataProvider\"<br/>" +
                        "\"documentType\"<br/>" +
                        "\"publishedDate\"<br/>" +
                        "\"updatedDate\"<br/>" +
                        "\"language\"<br/>" +
                        "\"publisher\"<br/>" +
                        "\"fieldOfStudy\"<br/>" +
                        "</code>" +
                        "</pre><br/>" +
                        "Outputs can be aggregated using the following fields:" +
                        "<pre class='preCode'>" +
                        "<code class='codePython'>" +
                        "\"acceptedDate\"<br/>" +
                        "\"authors\"<br/>" +
                        "\"contributors\"<br/>" +
                        "\"depositedDate\"<br/>" +
                        "\"documentType\"<br/>" +
                        "\"language\"<br/>" +
                        "\"publishedDate\"<br/>" +
                        "\"subjects\"<br/>" +
                        "</code>" +
                        "</pre><br/>" +
                        "Data-providers entity supports following aggregations:" +
                        "<pre class='preCode'>" +
                        "<code class='codePython'>" +
                        "\"software\"" +
                        "</code>" +
                        "</pre><br/>" +
                        "Following fields from Journals entity supports aggregation:" +
                        "<pre class='preCode'>" +
                        "<code class='codePython'>" +
                        "\"subjects\"" +
                        "</code>" +
                        "</pre>" +
                        "Refer to the entity-specific documentation for more information."
                    ,
                    operationId: "optionsCustomSearchAggregation",
                    tags: ["Search"],
                },
            };

            spec.paths["/custom/rate_limit/common"] = {
                options: {
                    summary: "Common",
                    description: "Access to the CORE API is free and requires no authentication. Providing free access to general users is part of our mission. " +
                        "Being a sustainable scholarly infrastructure is also part of our mission. As a result, we offer better performance to registered users. " +
                        "The below table provides information about our rate limits depending on your situation.<br><br>" +
                        "To control the load on our systems we use a rate-limiting technology based on tokens. Each user has access to a certain number of tokens " +
                        "at the start of their session and they can use them to perform their queries.<br><br>" +
                        "Certain calls in CORE are more computationally expensive than others, therefore some calls such as recommender, " +
                        "scroll search and bulk queries will cost you more tokens than others. As a rule of thumb, a simple query will cost you 1 token " +
                        "while more complex queries will cost you between 3 to 5 tokens. <br><br>" +
                        "We are monitoring the load on our servers and at some point we might decide to increase or decrease the “cost” of certain " +
                        "operations to control the overall load. The best way to keep on top of your API usage is to use the HTTP headers included " +
                        "in every API call response (see below for details about the headers).<br><br>" +
                        "<div><table><tbody><tr><td>User type</td><td>How to obtain</td><td>Rate limit</td><td>Support</td></tr>" +
                        "<tr>" +
                            "<td>Unauthenticated users<span class='dot'>&#42;</span></td>" +
                            "<td>No registration required, just start using the API.</td>" +
                            "<td>100 tokens per day, maximum 10 per minute.</td>" +
                            "<td>No support</td>" +
                        "</tr>" +
                        "<tr>" +
                            "<td>Registered Personal users</td>" +
                            "<td>Registration through the <a href='https://core.ac.uk/services/api'> CORE API </a> form</td>" +
                            "<td>1,000 tokens per day, maximum 25 per minute.</td>" +
                            "<td>Best effort</td>" +
                        "</tr>" +
                        "<tr>" +
                            "<td>Registered academic users NOT affiliated with Supporting or Sustaining institutions.</td>" +
                            "<td>Registration through the <a href='https://core.ac.uk/services/api'> CORE API </a> form</td>" +
                            "<td>5,000 tokens per day, maximum 10 per minute.</td> " +
                            "<td>Best effort</td>" +
                        "</tr>" +
                        "<tr>" +
                            "<td>Registered academic users affiliated with Supporting or Sustaining institutions and Non-academic organisation users</td>" +
                            "<td>Registration through the <a href='https://core.ac.uk/services/api'> CORE API </a> form</td>" +
                            "<td>The API limits are designed to allow reasonable usage and we will change them depending on the load on our servers. However, on average, we estimate this plan should be good for up to about 200k tokens per day. You are able to monitor your current API limit by looking for our customised HTTP headers: X-RateLimitRemaining X-RateLimit-Retry-After X-RateLimit-Limit</td>" +
                            "<td>Dedicated support</td>" +
                        "</tr>" +
                        "<tr><td>VIP</td><td>Contact us to discuss a dedicated plan to upgrade your registration.&nbsp;</td>" +
                        "<td>Sky is the limit. We can support your needs. Just let us know and we will find a way to accommodate your usage needs.&nbsp;</td>" +
                        "<td>Unlimited priority support</td></tr>" +
                        "</tbody></table>" +
                        "<span class='dot'>&#42;</span> - Full-text is not available for unauthenticated API users." +
                        "</div>",
                    operationId: "optionsCustomRateLimitCommon",
                    tags: ["Rate limits"]
                }
            };

            spec.paths["/custom/rate_limit/monitor"] = {
                options: {
                    summary: "How to monitor your API rate limits",
                    description: "To ensure fair usage and maintain API stability, CORE implements rate limits. " +
                        "These limits may be adjusted dynamically based on server load and usage patterns." +
                        "<p>You can monitor your current rate usage by checking the following custom HTTP response " +
                        "headers included in every API response:</p>" +
                        "<table><tr><td><b>Header</b></td><td><b>Description</b></td></tr>" +
                        "<tr>" +
                        "<td>`X-RateLimit-Limit`</td>" +
                        "<td>The total number of requests allowed within the current rate-limiting window. " +
                        "This represents your maximum quota before the limit resets.</td>" +
                        "</tr>" +
                        "<tr>" +
                        "<td>`X-RateLimit-Remaining`</td>" +
                        "<td>The number of requests you still have available in the current window. Once this value reaches zero, additional requests will be blocked until the window resets. </td>" +
                        "</tr>" +
                        "<tr>" +
                        "<td>`X-RateLimit-Retry-After`</td>" +
                        "<td>Indicates when you can safely make another request after hitting the rate limit.</td>" +
                        "</tr></table>",
                    operationId: "optionsCustomRateLimitMonitor",
                    tags: ["Rate limits"]
                }
            };

            spec.paths["/custom/entities/introduction"] = {
                options: {
                    summary: "Introduction",
                    description: "The CORE API provides convenient and comprehensive access to global research results. " +
                        "CORE is based on the global repositories network and collects, aggregates and expands " +
                        "the metadata provided and the associated full texts. The API allows access to the data summarised in the search index.",
                    operationId: "customEntitiesIntroduction",
                    tags: ["Entities"]
                }
            };

            spec.paths["/custom/entities/data_model"] = {
                options: {
                    summary: "CORE data model",
                    description: "The following diagram depicts the primary entities and their main attributes (the full list is in the documentation below)" +
                        "<img src='/images/docs/api_documentation_diagram.png' />" +
                        "<br/><br/><span class='bold'>Works</span>" +
                        "<br/>Works provide a representation of a research work in a way that is independent of its manifestations. " +
                        "Each research work can have one or more manifestations (Outputs) available from any data provider. " +
                        "Works refer to a deduplicated and harmonised meta-entity describing the research work and connecting its Outputs." +
                        "<br/><br/><span class='bold'>Outputs</span>" +
                        "<br/>Outputs refer to specific manifestations of a research work (Works)." +
                        "<br/><br/><span class='bold'>Data Providers</span>" +
                        "<br/>The Data Provider entity represents the data sources from which Outputs are collected. These sources include but are not limited to institutional, subject, preprint, repositories and journals or their collections.",
                    operationId: "customEntitiesDataModel",
                    tags: ["Entities"]
                }
            };

            // spec.paths["/custom/querying_large_datasets"] = {
            //     options: {
            //         summary: "Querying large datasets",
            //         description: "The API is great to use for small queries and fast access to the CORE data. " +
            //             "For bigger queries we recommend you using the <a href='https://core.ac.uk/documentation/dataset'>CORE dataset</a>." +
            //             "The maximum size for a result set using the API is 10,000 results, to get bigger datasets the search endpoints offer the possibility of scroll queries." +
            //             "By appending a parameter called <code>scroll</code> the system will provide you an id that you can use to perform bigger queries." +
            //             "Our example will show you how to use it. Please keep in mind that performing these queries has " +
            //             "a bigger performance impact and we are limiting them more strictly than the normal queries.",
            //         operationId: "customQueryingLargeDatasets",
            //         tags: []
            //     }
            // };

            spec.paths["/custom/how_call_API"] = {
                options: {
                    summary: "How to call the API",
                    description: "There are a few ways you can perform API requests using your API Key. <a href='https://core.ac.uk/services/api#form' target='_blank'>Request an API key here</a>. Please do not disclose your API key. It is for your use only. " +
                        "<ul><li> <i>preferred</i> You can embed the API Key in the header. This keeps the authorisation separated from the requests parameters. Add the header <code>Authorization: Bearer [API_KEY]</code></li> " +
                        "<li> If you cannot set your headers you can also use the API key as a parameter in your requests including it like this: <code>api_key=[API_KEY]</code> . " +
                        "</li></ul>",
                    operationId: "customHowCallAPI",
                    tags: []
                }
            };

            spec.paths["/custom/PDF_download_policy"] = {
                options: {
                    summary: "PDF download policy",
                    description: "<ul>" +
                        "<li>Outputs PDF downloads are possible via the original <b>‘downloadUrl’</b> supplied link, if a " +
                        "URL exists. This is the preferred method.</li>" +
                        "<li>Where users are prevented, restricted or blocked from reaching the resource specified " +
                        "in the <b>‘downloadUrl’</b>, then CORE API users can also use the GET request endpoint - <br/>" +
                        "<pre class='preCode'><code class='codePython'>" +
                        "GET <a href='https://api.core.ac.uk/v3/outputs/{identifier}/download'>https://api.core.ac.uk/v3/outputs/{identifier}/download</a></code></pre> for downloading " +
                        "PDFs directly from CORE. This request counts against your API tokens allowance and is " +
                        "generally more expensive, because it has more significant data implications.</li>" +
                        "<li><b>IMPORTANT</b>: Systematic harvesting of PDFs from CORE outside that circumvents the API, e.g. " +
                        "via <code>https://fileserver-az.core.ac.uk/download/{identifier}.pdf</code> or other methods is unacceptable. " +
                        "Such usage will be blocked and associated API keys will be disabled.</li>" +
                        "</ul>",
                    operationId: "PDFDownloadPolicy",
                    tags: []
                }
            };

            const newPaths = {};
            for (const path in spec.paths) {
                if (path === "/v3/works/{identifier}") {
                    newPaths["/v3/works/intro"] = introWorks;
                }

                if (path === "/v3/works/{identifier}") {
                    newPaths["/v3/works/search"] = searchWorksPath;
                }

                if (path === "/v3/works/{identifier}") {
                    newPaths["/v3/works/aggregation"] = searchWorksPathAggregation;
                }

                if (path === "/v3/outputs/{identifier}") {
                    newPaths["/v3/outputs/intro"] = introOutputs;
                }

                if (path === "/v3/outputs/{identifier}") {
                    newPaths["/v3/outputs/search"] = searchOutputsPath;
                }

                if (path === "/v3/outputs/{identifier}") {
                    newPaths["/v3/outputs/aggregation"] = searchOutputsPathAggregation;
                }

                if (path === "/v3/data-providers/{identifier}") {
                    newPaths["/v3/data-providers/intro"] = introDataProviders;
                }

                if (path === "/v3/data-providers/{identifier}") {
                    newPaths["/v3/data-providers/search"] = searchDataProvidersPath;
                }

                if (path === "/v3/data-providers/{identifier}") {
                    newPaths["/v3/data-providers/aggregation"] = searchDataProvidersPathAggregation;
                }

                if (path === "/v3/journals/{identifier}") {
                    newPaths["/v3/journals/intro"] = introJournals;
                }

                if (path === "/v3/journals/{identifier}") {
                    newPaths["/v3/journals/search"] = searchJournalsPath;
                }

                if (path === "/v3/journals/{identifier}") {
                    newPaths["/v3/journals/aggregation"] = searchJournalsPathAggregation;
                }

                if (path === "/v3/search/{entityType}") {
                    newPaths["/v3/search/query-language"] = searchQueryLanguagePath;
                }
                if (path === "/v3/search/{entityType}") {
                    newPaths["/v3/search/keyword-queries"] = searchOptionsKeywordQueries;
                }
                if (path === "/v3/search/{entityType}") {
                    newPaths["/v3/search/without-field"] = searchOptionsWithoutField;
                }

                newPaths[path] = spec.paths[path];
            }
            spec.paths = newPaths;

            console.log(spec); //dev

            const orderedPaths = [
                '/custom/entities/introduction',
                '/custom/entities/data_model',

                '/v3/search/works',
                '/v3/search/outputs',
                '/v3/search/data-providers',
                '/v3/search/journals',
                '/v3/search/query-language',
                '/v3/search/keyword-queries',
                '/v3/search/without-field',
                '/v3/search/search-aggregation',

                '/v3/search/{entityType}',
                '/v3/search/{entityType}/',
                '/v3/search/{entityType}/aggregate',

                '/v3/works/intro',
                '/v3/works/search',
                '/v3/works/aggregation',
                '/v3/works/{identifier}',
                '/v3/works/{identifier}/outputs',
                '/v3/works/{identifier}/stats',
                '/v3/works/tei/{identifier}',
                '/v3/works/{identifier}/download',

                '/v3/outputs/intro',
                '/v3/outputs/search',
                '/v3/outputs/aggregation',
                '/v3/outputs/{identifier}',
                '/v3/outputs/{identifier}/download',
                '/v3/outputs/{identifier}/history',
                '/v3/outputs/{identifier}/raw',
                '/v3/outputs/{identifier}/stats',

                '/v3/data-providers/intro',
                '/v3/data-providers/search',
                '/v3/data-providers/aggregation',
                '/v3/data-providers/{identifier}',
                '/v3/data-providers/{identifier}/outputs',
                '/v3/data-providers/{identifier}/stats',

                '/v3/journals/intro',
                '/v3/journals/search',
                '/v3/journals/aggregation',
                '/v3/journals/{identifier}',
                '/v3/journals/{identifier}/stats',

                '/v3/labs/expert-finder',
                '/v3/discover',
                '/v3/recommend',
                '/custom/rate_limit/common',
                '/custom/rate_limit/monitor',

                '/custom/how_call_API',
                '/custom/PDF_download_policy'
            ];

            // then rebuild `spec.paths` in that exact sequence
            const newPathsV2 = {};
            orderedPaths.forEach(p => {
                if (spec.paths[p]) newPathsV2[p] = spec.paths[p];
            });
            // finally copy any remaining (if needed)
            Object.keys(spec.paths).forEach(p => {
                if (!newPathsV2[p]) newPathsV2[p] = spec.paths[p];
            });
            spec.paths = newPathsV2;

            Redoc.init(spec, options, mountElement);
        });
</script>

