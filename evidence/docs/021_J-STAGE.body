<!--

main .list-layout{
	/** Basic Box Model **/
	display: flex!important;
	/** Flexible Box Layout **/
	flex-flow: row nowrap;
	justify-content: flex-start;
	align-items: stretch;
}
main .list-layout>.marker{
	/** Text **/
	white-space: nowrap;
}
article h1,
article dt,
article figcaption{
	/** Fonts **/
	font-family: robotomedium;
}
article p,
article dt,
article dd,
article li,
article figcaption{
	/** Fonts **/
	font-size: 14px;
	/** Line **/
	line-height: 20px;
	/** Text **/
	overflow-wrap: break-word;
}
article,
article h1,
article h2,
article h3{
	/** Fonts **/
	font-family: Meiryo!important;
}
article h1{
	/** Basic Box Model **/
	margin: 0 0 40px;
	/** Fonts **/
	font-size: 20px;
	font-weight: bold;
	/** Line **/
	line-height: 25px;
}
article h2{
	/** Basic Box Model **/
	margin: 0 0 20px;
	/** Fonts **/
	font-size: 16px;
	font-weight: bold;
	/** Line **/
	line-height: 23px;
}
article h3{
	/** Basic Box Model **/
	margin: 0 0 20px;
	/** Fonts **/
	font-size: 14px;
	font-weight: bold;
	/** Line **/
	line-height: 20px;
}
article dt,
article caption,
article figcaption{
	/** Basic Box Model **/
	margin: 20px 0 10px;
}
article p,
article ul,
article dl,
article dd,
article figure{
	/** Basic Box Model **/
	padding: 0 0 0 15px;
}
article dd>*,
article li>*{
	/** Basic Box Model **/
	margin: 0;
	padding: 0;
}
article ul.hyphen>li{
	/** Positioned Layout **/
	position: relative;
	/** Basic Box Model **/
	margin: 0 0 0 11px;
}
article ul.hyphen>li::before{
	/** Positioned Layout **/
	position: absolute;
	top: 0;
	left: -11px;
	/** Basic Box Model **/
	display: block;
	/** Generated and Rplaced Content **/
	content: '-';
}
article .url{
	/** Text **/
	word-break: break-all;
}
article .table-container{
	/** Basic Box Model **/
	width: 100%;
	overflow: auto;
}
article table{
	/** Basic Box Model **/
	width: 100%;
}
article caption{
	/** Text **/
	text-align: center;
}
article th{
	/** Backgrounds and Borders **/
	background: #edeeef;
	border-bottom: 2px solid #e3e3e3;
	/** Basic Box Model **/
	padding: 12px .25em 8px;
	/** Fonts **/
	font-weight: bold;
	/** Text **/
	text-align: center;
	/** Line **/
	vertical-align: middle;
}
article td{
	/** Backgrounds and Borders **/
	background: #ffffff;
	border-bottom: 1px solid #e7e7e7;
	/** Basic Box Model **/
	padding: 0 .25em;
	/** Line **/
	vertical-align: middle;
}
article .col1,
article .col3,
article .col4{
	/** Text **/
	white-space: nowrap;
}
article .col1{
	/** Basic Box Model **/
	min-width: 2.5em;
}
article .col2{
	/** Basic Box Model **/
	min-width: 5.5em;
}
article .col3{
	/** Basic Box Model **/
	min-width: 5.5em;
}
article .col4{
	/** Basic Box Model **/
	min-width: 2.5em;
}
article .col5{
	/** Basic Box Model **/
	min-width: 8.5em;
}
article .col6{
	/** Basic Box Model **/
	min-width: 8.5em;
}
article td.col1{
	/** Text **/
	text-align: right;
}

b {
	font-weight: bold;
}
i {
	font-style: italic;
}
// -->
