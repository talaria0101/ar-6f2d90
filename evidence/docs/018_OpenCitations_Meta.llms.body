/* Evita lo spazio per il finto titolo */
.entry-header {
  margin-top: 3rem!important;
}

/*Arrotondamento immmagini su OUR TEAM */
.wp-block-getwid-person.is-image-cropped .wp-block-getwid-person__image img {
    border-radius: 100%;
    object-fit: cover;
}

/* CSS per la gestione del font piu' grande */
.font-size-1 {
    font-size: 1.1em !important;
}
.font-size-2 {
    font-size: 1.25em !important;
}
.font-size-3 {
    font-size: 1.5em !important;
}
.font-size-4 {
    font-size: 1.75em !important;
}
.font-size-5 {
    font-size: 2em !important;
}
.font-size-rem-1 {
    font-size: 0.93rem !important;
}
.font-size-rem-2 {
    font-size: 1.25rem !important;
}
.font-size-rem-3 {
    font-size: 1.5rem !important;
}
.font-size-rem-4 {
    font-size: 1.75rem !important;
}
.font-size-rem-5 {
    font-size: 2rem !important;
}


/* RIMOZIONE PALLINI CON ICONCINE */
.fas-star-list,
.far-star-list {
    list-style-type: none;
    padding-left: 0;
}

.fas-star-list li,
.far-star-list li {
    display: flex;
    align-items: flex-start;
}

.fas-star-list li i,
.far-star-list li i {
    margin-right: 10px;
    margin-top: 5px;
}

.compact-list li {
    margin-bottom: 5px !important;
}
.compact-list li:last-child {
    margin-bottom: 0 !important;
}

.fa-user-list {
    list-style-type: none;
    padding-left: 0;
}

.fa-user-list li {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
}

.fa-user-list li i {
    margin-right: 10px;
    color: #007bff;
}




/* QUI PARTE LA SEZIONE CUSTOM CSS CON I MARGINI STILE BOOTSTRSAP */

/* Margini generali */
.margin-0 { margin: 0 !important; }
.margin-extra-small { margin: 0.25rem !important; }
.margin-small { margin: 0.5rem !important; }
.margin-medium { margin: 1rem !important; }
.margin-large { margin: 1.5rem !important; }
.margin-extra-large { margin: 3rem !important; }

/* Margin top */
.margin-top-0 { margin-top: 0 !important; }
.margin-top-extra-small { margin-top: 0.25rem !important; }
.margin-top-small { margin-top: 0.5rem !important; }
.margin-top-medium { margin-top: 1rem !important; }
.margin-top-large { margin-top: 1.5rem !important; }
.margin-top-extra-large { margin-top: 3rem !important; }

/* Margin bottom */
.margin-bottom-0 { margin-bottom: 0 !important; }
.margin-bottom-extra-small { margin-bottom: 0.25rem !important; }
.margin-bottom-small { margin-bottom: 0.5rem !important; }
.margin-bottom-medium { margin-bottom: 1rem !important; }
.margin-bottom-large { margin-bottom: 1.5rem !important; }
.margin-bottom-extra-large { margin-bottom: 3rem !important; }

/* Margin left */
.margin-left-0 { margin-left: 0 !important; }
.margin-left-extra-small { margin-left: 0.25rem !important; }
.margin-left-small { margin-left: 0.5rem !important; }
.margin-left-medium { margin-left: 1rem !important; }
.margin-left-large { margin-left: 1.5rem !important; }
.margin-left-extra-large { margin-left: 3rem !important; }

/* Margin right */
.margin-right-0 { margin-right: 0 !important; }
.margin-right-extra-small { margin-right: 0.25rem !important; }
.margin-right-small { margin-right: 0.5rem !important; }
.margin-right-medium { margin-right: 1rem !important; }
.margin-right-large { margin-right: 1.5rem !important; }
.margin-right-extra-large { margin-right: 3rem !important; }

/* Margin x-axis (left and right) */
.margin-x-0 { margin-left: 0 !important; margin-right: 0 !important; }
.margin-x-extra-small { margin-left: 0.25rem !important; margin-right: 0.25rem !important; }
.margin-x-small { margin-left: 0.5rem !important; margin-right: 0.5rem !important; }
.margin-x-medium { margin-left: 1rem !important; margin-right: 1rem !important; }
.margin-x-large { margin-left: 1.5rem !important; margin-right: 1.5rem !important; }
.margin-x-extra-large { margin-left: 3rem !important; margin-right: 3rem !important; }

/* Margin y-axis (top and bottom) */
.margin-y-0 { margin-top: 0 !important; margin-bottom: 0 !important; }
.margin-y-extra-small { margin-top: 0.25rem !important; margin-bottom: 0.25rem !important; }
.margin-y-small { margin-top: 0.5rem !important; margin-bottom: 0.5rem !important; }
.margin-y-medium { margin-top: 1rem !important; margin-bottom: 1rem !important; }
.margin-y-large { margin-top: 1.5rem !important; margin-bottom: 1.5rem !important; }
.margin-y-extra-large { margin-top: 3rem !important; margin-bottom: 3rem !important; }

/* Margin auto */
.margin-auto { margin: auto !important; }
.margin-top-auto { margin-top: auto !important; }
.margin-right-auto { margin-right: auto !important; }
.margin-bottom-auto { margin-bottom: auto !important; }
.margin-left-auto { margin-left: auto !important; }
.margin-x-auto { margin-left: auto !important; margin-right: auto !important; }
.margin-y-auto { margin-top: auto !important; margin-bottom: auto !important; }

/* Fix del primo elemento del menu che si vedeva con margin 0 */
#primary-menu li:first-child {
    margin-top: 0 !important;
    vertical-align: middle !important;
}

#primary-menu .menu-item {
    margin-top: 0 !important;
    vertical-align: middle !important;
}


/* Fix delle 3 card nella home page che il titolo risultava sfalsato poiche' i sottotitoli sono di lunghezze diverse */
.wp-block-getwid-banner__text {
    min-height: 120px;
    display: flex;
    align-items: center;
}


/* Fix list type in members and donors */
.memdonlist .wp-block-list {
	list-style-type: none!important;
}
.memdonlist {
	list-style-type: none!important;
}


/* Fix troppo spazio dopo linea intermezzo titolo principale */
.wp-block-separator {
	margin-bottom: 2em!important;
	margin-top: 0!important;
}

/* Fix home page per tablet (le 3 famose immagini) */
@media screen and (min-width: 782px) and (max-width: 1038px) {
	.wp-block-column {
		margin-right: unset!important;
	}
	.wp-block-getwid-banner__caption {
		padding: 0.5rem!important;
		font-size: 0.9rem!important;
	}
	.wp-block-getwid-banner .wp-block-getwid-banner__title {
		font-size: 1.2rem!important;
	}
	
	.wp-block-getwid-banner__text {
    min-height: 130px;
    display: flex;
    align-items: center;
}
	
}
</style>
