<link rel="icon" href="https://opencitations.net/wp-content/uploads/2025/05/favicon_oc-0-150x150.png" sizes="32x32" />
<link rel="icon" href="https://opencitations.net/wp-content/uploads/2025/05/favicon_oc-0.png" sizes="192x192" />
