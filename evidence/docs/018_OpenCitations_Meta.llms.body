<meta name="msapplication-TileImage" content="https://opencitations.net/wp-content/uploads/2025/05/favicon_oc-0.png" />
<style id="wp-custom-css">
/* Nasconde il titolo pagina */
h1 {
	display: none
}

/* Logo un pelino piu' piccolo */
.custom-logo {
	height: 80px;
	width: auto;
}

/* SocialLinks sotto immagine */
.colonnaPersoneSocial {
    position: relative!important;
}
.socialLinks {
    position: absolute!important;
    left: 50%!important;
    transform: translateX(-50%)!important;
    padding-top: 11.3em!important;
    margin: 0!important;
}
.wp-block-getwid-person__title {
    margin-top: 1.5em;
}




#mc_embed_signup_scroll {
	padding-top:1em!important;
}

#mc_embed_signup_scroll > h2 {
	font-size:2em!important;
}

/*cambio posizione social links su our team */
.spsocicon {
	  margin-top: -2em!important;
}

/*Cambio dimensione immagini our team */
div.wp-block-getwid-person.is-image-cropped {
  display: flex;
  flex-direction: column;
  align-items: center;
	margin-bottom: 2em;
}

div.wp-block-getwid-person.is-image-cropped div.wp-block-getwid-person__image {
  align-content: center;
  height: 15em !important;
  width: 15em !important;
  padding-top: 1em;
}

.wp-block-getwid-testimonial .wp-block-getwid-testimonial__image-wrapper {
  max-width: 222px!important;
  margin-top: -113px!important;
}

.dshotpic {
  display: flex;
  align-items: center;
  justify-content: center;
}

@media (min-width: 1000px) {
	.dshotpic > div:nth-child(1) > div:nth-child(1) {
		height:25em!important;
		width:25em!important;
		margin-top:2em!important;
}
}

.dshopotrait {
	height:20em!important;
	width: 20em!important;
}

.wp-block-getwid-testimonial {
  padding-top: 120px!important;
}

/* Fix margin per schermi grandi */
#masthead {
	margin-left: 0!important;
	margin-right: 0!important;
}

.site-header {
		min-width: 100%!important
}

/* Enlarge footer & customization */
.footer-sidebars-wrapper {
    padding: 0!important;
    max-width: 100%!important;
    margin: 0!important;
}
.footer-sidebars-wrapper .footer-sidebars {
    width: 100% !important;
		max-width: 100%!important;
}
div.footer-sidebars-wrapper div.footer-sidebars.has-layout-40-20-20-20 aside.widget-area {
    padding-left: 0!important;
    padding-right: 0!important;
}

@media (max-width: 770px) {
    .wp-block-columns.is-layout-flex.wp-container-core-columns-is-layout-2.wp-block-columns-is-layout-flex {
        flex-direction: column; 
    }

    .wp-block-columns.is-layout-flex.wp-container-core-columns-is-layout-2.wp-block-columns-is-layout-flex .wp-block-column {
        flex-basis: 100%; 
        text-align: center; 
    }

    .wp-block-getwid-social-links {
        justify-content: center; 
    }
	    .wp-block-column.is-vertically-aligned-center {
        flex-direction: column!important;
        flex-basis: 100%!important;
        text-align: center!important;
    }

    .wp-block-column.is-vertically-aligned-center p.has-text-align-left {
        text-align: center!important;
    }
    
    .wp-block-getwid-social-links .wp-block-getwid-social-links__list {
        justify-content: center!important;
    }
}
.wp-block-group__inner-container > hr:nth-child(2) {
  height: 1px !important;
  max-width: 100% !important;
  width: 100% !important;
}

#colophon {
	display:none;
}
.widget-area {
	margin-bottom: 0!important;
}


