<style id="getwid-base-style-inline-css">
    .site-content {
        background: linear-gradient(to bottom, #d3c0e2 0%, rgba(255, 255, 255, 0) 304px);
    }

    .search-modal:before {
        background: #d3c0e2;
        opacity: .98;
    }    .site-header{
        background: #ffffff;
    }
    
    .primary-menu-wrapper:after{
        background: #ffffff;
        opacity: .98;
    }    body,    
    input,
    select,
    optgroup,
    textarea,
    .entry-meta,
    .post-navigation-wrapper .previous .meta, 
    .post-navigation-wrapper .next .meta,
    .comments-area .comment-metadata,    
    .wp-block-pullquote cite, 
    .wp-block-quote cite, 
    .wp-block-quote.is-style-large cite,
    .wp-block-image figcaption
    {
        color: #353d42;
    }     .navigation.pagination .nav-links .page-numbers,
     .wp-block-quote .wp-block-quote__citation, 
     .wp-block-quote.is-style-large .wp-block-quote__citation,    
     .wp-block-pullquote .wp-block-pullquote__citation
    {
        color: #353d42;        
    }
    
    .editor-styles-wrapper
    {
        color: #353d42 !important;
    }                .entry-content .has-gray-color{
                color: #ffffff;
            }
            .entry-content .has-gray-background-color{
                background-color: #ffffff;
            }            .entry-content .has-dark-blue-color{
                color: #ffffff;
            }
            .entry-content .has-dark-blue-background-color{
                background-color: #ffffff;
            }
/*# sourceURL=getwid-base-style-inline-css */
</style>
