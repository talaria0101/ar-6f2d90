<div class="wp-block-group has-blush-light-purple-gradient-background has-background"><div class="wp-block-group__inner-container is-layout-constrained wp-block-group-is-layout-constrained">
<div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex">
<div class="wp-block-column has-small-font-size is-layout-flow wp-block-column-is-layout-flow">
<h6 class="wp-block-heading" style="font-size:17px">OPENCITATIONS</h6>



<p class="has-small-font-size wp-block-paragraph">OpenCitations is managed by the&nbsp;<a href="https://openscholarlymetadata.org/" target="_blank" rel="noreferrer noopener">Research Centre for Open Scholarly Metadata</a>, an independent research centre within the&nbsp;<a href="https://www.unibo.it/en" target="_blank" rel="noreferrer noopener">University of Bologna</a>.</p>



<figure class="wp-block-image size-large"><img loading="lazy" decoding="async" width="1024" height="256" src="https://opencitations.net/wp-content/uploads/2026/05/Scuola-media-1080-x-1350-px-1500-x-900-px-Nuovo-banner-per-LinkedIn-1-1024x256.png" alt="" class="wp-image-941" srcset="https://opencitations.net/wp-content/uploads/2026/05/Scuola-media-1080-x-1350-px-1500-x-900-px-Nuovo-banner-per-LinkedIn-1-1024x256.png 1024w, https://opencitations.net/wp-content/uploads/2026/05/Scuola-media-1080-x-1350-px-1500-x-900-px-Nuovo-banner-per-LinkedIn-1-300x75.png 300w, https://opencitations.net/wp-content/uploads/2026/05/Scuola-media-1080-x-1350-px-1500-x-900-px-Nuovo-banner-per-LinkedIn-1-768x192.png 768w, https://opencitations.net/wp-content/uploads/2026/05/Scuola-media-1080-x-1350-px-1500-x-900-px-Nuovo-banner-per-LinkedIn-1-1536x384.png 1536w, https://opencitations.net/wp-content/uploads/2026/05/Scuola-media-1080-x-1350-px-1500-x-900-px-Nuovo-banner-per-LinkedIn-1-938x235.png 938w, https://opencitations.net/wp-content/uploads/2026/05/Scuola-media-1080-x-1350-px-1500-x-900-px-Nuovo-banner-per-LinkedIn-1-1130x283.png 1130w, https://opencitations.net/wp-content/uploads/2026/05/Scuola-media-1080-x-1350-px-1500-x-900-px-Nuovo-banner-per-LinkedIn-1.png 1584w" sizes="auto, (max-width: 1024px) 100vw, 1024px" /></figure>


