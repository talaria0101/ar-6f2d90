<script>
function updateAllSearchPlaceholders() {
    console.log('Searching for all search fields...');
    
    // Selectors for desktop and mobile
    const selectors = [
        'input[type="search"]',
        '.search-field',
        'input[name="s"]',
        '.mobile-search-form-wrapper input[type="search"]',
        '.mobile-search-form-wrapper .search-field',
        '.mobile-search-form-wrapper input[name="s"]'
    ];
    
    let found = 0;
    
    selectors.forEach(function(selector) {
        const inputs = document.querySelectorAll(selector);
        inputs.forEach(function(input) {
            if (input && input.placeholder !== 'Search the website') {
                input.placeholder = 'Search the website';
                found++;
                console.log('Placeholder changed for:', selector);
            }
        });
    });
    
    console.log('Fields found and updated:', found);
}

// Execute immediately
updateAllSearchPlaceholders();

// Execute when DOM is ready
document.addEventListener('DOMContentLoaded', updateAllSearchPlaceholders);

// Execute when everything is loaded
window.addEventListener('load', updateAllSearchPlaceholders);

// Retry multiple times (for dynamically loaded content on mobile)
setTimeout(updateAllSearchPlaceholders, 1000);
setTimeout(updateAllSearchPlaceholders, 3000);
setTimeout(updateAllSearchPlaceholders, 5000);
</script>
