{"data":[{"id":"nmcfe","type":"nodes","attributes":{"title":"Cielo Austral – TESS transit candidate","description":"Open, falsification-first search for exoplanet transits around M dwarfs in public TESS data, by Cielo Austral (https://cieloaustral.space). This project holds the sealed analysis and preregistered predictions for a transit candidate found in TESS FFI light curves. Every test is calibrated on known planets and known false positives before use, and failed tests are documented. Author: Nicolás Sifakis (ORCID 0009-0006-5635-749X).","category":"project","custom_citation":null,"date_created":"2026-10-17T23:12:08.876099","date_modified":"2026-10-20T01:30:59.278299","registration":false,"preprint":false,"fork":false,"collection":false,"tags":[],"access_requests_enabled":true,"node_license":null,"analytics_key":"","current_user_can_comment":false,"current_user_permissions":["read"],"current_user_is_contributor":false,"current_user_is_contributor_or_group_member":false,"wiki_enabled":true,"public":true,"subjects":[]},"relationships":{"children":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/nmcfe/children/","meta":{}}}},"collected_in":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/nmcfe/collections/","meta":{}}}},"comments":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/nmcfe/comments/?filter%5Btarget%5D=nmcfe","meta":{}}}},"contributors":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/nmcfe/contributors/","meta":{}}}},"bibliographic_contributors":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/nmcfe/bibliographic_contributors/","meta":{}}}},"implicit_contributors":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/nmcfe/implicit_contributors/","meta":{}}}},"files":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/nmcfe/files/","meta":{}}}},"settings":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/nmcfe/settings/","meta":{}}},"data":{"id":"nmcfe","type":"node-setting"}},"wikis":{"links":{"rel