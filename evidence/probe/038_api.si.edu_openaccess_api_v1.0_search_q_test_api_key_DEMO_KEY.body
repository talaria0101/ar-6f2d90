      {
        "id": "ld1-1643398853934-1643398890468-1",
        "title": "Psychological Tests, Dearborn Group Tests of Intelligence",
        "unitCode": "NMAH",
        "type": "edanmdm",
        "url": "edanmdm:nmah_694267",
        "content": {
          "freetext": {
            "name": [
              {
                "label": "author",
                "content": "Dearborn, Walter F."
              },
              {
                "label": "publisher",
                "content": "Educational Test Bureau"
              }
            ],
            "notes": [
              {
                "label": "Description",
                "content": "This is a group of tests from the Dearborn Group Tests of Intelligence. Compare with 316371.07.02 and 316371.07.01. It is from Series I and is the General Examination 2. It was published by J.B. Lippincott. Five of the six tests in this collection are protected by a sheet of red cardboard in the back that is folded over to make up part of the left-hand margin. Each of the tests is two-hole punched."
              },
              {
                "label": "Description",
                "content": "The first test has circles and squares in red and blue ink. The test also includes pen and ink drawings, and pictures of dominos. The second test is comprised primarily of pen and ink drawings as well as a section dealing with shapes. The third test has a cover page entitled “Games and Puzzles.” This test is comprised of pen and ink drawings as well as games and puzzles. The fourth test includes mazes, word problems, pen and ink drawings, pictures of blocks, and number problems. The fifth test does not include the red cardboard sheet in the back, is entitled “Games and Picture Puzzles,” and includes twenty two different images. The sixth test is entitled “Games and Puzzles, Series II-C” and is the revised edition. The test is six pages long and folds out. It includes questions dealing with pen and ink images, shapes, and word problems. The seventh test, “Games and Puzzles, Series II-D,” is the revised edition and appears to use many of the same questions from the fourth test. Therefore, it is potentially useful to persons interested in studying changes and developments in mental testing."
              },
              {
                "label": "Location",
                "content": "Currently not on view"
              }
            ],
            "topic": [
              {
                "label": "Subject",
                "content": "Psychology"
              },
