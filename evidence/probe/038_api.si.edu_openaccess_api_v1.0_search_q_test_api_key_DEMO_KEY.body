      {
        "id": "ld1-1643399134763-1643399172149-0",
        "title": "Group of Psychological Tests, Aptitude Tests",
        "unitCode": "NMAH",
        "type": "edanmdm",
        "url": "edanmdm:nmah_904499",
        "content": {
          "freetext": {
            "date": [
              {
                "label": "date made",
                "content": "1948"
              }
            ],
            "notes": [
              {
                "label": "Description",
                "content": "This is a group of aptitude tests for supervisory personnel. It includes a sheet of instructions for completing aptitude tests, an aptitude test information form, and the six tests intended for testing sales personnel (the Bernreuter Personality Inventory, the Otis Employment Test (this acutually is stored with 2000.3029.02.3), the Social Intelligence Test, the Strong Vocational Interest Blank, the test How Perfect is Your Sales Sense?, and the Washburne S-A Inventory). In addition, there are the three tests listed with subindex numbers 2000.3029.03.01 through 2000.3029.03.03 that are described in separate records. The date is taken from a pencil mark on the first sheet."
              },
              {
                "label": "Location",
                "content": "Currently not on view"
              }
