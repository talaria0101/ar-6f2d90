              {
                "label": "Description",
                "content": "This folder contains multiple documents related to the Thurstone Vocational Guidance Test. The test was intended for High School Seniors and College Freshmen and was written by L.L. Thurstone, Carnegie Institute of Technology. The Carnegie Institute of Technology also copyrighted the test in 1919. It was published by the World Book Company in 1922."
              },
              {
                "label": "Description",
                "content": "1- Algebra Test"
              },
              {
                "label": "Description",
                "content": "2-Geometry Test"
              },
              {
                "label": "Description",
                "content": "3-Physics Test"
              },
              {
                "label": "Description",
                "content": "4-Technical Information Test"
              },
              {
                "label": "Description",
                "content": "5-Arithmetic Test"
              },
              {
                "label": "Description",
                "content": "6-Key for Arithmetic Test"
              },
              {
                "label": "Description",
                "content": "7-Key for Technical Information Test"
              },
              {
                "label": "Description",
                "content": "8-Key for Physics Test"
              },
              {
                "label": "Description",
                "content": "9-Key for Algebra Test"
              },
              {
                "label": "Description",
                "content": "10-The Manual of Directions"
              },
              {
                "label": "Description",
                "content": "The tests will be of interest to researchers studying the history of psychology as well as researchers interested in labor history and others interested in how students get “sorted” into specific jobs and professions."
              },
              {
                "label": "Location",
                "content": "Currently not on view"
              }
