at", "metadata": {"title": "EUDAT"}, "access": {"visibility": "public", "members_visibility": "public", "member_policy": "closed", "record_submission_policy": "open", "review_policy": "closed", "record_restricted_policy": "restricted"}, "deletion_status": {"is_deleted": false, "status": "P"}, "children": {"allow": false}}]}, "pids": {"doi": {"identifier": "10.23728/b2share.kzwbk-j2d64", "provider": "datacite", "client": "datacite"}}}, "versions": {"is_latest": true, "index": 1}, "is_published": true, "is_draft": false, "pids": {"doi": {"identifier": "10.23728/b2share.2dnym-0xa27", "provider": "datacite", "client": "datacite"}, "oai": {"identifier": "oai:b2share-:2dnym-0xa27", "provider": "oai"}, "epic": {"identifier": "http://hdl.handle.net/11304/2dnym-0xa27", "provider": "epic", "client": "epic"}}, "metadata": {"resource_types": [{"id": "dataset", "title": {"ar": "\u0645\u062c\u0645\u0648\u0639\u0629 \u0628\u064a\u0627\u0646\u0627\u062a", "cs": "Datov\u00e1 sada", "de": "Datensatz", "en": "Dataset", "es": "Conjunto de datos", "sv": "Dataset"}}], "creators": [{"person_or_org": {"type": "personal", "name": "Pinz\u00f3n Pineda, Daniel Mauricio", "given_name": "Daniel Mauricio", "family_name": "Pinz\u00f3n Pineda", "identifiers": [{"identifier": "0009-0007-5142-366X", "scheme": "orcid"}]}, "affiliations": [{"name": "Aptolog\u00eda"}]}], "title": "Rentabilidad del arriendo en Ciudad de M\u00e9xico por colonia: d\u00f3nde rinde m\u00e1s comprar para arrendar (octubre 2026)", "publisher": "Aptolog\u00eda", "publication_date": "2026-10-19", "subjects": [{"subject": "vivienda"}, {"subject": "datos abiertos"}, {"subject": "mercado inmobiliario"}, {"subject": "Aptolog\u00eda"}, {"subject": "Latinoam\u00e9rica"}, {"subject": "arriendo"}, {"subject": "rentabilidad"}, {"subject": "housing"}, {"subject": "rental market"}, {"subject": "asking prices"}], "languages": [{"id": "spa", "title": {"en": "Spanish"}}], "contact_emails": [{"contact_email": "mauro@aptologia.com"}], "identifiers": [{"identifier": "10.5281/zenodo.23481374", "scheme": "doi"}], "related_identifiers": [{"identifier": "10.5281/zenodo.23481374", "scheme": "doi", "relation_type": {"id": "isidenticalto", "title": {"ar": "\u0645\u0637\u0627\u0628\u0642 \u0644\u0640", "cs": "Je identick\u00fd s (\u010d\u00edm)", "de": "Ist identisch mit", "en": "Is identical to", "es": "Es id\u00e9ntico a", "sv": "\u00c4r identisk med"}}, "resource_type": {"id": "dataset", "title": {"ar": "\u0645\u062c\u0645\u0648\u0639\u0629 \u0628\u064a\u0627\u0646\u0627\u062a", "cs": "Datov\u00e1 sada", "de": "Datensatz", "en": "Dataset", "es": "Conjunto de datos", "sv": "Dataset"}}}, {"identifier": "https://github.com/elbroker/aptologia-datos/tree/main/estudios/rentabilidad-renta-ciudad-de-mexico-por-colonia-2026", "scheme": "url", "relation_type": {"id": "issupplementto", "title": {"ar": "\u0645\u0644\u062d\u0642 \u0644\u0640", "cs": "Je dopl\u0148kem k (\u010demu)", "de": "Erg\u00e4nzt", "en": "Is supplement to", "es": "Es un suplemento de", "sv": "\u00c4r supplement till"}}}], "rights": [{"id": "cc-by-4.0", "title": {"en": "Creative Commons Attribution 4.0 International"}, "description": {"en": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited."}, "icon": "cc-by-icon", "props": {"url": "https://creativecommons.org/licenses/by/4.0/", "scheme": "spdx"}}], "description": "<p><strong>En Ciudad de M\u00e9xico, comprar un apartamento para arrendarlo rinde en la colonia t\u00edpica 6,1 % bruto al a\u00f1o: el precio pedido equivale a 16,3 a\u00f1os de arriendo. La colonia con mayor rentabilidad bruta es San Pedro de los Pinos (8,5 %) y la de menor, Ampliaci\u00f3n Estado de Hidalgo (5,3 %). Para toda la ciudad, con las medianas por m\u00b2, la rentabilidad bruta impl\u00edcita es 7,7 %.</strong></p>\n<p>Resumen: comparamos el precio por m\u00b2 de 2.998 apartamentos en venta con el canon por m\u00b2 de 603 en arriendo en 9 colonias de Ciudad de M\u00e9xico.</p>\n<p><strong>Metodolog\u00eda</strong></p><ul>\n<li><strong>Fuente:</strong> exportes nocturnos de la base de datos de Aptolog\u00eda (aptologia.com) del 18 de octubre de 2026: avisos vigentes de vivienda en portales inmobiliarios de 13 pa\u00edses, recogidos por Aptolog\u00eda y vistos en l\u00ednea entre el 11 y el 18 de octubre de 2026. Corte: 18 de octubre de 2026.</li>\n<li><strong>Depuraci\u00f3n:</strong> se eliminan duplicados exactos (misma ciudad, zona, tipo, precio, moneda, \u00e1rea, habitaciones y ba\u00f1os) y los precios fuera del percentil 1\u201399 de cada pa\u00eds, operaci\u00f3n, moneda y tipo; el precio por m\u00b2 usa solo avisos con \u00e1rea declarada entre 12 y 2.000 m\u00b2 y tambi\u00e9n se recorta al P1\u2013P99.</li>\n<li><strong>Qu\u00e9 se mide:</strong> precios pedidos (publicados), no precios de cierre. En arriendo, el canon mensual sin administraci\u00f3n, gastos comunes ni condominio.</li>\n</ul>\n<p>Estudio completo en Aptolog\u00eda: <a href=\"https://github.com/elbroker/aptologia-datos/tree/main/estudios/rentabilidad-renta-ciudad-de-mexico-por-colonia-2026\">https://github.com/elbroker/aptologia-datos/tree/main/estudios/rentabilidad-renta-ciudad-de-mexico-por-colonia-2026</a><br>DOI original (Zenodo): <a href=\"https://doi.org/10.5281/zenodo.23481374\">10.5281/zenodo.23481374</a><br>Datos y c\u00f3digo: <a href=\"https://github.com/elbroker/aptologia-datos/tree/main/estudios/rentabilidad-renta-ciudad-de-mexico-por-colonia-2026\">https://github.com/elbroker/aptologia-datos/tree/main/estudios/rentabilidad-renta-ciudad-de-mexico-por-colonia-2026</a></p>\n<p>Fuente: avisos p\u00fablicos de vivienda recopilados por Aptolog\u00eda (octubre de 2026). Son precios pedidos, no cerrados. Autor: Daniel Mauricio Pinz\u00f3n Pineda (ORCID 0009-0007-5142-366X), Aptolog\u00eda. Licencia CC BY 4.0.</p>"}, "custom_fields": {}, "access": {"record": "public", "files": "public", "embargo": {"active": false, "reason": null}, "status": "open"}, "files": {"enabled": true, "order": [], "count": 3, "total_bytes": 160178, "entries": {"rentabilidad-colonias.png": {"id": "0db067d1-bbd6-40fa-9367-b6d3a05881dd", "checksum": "md5:63d91fd91915b44bccffc0c109a68851", "ext": "png", "size": 38577, "mimetype": "image/png", "key": "rentabilidad-colonias.png", "metadata": {"width": 990, "height": 470}, "access": {"hidden": false}, "transfer": {}}, "rentabilidad_renta_ciudad_de_mexico_por_colonia_2026_datos.csv": {"id": "84b87def-c922-4acc-a99a-2a2da1b99b60", "checksum": "md5:2e762afe1141b85db88e29c89b4e580c", "ext": "csv", "size": 1326, "mimetype": "text/csv", "key": "rentabilidad_renta_ciudad_de_mexico_por_colonia_2026_datos.csv", "metadata": {}, "access": {"hidden": false}, "transfer": {}}, "rentabilidad-renta-ciudad-de-mexico-por-colonia-2026.pdf": {"id": "1a08868b-dcbc-4cd3-944f-c70bfd58b53a", "checksum": "md5:6a8b656bfdc12eaf5dc79f570f6bf310", "ext": "pdf", "size": 120275, "mimetype": "application/pdf", "key": "rentabilidad-renta-ciudad-de-mexico-por-colonia-2026.pdf", "metadata": {}, "access": {"hidden": false}, "transfer": {}}}}, "media_files": {"enabled": false, "order": [], "count": 0, "total_bytes": 0, "entries": {}}, "status": "published", "deletion_status": {"is_deleted": false, "status": "P"}, "stats": {"this_version": {"views": 0, "unique_views": 0, "downloads": 0, "unique_downloads": 0, "data_volume": 0.0}, "all_versions": {"views": 0, "unique_views": 0, "downloads": 0, "unique_downloads": 0, "data_volume": 0.0}}}], "total": 12356}, "aggregations": {"publication_date": {"buckets": [{"key": "1916", "doc_count": 1, "label": "1916", "is_selected": false}, {"key": "1917", "doc_count": 0, "label": "1917", "is_selected": false}, {"key": "1918", "doc_count": 0, "label": "1918", "is_selected": false}, {"key": "1919", "doc_count": 0, "label": "1919", "is_selected": false}, {"key": "1920", "doc_count": 0, "label": "1920", "is_selected": false}, {"key": "1921", "doc_count":