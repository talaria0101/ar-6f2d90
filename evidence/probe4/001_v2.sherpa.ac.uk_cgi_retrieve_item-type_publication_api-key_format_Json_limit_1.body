      <style>.html {
  height: 100%;
}

.body {
  height: 100%;
  margin: unset;
  background-color: black;
}

.data-container {
  background-color: transparent;
  padding: 1rem 16px 0;
}

.page-header {
  margin-top: unset;
  margin-bottom: unset;
  font-family: sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-size: 1.75rem;
  line-height: 2.25rem;
  font-weight: bold;
  padding-top: 1rem;
  padding-bottom: .75rem;
  color: #ffffff;
}

@media (min-width: 24em) {
  .page-header {
    font-size: 2rem;
    line-height: 2.5rem;
    padding-bottom: 10px;
  }
}
@media (min-width: 40em) {
  .page-header {
    font-size: 3rem;
    line-height: 3.5rem;
    padding-bottom: 10px;
  }
}

@media (min-width: 58em) {
