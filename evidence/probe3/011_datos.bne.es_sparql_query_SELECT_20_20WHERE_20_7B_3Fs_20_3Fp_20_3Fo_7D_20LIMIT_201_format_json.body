		<!-- ReadSpeaker Javascript -->
	<meta http-equiv="refresh" content="360"></head>

	<body>
		<div class="flex-wrapper">
			<!--CABECERA-->
			<nav class="navbar" id="cabecera_logo">
				<div class="container-fluid">
