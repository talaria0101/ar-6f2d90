body.public-facing .back-end-masthead {
  display: none; 
}

body.public-facing .bl_masthead_logo {
    position: fixed;
    height: -moz-fit-content;
    height: fit-content;
    right: var(--m-16);
    z-index: var(--z-index-home-button);
    top: 0;
    opacity: 1;
    transition: opacity .3s ease-in-out, transform .3s ease-in-out;
}

body.public-facing .bl_masthead_logo svg:focus {
  outline: none;
}

body.public-facing .HomeButton_homeButtonIcon__k3b0_ {
    width:77px;
    position: fixed;
    height: -moz-fit-content;
    height: fit-content;
    right: var(--m-16);
    z-index: var(--z-index-home-button);
    top: 0;
    opacity: 1;
    transition: opacity .3s ease-in-out, transform .3s ease-in-out;
}

@media screen and (max-width: 800px) {
  body.public-facing .HomeButton_homeButtonIcon__k3b0_ {
    width:64px
  }
}

body.public-facing{
  background-color: #f5f3ef;
  margin-bottom: 0px;
}

body.public-facing a, body.public-facing .dropdown-menu a,
body.public-facing a:hover, body.public-facing a:focus{
    color: var(--icon-color-secondary);
}

p.homepage_intro a{
    text-decoration: underline; 
}

body.public-facing {
  
  .hamburger {
    display: none;
  }

  @media screen and (min-width: 801px) {
    .menu {
      display: block !important;  
    }
  }

  @media screen and (max-width: 800px) {

    .header {
      flex-direction: column;
      padding: 20px;
    }

    .mobileHeader {
      width: 100%;
      display: flex;
      justify-content: space-between;
    }

    .hamburger {
      display: block;
      padding: 0.5em;
    }
  
    .hamburger div {
      width: 25px;
      height: 2px;
      background-color: #333;
      margin: 5px;
      border-radius: 25%;
    }

    .menu {
      display: none;
    }

    .list {
      grid-auto-flow: row;
      list-style-type: none;
      row-gap: 40px;
      column-gap: 0;
      justify-items: center;
    }
    
  }
}

body.public-facing, 
body.public-facing h1, 
body.public-facing h2, 
body.public-facing h3, 
body.public-facing h4, 
body.public-facing h5, 
body.public-facing h6{
  font-family: "Hind", sans-serif;
}

body.public-facing header nav#masthead {
  background-color: #f5f3ef !important;
  display: contents; 
}

body.public-facing .nav.navbar-nav > li.nav-item > a.nav-link {
    color: var(--icon-color-secondary);
    font-weight: var(--font-weight-medium);
    display: inline-block;
    padding-left: 2rem;
    padding-right: 2rem;
}

body.public-facing div.nav-divider {
    display: inline-block;
    height: 1.5rem;
    border-right-color: var(--divider-color);
    border-right-style: solid;
    vertical-align: text-top;
    border-right-width: var(--divider-width, 1px);
}

@media screen and (max-width: 800px) {
  body.public-facing div.nav-divider {
    display:none;
  }
  
  
}

body.public-facing .nav.navbar-nav > li.nav-item {


}

body.public-facing nav {
  background-color: #f5f3ef !important;
  border: none !important; 
  margin-right: var(--m-120);
  padding-top: 1.5rem !important;
}

body.public-facing .breadcrumb {
 padding: 0px; 
}

body.public-facing .container {
  margin-top: var(--m-32);
}

/* Homepage stuff */

article.homepage_content {
    margin-top: var(--m-64); 
}

@media screen and (max-width: 800px) {
  article.homepage_content {
    margin-top: var(--m-80);
  }
}

.homepage_content {
    font-size: var(--font-size-intro);
    display: block;
    width: -moz-fit-content;
    width: fit-content;
    margin: 0 auto;
    text-align: center;
}

.home-content {
    min-height: 600px;
}


p.homepage_intro {
  font-size: 2rem;
}

#content_block_page h1,
h1.homepage_title {
    --color: 240, 240, 240;
    font-size: var(--font-size-heading1);
    font-weight: var(--font-weight-light);
    font-style: normal;
    line-height: var(--heading1-line-height);
    letter-spacing: var(--heading1-letter-spacing);
}

a.mobile_jump_to_facet {
    display: none;
}

@media screen and (max-width: 800px) {

  p.homepage_intro {
    font-size: unset;
  }

  #content_block_page h1,
  h1.homepage_title {
    font-size: xx-large; 
  }
  
  a.mobile_jump_to_facet {
    display: block;
  }
}

.gap {
  &-0{
    gap: 0;
  }
  &-025 {
    gap: .25rem;
  }
  &-05 {
    gap: .5rem;
  }
  &-075 {
    gap: .75rem;
  }
  &-1 {
    gap: 1rem;
  }
  &-15{
    gap: 1.5rem;
  }
}

.welcome-announcements-container {
    gap: 2rem;
    text-align: left;
    margin-top: 5rem;
    margin-bottom: 3rem;

    @include mixing.respond-to('small', 'xsmall') {
      flex-direction: column;
    }

    .announcements {
      background-color: #e8e6dc;
      padding: 1.5rem;
      border-radius: .5rem;
      border: .0625rem solid #28261b;
      gap:1rem;


      @include mixing.respond-to('small', 'xsmall') {
        padding: 1rem;
        gap: 1rem;
        max-width: none;
      }

      .announcements-item-title {
        color: #2E2E27;
      }
    
      .homepage_intro {
        font-size: 1.1rem; 
      }
    
      ul, li {
        font-size: 1.1rem;
        list-style: unset;
      }
    }
	
  }


/* Static pages */

div#content_block_page {
  
  font-size: var(--font-size-intro);
  display: block;
  width: -moz-fit-content;
  width: fit-content;
  margin: 0 auto;
  text-align: center;
  
  h1{
    --color: 240, 240, 240;
    font-size: var(--font-size-heading1);
    font-weight: var(--font-weight-light);
    font-style: normal;
    line-height: var(--heading1-line-height);
    letter-spacing: var(--heading1-letter-spacing);
  }

}

/* Search bar stuff */

body.public-facing .search-form {
    width: 100%;
}

flex-1 {
    flex: 1;
}

.flex-row {
    display: flex;
    flex-direction: row;
}

.search_box_container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
}

.search-bar-container .search-bar-wrapper-no-mobile-width {
    width: auto;
}

.search-bar-container .search-bar-wrapper {
    height: 64px;
    margin-inline-end: 5px;
    padding-inline-start: 1.4rem;
    padding-inline-end: .5rem;
    border-radius: 16px;
    background-color: #f7f9ff;
    border: 1px solid #C9C9C9;
    flex-grow: 1;
}


.visually-hidden {
    clip-path: inset(50%);
    white-space: nowrap;
}

.visually-hidden, .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
}

.search-bar-container .search-input-field
{
    all: unset;
    width: 100%;
    color: var(--darkText);
    font-size: var(--font-size-intro);
    line-height: 1.6rem;
    text-align: start;
}

.search-bar-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.mat-mdc-icon-button:hover {
  background-color: #f0f0f0;
  border-radius: 16px;  
}

.mat-mdc-icon-button {
    -webkit-user-select: none;
    user-select: none;
    display: inline-block;
    position: relative;
    box-sizing: border-box;
    border: none;
    outline: none;
    background-color: rgba(0, 0, 0, 0);
    fill: currentColor;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    z-index: 0;
    overflow: visible;
    border-radius: 50%;
    flex-shrink: 0;
    text-align: center;
    width: var(--mdc-icon-button-state-layer-size, 40px);
    height: var(--mdc-icon-button-state-layer-size, 40px);
    padding: calc(calc(var(--mdc-icon-button-state-layer-size, 40px) - var(--mdc-icon-button-icon-size, 24px)) / 2);
    font-size: var(--mdc-icon-button-icon-size, 24px);
    color: var(--mdc-icon-button-icon-color, var(--mat-sys-on-surface-variant));
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
}

.mdc-button {
    -webkit-user-select: none;
    user-select: none;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 64px;
    border: none;
    outline: none;
    line-height: inherit;
    -webkit-appearance: none;
    overflow: visible;
    vertical-align: middle;
    background: rgba(0, 0, 0, 0);
    padding: 0 8px;
}

button.ethos-button {
    color: #28261b !important;
    font-size: large;
    font-weight: var(--font-weight-medium);
    min-height: 64px !important;
    border-radius: 16px !important;
    box-shadow: 2px 2px 1px 0px rgba(40, 38, 27, 0.2);
    background: #e8e6dc !important;
    transition: background  0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    text-decoration: none !important;
    overflow-wrap: break-word;
}

button.ethos-button:hover {
    background: #d4d0c3 !important;
    box-shadow: 2px 2px 8px 0px rgba(40, 38, 27, 0.4);
}

button.ethos-button.medium {
    min-height: 54px !important;  
}

button.ethos-button.small {
    min-height: 44px !important;  
}

button.ethos-button.tiny {
    min-height: 34px !important;  
    font-size: medium;
    border-radius: 12px;
}
.search-bar-actions button svg {
    vertical-align: top;
}

body.public-facing .btn-secondary, 
body.public-facing .btn-outline-secondary, 
body.public-facing .btn-outline-secondary > .filter-name:after, 
body.public-facing .sort-dropdown > .btn-outline-secondary, 
body.public-facing .per_page-dropdown > .btn-outline-secondary, 
body.public-facing .btn-light,
body.public-facing .catalog_startOverLink
{
    color: #28261b !important;
    font-size: large;
    font-weight: var(--font-weight-medium);
    border-radius: 16px !important;
    box-shadow: 2px 2px 1px 0px rgba(40, 38, 27, 0.2);
    background: #e8e6dc !important;
    transition: background  0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    text-decoration: none !important;
    border: none !important;
}

body.public-facing .btn-outline-secondary > .filter-name:after {
    box-shadow: none;
}

body.public-facing .btn-secondary > dd.hover, 
body.public-facing .btn-secondary > li.hover, 
body.public-facing .btn-secondary > a.hover, 
body.public-facing .btn-secondary:hover, 
body.public-facing .btn-outline-secondary:hover, 
body.public-facing .btn-secondary:hover, 
body.public-facing .btn-outline-secondary:hover, 
body.public-facing .btn-outline-secondary > .filter-name:after:hover, 
body.public-facing .sort-dropdown > .btn-outline-secondary:hover, 
body.public-facing .per_page-dropdown > .btn-outline-secondary:hover, 
body.public-facing .btn-light:hover,
{
    background-color: #d4d0c3 !important;
    box-shadow: 2px 2px 8px 0px rgba(40, 38, 27, 0.4);
}

body.public-facing .btn-outline-secondary:hover,
body.public-facing .catalog_startOverLink:hover,
body.public-facing .catalog_startOverLink:active,
body.public-facing .catalog_startOverLink:focus
{
    background-color: #d4d0c3 !important;
    box-shadow: 2px 2px 8px 0px rgba(40, 38, 27, 0.4);  
}

body.public-facing .btn-outline-secondary:hover > .filter-name:after {
      background-color: #d4d0c3 !important;
}

body.public-facing .card > .card-header, 
body.public-facing .card-header > .btn.w-100 {
    color: #28261b !important;
    font-size: large;
    font-weight: var(--font-weight-medium);
    border-radius: 16px !important;
    box-shadow: 2px 2px 1px 0px rgba(40, 38, 27, 0.2);
    background: #e8e6dc !important;
    transition: background  0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    text-decoration: none !important;

}

body.public-facing .card > .card-header:hover, 
body.public-facing .card-header > .btn.w-100:hover {
    background-color: #d4d0c3 !important;
    box-shadow: 2px 2px 8px 0px rgba(40, 38, 27, 0.4);
}

body.public-facing .facets .card {
  border-radius: 16px !important;  
  background-color: #f7f9ff;
}

.facet-field-heading button::after {
    content: "❯";
    float: right;
    transform: rotate(90deg);
}

body.public-facing h2.search-result-title {
  font-size: 1.75rem;
}

/* Error pages */

body.hyku_knapsack-errors.public-facing nav[role="search"] {
  display:none;
}

body.hyku_knapsack-errors.public-facing {
  div.dialog {
    width: 95%;
    max-width: 44em;
    margin: 4em auto 0;
    font-size: large;
    text-align: center;

  }

  div.dialog > div {
    border: 1px solid #CCC;
    border-right-color: #999;
    border-left-color: #999;
    border-bottom-color: #BBB;
    border-top: #B00100 solid 4px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    background-color: white;
    padding: 7px 12% 0;
    box-shadow: 0 3px 8px rgba(50, 50, 50, 0.17);
  }

  h1 {
    font-size: 100%;
    color: #730E15;
    line-height: 1.5em;
    font-size: x-large;
    text-align: center;
  }

  div.dialog > p {
    margin: 0 0 1em;
    padding: 1em;
    background-color: #F7F7F7;
    border: 1px solid #CCC;
    border-right-color: #999;
    border-left-color: #999;
    border-bottom-color: #999;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-top-color: #DADADA;
    color: #666;
    box-shadow: 0 3px 8px rgba(50, 50, 50, 0.17);
    text-align: center;
  }
  div.to_bottom {
	  min-height: 35vh;
  }
}

/* Advanced Search */

body.advanced.public-facing .advanced-search-form .limit-criteria {
  display: none;
}

body.advanced.public-facing nav[role="search"] {
  display:none;
}

body.advanced.public-facing .advanced-search-submit {
  color: #28261b !important;
  font-size: large;
  font-weight: var(--font-weight-medium);
  border-radius: 16px !important;
  box-shadow: 2px 2px 1px 0px rgba(40, 38, 27, 0.2);
  background: #e8e6dc !important;
  transition: background 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
  text-decoration: none !important;
  border: none !important;
}

body.advanced.public-facing .search-form {
  display: none; 
}

body.advanced.public-facing div.advanced-search-tips .card-title {
	font-size: 1.5rem;
}

body.advanced.public-facing ul.advanced-help {
  list-style-type: unset;
}

body.advanced.public-facing .query-criteria-heading select, body.advanced.public-facing .query-criteria-heading option {
	font-size: smaller;
}

/* Work page stuff */

body.public-facing .ethos_work_title_sub {
  margin-bottom: 1rem;  
  display: flex;
  div.metadata-group {display: inline-block !important;}
  dl {display: inline-block; margin-top: 0.7rem; margin-bottom: 0px;}
  dt {display:none;}  
  dd {color: #212529; width: auto; font-weight: var(--font-weight-semibold);}
  dd > ul > li > a {color: #212529; text-decoration: none; font-weight: var(--font-weight-semibold);}

  div.show-actions {display: inline-block; margin-left: auto; margin-right: 0px;}
  div.metadata-group dd ul.tabular {padding-left: 1rem;}
  div.metadata-group:first-child dd ul.tabular {padding-left: 0px;}

}

.ethos-restrictions {
  display: inline-block;
  margin-left: 0.6rem;
  color: var(--color-text-on-navigation);
  font-size: 94%;
  
  ul { padding-left: 0px; }
  
  dd {
    color: var(--color-text-on-navigation) !important;
    font-weight: var(--font-weight-regular) !important;
  }
}

.ethos-abstract {
  
  margin-bottom: 1rem;
  
  input {
    opacity: 0;
    position: absolute;
    pointer-events: none;
  }
  
  p {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;  
    overflow: hidden;
    margin-bottom: 0px
  }
  
  input:focus ~ label {
    outline: -webkit-focus-ring-color auto 5px;
  }
  
  input:checked + p {
    -webkit-line-clamp: unset;
  }
  label {
    margin: 0px;
  }
  input:checked ~ label {
    display: none;
  }
  input:checked ~ button {
    display: none;
  }
}

body.public-facing dl.work-show .ethos-button label {
  padding-top: 0.5em;
  color: #000;
}

/* Footer stuff */

.default_home footer, .cultural_repository footer, .institutional_repository footer {
    position: relative;
}

ul {
    list-style: none;
}

a {
    color: inherit;
    text-decoration: none;
}

body.public-facing a:hover, body.public-facing a:hover > span {
    text-decoration: underline;
}

@media (min-width: 37.5rem) {
    .Footer_footer___teav {
        padding: var(--m-64) var(--m-40);
    }
}
.Footer_footer___teav {
    background-color: var(--surface-navigation);
    padding: var(--m-64) var(--m-16) var(--m-64);
    border-top-left-radius: var(--radius-xl);
    border-top-right-radius: var(--radius-xl);
    margin-top: var(--block-spacing);
}

