    .Footer_linkListSectionsWrapper__ZfoDA {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: auto 1fr;
        grid-auto-flow: column;
        -moz-column-gap: var(--grid-gap);
        column-gap: var(--grid-gap);
        row-gap: var(--m-24);
        margin-bottom: var(--m-80);
    }
}
.Footer_linkListSectionsWrapper__ZfoDA {
    display: grid;
    flex-direction: column;
    gap: var(--m-16);
    margin-bottom: var(--m-64);
}

@media (min-width: 37.5rem) {
    .Footer_linkListSection__3KgIe {
        display: contents;
    }
}
.Footer_linkListSection__3KgIe {
    margin-bottom: var(--m-40);
    display: contents;
    flex-direction: column;
}


@media (min-width: 37.5rem) {
    .Footer_footerBottomHalf__m3Z1f {
        display: grid;
        gap: var(--m-32) var(--grid-gap);
        grid-template-rows: auto 1fr;
        grid-template-columns: 1fr 1fr;
    }
}
.Footer_footerBottomHalf__m3Z1f {
    display: grid;
    flex-direction: column;
    gap: var(--m-32);
}

@media (min-width: 37.5rem) {
    .Footer_secondaryLinksWrapper__ZnoKN {
        grid-column: 1 / -1;
    }
}


@media (min-width: 47.5rem) {
    .Footer_secondaryLinkList__KqJzw {
        display: flex;
        flex-direction: row;
        gap: var(--m-32);
    }
}
.Footer_secondaryLinkList__KqJzw {
    /*display: flex;*/
    flex-direction: row;
    gap: var(--m-12);
}

.Footer_navigationLink__9jLzE {
    color: var(--color-text-on-navigation-hover);
    transition: color var(--transition-fast);
}

.Typography_button__ytRRw {
    display: inline-block;
    font-size: var(--font-size-button);
    font-weight: var(--font-weight-medium);
    line-height: var(--button-line-height);
    letter-spacing: var(--button-letter-spacing);
}

.Footer_linkListSection__3KgIe > div > span {
    margin-left: 2.5rem;
    color: var(--color-text-primary);
}

.Footer_navigationLink__9jLzE {
    color: var(--color-text-on-navigation-hover);
    transition: color var(--transition-fast);
}

.Typography_typographyBase__IuNNw {
    font-family: var(--font-sans);
    color: var(--color-text-on-navigation-hover);
}

.Footer_copyright___JZCO {
    color: var(--color-text-on-navigation-hover);
    margin-left: 2.5rem;
}

@media (min-width: 37.5rem) {
    .Footer_socialLinksWrapper__mVcxr {
        justify-content: flex-end;
    }
}
.Footer_socialLinksWrapper__mVcxr {
    display: flex;
    flex-wrap: wrap;
    gap: var(--m-16);
    justify-content: flex-end;
    align-items: flex-end;
}

.IconButton_iconButton__eEZsx {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    min-width: 3rem;
    min-height: 3rem;
    transition: transform .3s ease-in-out;
    border-radius: var(--radius-xs);
}

.Footer_socialLink__LLIKA {
    height: 1.5rem;
    width: 1.5rem;
    color: var(--icon-color-secondary);
    transition: color var(--transition-fast), background var(--transition-fast);
}


