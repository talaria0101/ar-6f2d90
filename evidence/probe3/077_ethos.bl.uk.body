    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
<script>

  function ga_event_data(form_type, event_type, data) {
      common_data = {'event': event_type};
      if(form_type !== undefined){
        common_data['form_type'] =  form_type;
      }
      return $.extend(common_data, data);
  }
  function get_params(url) {
      var match = url.match(/\?(.*)$/); 
      return match[1];
  }
  function facets() {
      return ['ethos_subject_sim', 'date_issued_sim', 'qualification_name_sim', 'funder_search_sim', 'language_sim', 'current_he_institution_sim'];
    }
  function advanced_search_fields() {
      return ['title','creator_search','abstract','date_issued','contributor_search','funder_search','doi','ethos_identifier','university'];
  }
  function other_fields() {
      return ['op','sort_by','results_per_page'];
  }

  $( document ).ready(function() {
    window.dataLayer = window.dataLayer || [];
    $('#search-form-header').on("submit", function(event){
        window.dataLayer.push(ga_event_data('search', 'form_submission', {'term': $('#main-search-bar').val()}));
    });

    // CLICK ON FACET
    $('a.facet-select').on("click turbolinks:click", function(event){
      var urlParams = new URLSearchParams(get_params(event.target.href));
      data = {term: urlParams.get('q') || 'na'};
      facets().forEach(function(facet){
        if(urlParams.has(`f[${facet}][]`)){
          data[facet] = urlParams.get(`f[${facet}][]`);
        } 
      });
      data['sort_by'] = urlParams.get('sort') || 'relevance'
      data['results_per_page'] = urlParams.get('per_page') || 10
  
      window.dataLayer.push(ga_event_data('search', 'form_submission', data)); 
  
    });
    // SUBMIT ADVANCED SEARCH 
    $('#advanced_search_form').on("submit", function(event){
        data = {};
        $(event.target).find('input').each(function(index,input) {
          name = $(this).attr("name");
          value = $(this).val();
          if(jQuery.inArray(name, advanced_search_fields()) !== -1) {
            data[name] = value;
          }
        });
        window.dataLayer.push(ga_event_data('search_advanced', 'form_submission', data)); 
    });

    // CLICK SEARCH RESULT
      $('.search-result-title a').on("click", function(event){
        var urlParams = new URLSearchParams(get_params(window.location.href));

        data = {term: urlParams.get('q') || 'na'};
        data['result_title'] = $(event.target).text();
        data['result_id'] = $(event.target).attr('href').split("?").shift().split("/").pop();

        result_li = $(event.target).parents("li.document");
        data['result_position'] = $(result_li).index();

        data['results_count'] = $("span.page-entries strong:nth-child(3)").text();

        result_wrapper = $(event.target).parents(".search-result-wrapper");
        data['result_author'] = $(result_wrapper).find('.row:nth-child(1) dd.col-7 span').text();
        data['result_university'] = $(result_wrapper).find('.row:nth-child(2) dd.col-7').text();
        data['result_date_awarded'] = $(result_wrapper).find('.row:nth-child(3) dd.col-7').text();

        facets().forEach(function(facet){
          if(urlParams.has(`f[${facet}][]`)){
            data[facet] = urlParams.get(`f[${facet}][]`);
          }
        });
          advanced_search_fields().forEach(function(field){
          if(urlParams.has(field)){
            data[field] = urlParams.get(field);
          }
        });
        other_fields().forEach(function(field){
          if(urlParams.has(field)){
            data[field] = urlParams.get(field);
          }
        });

        window.dataLayer.push(ga_event_data(undefined, 'search_result_click', data));

    });
    // SEARCH RESULT PAGE LOAD
    if(window.location.pathname === '/catalog'){
      var urlParams = new URLSearchParams(get_params(window.location.href));
      entries = urlParams.entries();
      data={};
      for(const entry of entries) {
        if(entry[0] === '__cf_chl_f_tk'  || entry[0] === 'utf8' ){
          continue;
        }
        data[entry[0]] = entry[1] || 'na';
      }
      data['results_count'] = $("span.page-entries strong:nth-child(3)").text();
      window.dataLayer.push(ga_event_data('search_results', 'page_load', data)); 
    }

    // also treat turbolinks visits as pageloads
    $( document ).on('turbolinks:load', function(){
      if(window.location.pathname === '/catalog'){
          var urlParams = new URLSearchParams(get_params(window.location.href));
          entries = urlParams.entries();
          data={};
          for(const entry of entries) {
            if(entry[0] === '__cf_chl_f_tk'  || entry[0] === 'utf8' ){
              continue;
            }
            data[entry[0]] = entry[1] || 'na';
          }
          data['results_count'] = $("span.page-entries strong:nth-child(3)").text();
          window.dataLayer.push(ga_event_data('search_results', 'page_load', data)); 
      }
    });

  });
</script>

