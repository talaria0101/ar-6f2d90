    --transition-fast: var(--transition-duration-fast) ease-in-out;
    --transition-medium: var(--transition-duration-medium) ease-in-out;
    --transition-slow: var(--transition-duration-slow) ease-in-out;
    --z-index-modal: 100;
    --z-index-navigation-top: 99;
    --z-index-navigation-bottom: 98;
    --z-index-backdrop: 97;
