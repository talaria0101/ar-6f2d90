;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;ryanhoangt&quot;},&quot;name&quot;:&quot;Hoang H. Tran&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2024-07-25T08:19:36.107Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5ba4&quot;,&quot;name&quot;:&quot;Fuqiang Li&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5ba5&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;62581ef5d47cce537ee25963&quot;,&quot;avatarUrl&quot;:&quot;/avatars/d987c625791dc33c84bf9b51069bf2c8.svg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Ren Ma&quot;,&quot;user&quot;:&quot;renma&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;renma&quot;},&quot;name&quot;:&quot;Ren Ma&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2025-06-11T08:40:40.377Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5ba6&quot;,&quot;name&quot;:&quot;Mingzhang Zheng&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5ba7&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;641fa2e0863b87326f4a7fd5&quot;,&quot;avatarUrl&quot;:&quot;/avatars/7b29c20f942d83c08f63f04a85c15c13.svg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Bill Qian&quot;,&quot;user&quot;:&quot;lilbillbiscuit&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;lilbillbiscuit&quot;},&quot;name&quot;:&quot;Bill Qian&quot;,&quot;status&quot;:&quot;admin_assigned&quot;,&quot;statusLastChangedAt&quot;:&quot;2024-07-25T07:54:51.696Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5ba8&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;62970df979f193515da13dc0&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/62970df979f193515da13dc0/A-mgKIcgTXRJ54GCHswTq.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Daniel&quot;,&quot;user&quot;:&quot;super-dainiu&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;super-dainiu&quot;},&quot;name&quot;:&quot;Yanjun Shao&quot;,&quot;status&quot;:&quot;admin_assigned&quot;,&quot;statusLastChangedAt&quot;:&quot;2024-07-25T07:55:10.708Z&quot;,&quot;hidden&quot;:true},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5ba9&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;5f1eb362eec0ad2a071ad6e2&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/5f1eb362eec0ad2a071ad6e2/nDiBXdLrOTw67lJp_y_WA.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Niklas Muennighoff&quot;,&quot;user&quot;:&quot;Muennighoff&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;Muennighoff&quot;},&quot;name&quot;:&quot;Niklas Muennighoff&quot;,&quot;status&quot;:&quot;admin_assigned&quot;,&quot;statusLastChangedAt&quot;:&quot;2024-07-25T07:55:16.299Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5baa&quot;,&quot;name&quot;:&quot;Yizhe Zhang&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5bab&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;61e4c4ca1ab24785ac11ba69&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/61e4c4ca1ab24785ac11ba69/1Q1zhhyGSJ9RJG9MzwxVv.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Binyuan Hui&quot;,&quot;user&quot;:&quot;huybery&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;huybery&quot;},&quot;name&quot;:&quot;Binyuan Hui&quot;,&quot;status&quot;:&quot;admin_assigned&quot;,&quot;statusLastChangedAt&quot;:&quot;2024-07-25T07:55:45.961Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5bac&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;620760a26e3b7210c2ff1943&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/620760a26e3b7210c2ff1943/VC-rKqimF6yxGESNVlPoR.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Junyang Lin&quot;,&quot;user&quot;:&quot;JustinLin610&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;JustinLin610&quot;},&quot;name&quot;:&quot;Junyang Lin&quot;,&quot;status&quot;:&quot;admin_assigned&quot;,&quot;statusLastChangedAt&quot;:&quot;2024-07-25T07:56:17.993Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5bad&quot;,&quot;name&quot;:&quot;Robert Brennan&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5bae&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;660ec5a2509153ca49775a7c&quot;,&quot;avatarUrl&quot;:&quot;/avatars/97570fc245cc8ec7628da9c13bd35b71.svg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Hao Peng&quot;,&quot;user&quot;:&quot;haopeng01&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;haopeng01&quot;},&quot;name&quot;:&quot;Hao Peng&quot;,&quot;status&quot;:&quot;admin_assigned&quot;,&quot;statusLastChangedAt&quot;:&quot;2024-07-25T07:57:13.319Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5baf&quot;,&quot;name&quot;:&quot;Heng Ji&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;66a1b11eca8ee359d60b5bb0&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;60de14638bedd2315529d43f&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/1625166923504-noauth.png&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Graham Neubig&quot;,&quot;user&quot;:&quot;gneubig&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;gneubig&quot;},&quot;name&quot;:&quot;Graham Neubig&quot;,&quot;status&quot;:&quot;admin_assigned&quot;,&quot;statusLastChangedAt&quot;:&quot;2024-07-25T07:57:35.957Z&quot;,&quot;hidden&quot;:false}],&quot;publishedAt&quot;:&quot;2024-07-23T17:50:43.000Z&quot;,&quot;submittedOnDailyAt&quot;:&quot;2024-07-25T00:00:00.000Z&quot;,&quot;title&quot;:&quot;OpenDevin: An Open Platform for AI Software Developers as Generalist\n  Agents&quot;,&quot;submittedOnDailyBy&quot;:{&quot;_id&quot;:&quot;60f1abe7544c2adfd699860c&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/1674929746905-60f1abe7544c2adfd699860c.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;AK&quot;,&quot;user&quot;:&quot;akhaliq&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;akhaliq&quot;},&quot;summary&quot;:&quot;Software is one of the most powerful tools that we humans have at our\ndisposal; it allows a skilled programmer to interact with the world in complex\nand profound ways. At the same time, thanks to improvements in large language\nmodels (LLMs), there has also been a rapid development in AI agents that\ninteract with and affect change in their surrounding environments. In this\npaper, we introduce OpenDevin, a platform for the development of powerful and\nflexible AI agents that interact with the world in similar ways to those of a\nhuman developer: by writing code, interacting with a command line, and browsing\nthe web. We describe how the platform allows for the implementation of new\nagents, safe interaction with sandboxed environments for code execution,\ncoordination between multiple agents, and incorporation of evaluation\nbenchmarks. Based on our currently incorporated benchmarks, we perform an\nevaluation of agents over 15 challenging tasks, including software engineering\n(e.g., SWE-Bench) and web browsing (e.g., WebArena), among others. Released\nunder the permissive MIT license, OpenDevin is a community project spanning\nacademia and industry with more than 1.3K contributions from over 160\ncontributors and will improve going forward.&quot;,&quot;upvotes&quot;:90,&quot;discussionId&quot;:&quot;66a1b11fca8ee359d60b5bd5&quot;,&quot;githubRepo&quot;:&quot;https://github.com/opendevin/opendevin&quot;,&quot;githubRepoAddedBy&quot;:&quot;auto&quot;,&quot;ai_summary&quot;:&quot;OpenDevin is a platform for developing AI agents that interact with the world by writing code, using command lines, and browsing the web, with support for multiple agents and evaluation benchmarks.&quot;,&quot;ai_keywords&quot;:[&quot;large language models&quot;,&quot;OpenDevin&quot;,&quot;AI agents&quot;,&quot;code execution&quot;,&quot;sandboxed environments&quot;,&quot;evaluation benchmarks&quot;,&quot;SWE-Bench&quot;,&quot;WebArena&quot;],&quot;ai_summary_model&quot;:&quot;Qwen/Qwen2.5-Coder-32B-Instruct&quot;,&quot;githubStars&quot;:91293},&quot;publishedAt&quot;:&quot;2024-07-23T13:50:43.000Z&quot;,&quot;title&quot;:&quot;OpenDevin: An Open Platform for AI Software Developers as Generalist\n  Agents&quot;,&quot;summary&quot;:&quot;Software is one of the most powerful tools that we humans have at our\ndisposal; it allows a skilled programmer to interact with the world in complex\nand profound ways. At the same time, thanks to improvements in large language\nmodels (LLMs), there has also been a rapid development in AI agents that\ninteract with and affect change in their surrounding environments. In this\npaper, we introduce OpenDevin, a platform for the development of powerful and\nflexible AI agents that interact with the world in similar ways to those of a\nhuman developer: by writing code, interacting with a command line, and browsing\nthe web. We describe how the platform allows for the implementation of new\nagents, safe interaction with sandboxed environments for code execution,\ncoordination between multiple agents, and incorporation of evaluation\nbenchmarks. Based on our currently incorporated benchmarks, we perform an\nevaluation of agents over 15 challenging tasks, including software engineering\n(e.g., SWE-Bench) and web browsing (e.g., WebArena), among others. Released\nunder the permissive MIT license, OpenDevin is a community project spanning\nacademia and industry with more than 1.3K contributions from over 160\ncontributors and will improve going forward.&quot;,&quot;thumbnail&quot;:&quot;https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2407.16741.png&quot;,&quot;numComments&quot;:7,&quot;upvoted&quot;:false,&quot;submittedBy&quot;:{&quot;_id&quot;:&quot;60f1abe7544c2adfd699860c&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/1674929746905-60f1abe7544c2adfd699860c.jpeg&quot;,&quot;fullname&quot;:&quot;AK&quot;,&quot;name&quot;:&quot;akhaliq&quot;,&quot;type&quot;:&quot;user&quot;,&quot;isPro&quot;:false,&quot;isHf&quot;:true,&quot;isHfAdmin&quot;:false,&quot;isMod&quot;:false,&quot;followerCount&quot;:10443,&quot;isUserFollowing&quot;:false},&quot;isAuthorParticipating&quot;:true},{&quot;paper&quot;:{&quot;id&quot;:&quot;2610.20571&quot;,&quot;authors&quot;:[{&quot;_id&quot;:&quot;6ad0370daab7978cb679de82&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;66699aa8a33847217b5a49c7&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/noauth/u8Z-6U8U7ARXOpdBDI7Qm.png&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Weijie Wang&quot;,&quot;user&quot;:&quot;lhmd&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;lhmd&quot;},&quot;name&quot;:&quot;Weijie Wang&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2026-10-15T08:45:06.844Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad0370daab7978cb679de83&quot;,&quot;name&quot;:&quot;Haomin Zhang&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad0370daab7978cb679de84&quot;,&quot;name&quot;:&quot;Ye Li&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad0370daab7978cb679de85&quot;,&quot;name&quot;:&quot;Akide Liu&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad0370daab7978cb679de86&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;64ec877bb93654d4ca5c92e9&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64ec877bb93654d4ca5c92e9/Tj6F58adBU7n1uUC8qwQH.jpeg&quot;,&quot;isPro&quot;:true,&quot;fullname&quot;:&quot;Zeyu Zhang&quot;,&quot;user&quot;:&quot;SteveZeyuZhang&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;SteveZeyuZhang&quot;},&quot;name&quot;:&quot;Zeyu Zhang&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2026-10-15T09:39:24.883Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad0370daab7978cb679de87&quot;,&quot;name&quot;:&quot;Haoyu Zhao&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad0370daab7978cb679de88&quot;,&quot;name&quot;:&quot;Yefei He&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad0370daab7978cb679de89&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;653862bdbe39573b3b247b44&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/653862bdbe39573b3b247b44/oMqOC4USbQlPX5HFLDXt6.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Donny Chen&quot;,&quot;user&quot;:&quot;donydchen&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;donydchen&quot;},&quot;name&quot;:&quot;Donny Y. Chen&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2026-10-15T08:45:06.862Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad0370daab7978cb679de8a&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;64574380f3ef144c0e69d484&quot;,&quot;avatarUrl&quot;:&quot;/avatars/a0a84757cb0bf09c24291803e1389b49.svg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Feng Chen&quot;,&quot;user&quot;:&quot;chenfeng1271&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;chenfeng1271&quot;},&quot;name&quot;:&quot;Feng Chen&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2026-10-15T08:45:06.853Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad0370daab7978cb679de8b&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;65a8a828ef14f9e6037dfad2&quot;,&quot;avatarUrl&quot;:&quot;/avatars/55fdc0393b2e37ac998ddbdb1e1ff636.svg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Bohan Zhuang&quot;,&quot;user&quot;:&quot;BohanZ&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;BohanZ&quot;},&quot;name&quot;:&quot;Bohan Zhuang&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2026-10-15T16:45:05.530Z&quot;,&quot;hidden&quot;:false}],&quot;mediaUrls&quot;:[&quot;https://cdn-uploads.huggingface.co/production/uploads/66699aa8a33847217b5a49c7/YgsTMXs-dTVwLakJbrZfc.mp4&quot;],&quot;publishedAt&quot;:&quot;2026-10-14T00:00:00.000Z&quot;,&quot;submittedOnDailyAt&quot;:&quot;2026-10-15T00:00:00.000Z&quot;,&quot;title&quot;:&quot;Any Time, Any Space: A World-State-Centric Framework for Agentic Video Generation&quot;,&quot;submittedOnDailyBy&quot;:{&quot;_id&quot;:&quot;66699aa8a33847217b5a49c7&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/noauth/u8Z-6U8U7ARXOpdBDI7Qm.png&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Weijie Wang&quot;,&quot;user&quot;:&quot;lhmd&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;lhmd&quot;},&quot;summary&quot;:&quot;Long-form agentic video generation must turn a screenplay into shots that remain spatially and temporally consistent across nonconsecutive requests. Passing prompts or recent frames between shots does not provide a shared spatial frame for revisiting a scene or a time-indexed record for replaying an earlier event. We present Any Time, Any Space (ATAS), which compiles a screenplay into shot requests with explicit location, camera, and event-time references. Before generation, it retrieves relevant evidence from a scene memory of registered static geometry and an event memory of dynamic observations indexed by scene, event, and time. After generation, ATAS reconstructs and registers the clip. It updates memory only when review and state checks accept the observation, while film delivery remains independent of memory admission. Across four video generators, ATAS improves all reported cross-shot consistency measures and achieves the highest aggregate benchmark score for each backbone. It also outperforms the compared agents and 3D-guided methods on target-image spatial revisit, leads three event-recapture criteria, and receives the highest human ratings on all six criteria. The video results and code are available on our project page: https://lhmd.top/atas/.&quot;,&quot;upvotes&quot;:359,&quot;discussionId&quot;:&quot;6ad0370daab7978cb679de8c&quot;,&quot;projectPage&quot;:&quot;https://lhmd.top/atas/&quot;,&quot;githubRepo&quot;:&quot;https://github.com/ziplab/ATAS&quot;,&quot;githubRepoAddedBy&quot;:&quot;user&quot;,&quot;ai_summary&quot;:&quot;ATAS improves long-form video consistency by compiling screenplays into referenced shot requests, retrieving spatial and temporal evidence from scene and event memories, and conditionally updating memory after generation.&quot;,&quot;ai_keywords&quot;:[&quot;agentic video generation&quot;,&quot;screenplay&quot;,&quot;spatial consistency&quot;,&quot;temporal consistency&quot;,&quot;scene memory&quot;,&quot;event memory&quot;,&quot;static geometry&quot;,&quot;dynamic observations&quot;,&quot;cross-shot consistency&quot;],&quot;ai_summary_model&quot;:&quot;thinkingmachines/Inkling-Small&quot;,&quot;githubStars&quot;:292,&quot;organization&quot;:{&quot;_id&quot;:&quot;61bac2af530e5c78d7b99667&quot;,&quot;name&quot;:&quot;zju&quot;,&quot;fullname&quot;:&quot;Zhejiang University&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/5e1058e9fcf41d740b69966d/7G1xjlxwCdMEmKcxNR0n5.png&quot;}},&quot;publishedAt&quot;:&quot;2026-10-13T20:00:00.000Z&quot;,&quot;title&quot;:&quot;Any Time, Any Space: A World-State-Centric Framework for Agentic Video Generation&quot;,&quot;summary&quot;:&quot;Long-form agentic video generation must turn a screenplay into shots that remain spatially and temporally consistent across nonconsecutive requests. Passing prompts or recent frames between shots does not provide a shared spatial frame for revisiting a scene or a time-indexed record for replaying an earlier event. We present Any Time, Any Space (ATAS), which compiles a screenplay into shot requests with explicit location, camera, and event-time references. Before generation, it retrieves relevant evidence from a scene memory of registered static geometry and an event memory of dynamic observations indexed by scene, event, and time. After generation, ATAS reconstructs and registers the clip. It updates memory only when review and state checks accept the observation, while film delivery remains independent of memory admission. Across four video generators, ATAS improves all reported cross-shot consistency measures and achieves the highest aggregate benchmark score for each backbone. It also outperforms the compared agents and 3D-guided methods on target-image spatial revisit, leads three event-recapture criteria, and receives the highest human ratings on all six criteria. The video results and code are available on our project page: https://lhmd.top/atas/.&quot;,&quot;mediaUrls&quot;:[&quot;https://cdn-uploads.huggingface.co/production/uploads/66699aa8a33847217b5a49c7/YgsTMXs-dTVwLakJbrZfc.mp4&quot;],&quot;thumbnail&quot;:&quot;https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2610.20571.png&quot;,&quot;numComments&quot;:3,&quot;upvoted&quot;:false,&quot;submittedBy&quot;:{&quot;_id&quot;:&quot;66699aa8a33847217b5a49c7&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/noauth/u8Z-6U8U7ARXOpdBDI7Qm.png&quot;,&quot;fullname&quot;:&quot;Weijie Wang&quot;,&quot;name&quot;:&quot;lhmd&quot;,&quot;type&quot;:&quot;user&quot;,&quot;isPro&quot;:false,&quot;isHf&quot;:false,&quot;isHfAdmin&quot;:false,&quot;isMod&quot;:false,&quot;followerCount&quot;:17,&quot;isUserFollowing&quot;:false},&quot;organization&quot;:{&quot;_id&quot;:&quot;61bac2af530e5c78d7b99667&quot;,&quot;name&quot;:&quot;zju&quot;,&quot;fullname&quot;:&quot;Zhejiang University&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/5e1058e9fcf41d740b69966d/7G1xjlxwCdMEmKcxNR0n5.png&quot;},&quot;isAuthorParticipating&quot;:true},{&quot;paper&quot;:{&quot;id&quot;:&quot;2610.13912&quot;,&quot;authors&quot;:[{&quot;_id&quot;:&quot;6acc3dc90ee6ff34004fddd1&quot;,&quot;name&quot;:&quot;Taoyong Cui&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acc3dc90ee6ff34004fddd2&quot;,&quot;name&quot;:&quot;Pinxian Zeng&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acc3dc90ee6ff34004fddd3&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;65f3f43fc9940817ca9a427b&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/65f3f43fc9940817ca9a427b/02NN3XjSsbgWDhjrJWtVL.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Wanghan Xu&quot;,&quot;user&quot;:&quot;black-yt&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;black-yt&quot;},&quot;name&quot;:&quot;Wanghan Xu&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2026-10-12T16:15:51.423Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acc3dc90ee6ff34004fddd4&quot;,&quot;name&quot;:&quot;Hao Xiao&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acc3dc90ee6ff34004fddd5&quot;,&quot;name&quot;:&quot;Shuhan Xue&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acc3dc90ee6ff34004fddd6&quot;,&quot;name&quot;:&quot;Qiang Gao&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acc3dc90ee6ff34004fddd7&quot;,&quot;name&quot;:&quot;Wanli Ouyang&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acc3dc90ee6ff34004fddd8&quot;,&quot;name&quot;:&quot;Pheng Ann Heng&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acc3dc90ee6ff34004fddd9&quot;,&quot;name&quot;:&quot;Zhenfei Yin&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acc3dc90ee6ff34004fddda&quot;,&quot;name&quot;:&quot;Yingcheng Wu&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acc3dc90ee6ff34004fdddb&quot;,&quot;name&quot;:&quot;Ling Yang&quot;,&quot;hidden&quot;:false}],&quot;publishedAt&quot;:&quot;2026-10-09T00:00:00.000Z&quot;,&quot;submittedOnDailyAt&quot;:&quot;2026-10-12T00:00:00.000Z&quot;,&quot;title&quot;:&quot;RSI-Anything: Unlocking Recursive Self-Improvement with World Models&quot;,&quot;submittedOnDailyBy&quot;:{&quot;_id&quot;:&quot;64fde4e252e82dd432b74ce9&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64fde4e252e82dd432b74ce9/-CQZbBP7FsPPyawYrsi4z.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Ling Yang&quot;,&quot;user&quot;:&quot;Lingaaaaaaa&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;Lingaaaaaaa&quot;},&quot;summary&quot;:&quot;Recursive self-improvement (RSI) aims to transform interaction experience into persistent improvements, yet external feedback is costly and world-model predictions may become unreliable as policies evolve. We introduce RSI-Anything, a domain-general framework built on JEPA-Anything that uses predictive world models to guide action and learning-data selection. Observed feedback drives policy or workflow improvement and conditional world-model adaptation, while component and compatibility checks govern the retention of updated policy-model pairs. Across diverse computational and scientific domains, RSI-Anything demonstrates substantial gains. In code repair, with the coder fixed, success increases from 26.3% with a static verifier to 29.2% through predictive selection and 31.2% after world-model adaptation, at comparable test usage. Graphical user interface (GUI) evaluations showed higher task completion, while average actions decrease by 39.4%. Across five successive policy versions, laboratory-planning scores more than double from 21.80% to 46.01%. In reaction optimization, RSI-Anything achieves 96.15% mean best observed yield versus 82.16% for Bayesian optimization under the same 40-experiment budget. An end-to-end immune-science application further connects workflow evolution and predictive modeling with therapeutic hypothesis generation. These results demonstrate how predictive world models and retained system updates enable recursive improvement across diverse environments.&quot;,&quot;upvotes&quot;:52,&quot;discussionId&quot;:&quot;6acc3dc90ee6ff34004fdddc&quot;,&quot;projectPage&quot;:&quot;https://huggingface.co/datasets/Gen-Verse/RSI-Anything&quot;,&quot;githubRepo&quot;:&quot;https://github.com/Gen-Verse/RSI-Anything&quot;,&quot;githubRepoAddedBy&quot;:&quot;user&quot;,&quot;ai_summary&quot;:&quot;RSI-Anything leverages predictive world models to guide action selection and adaptive learning, enabling recursive self-improvement across coding, interface navigation, laboratory planning, and scientific optimization tasks.&quot;,&quot;ai_keywords&quot;:[&quot;recursive self-improvement&quot;,&quot;predictive world models&quot;,&quot;JEPA-Anything&quot;,&quot;conditional world-model adaptation&quot;,&quot;policy-model pairs&quot;,&quot;code repair&quot;,&quot;GUI evaluation&quot;,&quot;laboratory planning&quot;,&quot;reaction optimization&quot;,&quot;Bayesian optimization&quot;],&quot;ai_summary_model&quot;:&quot;thinkingmachines/Inkling-Small&quot;,&quot;githubStars&quot;:801,&quot;organization&quot;:{&quot;_id&quot;:&quot;6aab7c097e5721f5e005ff0a&quot;,&quot;name&quot;:&quot;PhAILabs&quot;,&quot;fullname&quot;:&quot;PhAI Labs&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64fde4e252e82dd432b74ce9/5-hyYwAMko5JVJz5qWxEj.png&quot;}},&quot;publishedAt&quot;:&quot;2026-10-08T20:00:00.000Z&quot;,&quot;title&quot;:&quot;RSI-Anything: Unlocking Recursive Self-Improvement with World Models&quot;,&quot;summary&quot;:&quot;Recursive self-improvement (RSI) aims to transform interaction experience into persistent improvements, yet external feedback is costly and world-model predictions may become unreliable as policies evolve. We introduce RSI-Anything, a domain-general framework built on JEPA-Anything that uses predictive world models to guide action and learning-data selection. Observed feedback drives policy or workflow improvement and conditional world-model adaptation, while component and compatibility checks govern the retention of updated policy-model pairs. Across diverse computational and scientific domains, RSI-Anything demonstrates substantial gains. In code repair, with the coder fixed, success increases from 26.3% with a static verifier to 29.2% through predictive selection and 31.2% after world-model adaptation, at comparable test usage. Graphical user interface (GUI) evaluations showed higher task completion, while average actions decrease by 39.4%. Across five successive policy versions, laboratory-planning scores more than double from 21.80% to 46.01%. In reaction optimization, RSI-Anything achieves 96.15% mean best observed yield versus 82.16% for Bayesian optimization under the same 40-experiment budget. An end-to-end immune-science application further connects workflow evolution and predictive modeling with therapeutic hypothesis generation. These results demonstrate how predictive world models and retained system updates enable recursive improvement across diverse environments.&quot;,&quot;thumbnail&quot;:&quot;https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2610.13912.png&quot;,&quot;numComments&quot;:2,&quot;upvoted&quot;:false,&quot;submittedBy&quot;:{&quot;_id&quot;:&quot;64fde4e252e82dd432b74ce9&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64fde4e252e82dd432b74ce9/-CQZbBP7FsPPyawYrsi4z.jpeg&quot;,&quot;fullname&quot;:&quot;Ling Yang&quot;,&quot;name&quot;:&quot;Lingaaaaaaa&quot;,&quot;type&quot;:&quot;user&quot;,&quot;isPro&quot;:false,&quot;isHf&quot;:false,&quot;isHfAdmin&quot;:false,&quot;isMod&quot;:false,&quot;followerCount&quot;:22,&quot;isUserFollowing&quot;:false},&quot;organization&quot;:{&quot;_id&quot;:&quot;6aab7c097e5721f5e005ff0a&quot;,&quot;name&quot;:&quot;PhAILabs&quot;,&quot;fullname&quot;:&quot;PhAI Labs&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64fde4e252e82dd432b74ce9/5-hyYwAMko5JVJz5qWxEj.png&quot;},&quot;isAuthorParticipating&quot;:false},{&quot;paper&quot;:{&quot;id&quot;:&quot;2610.17309&quot;,&quot;authors&quot;:[{&quot;_id&quot;:&quot;6acf32baabe004a210f26132&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;6575a625b951d40e7a4d8685&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/6575a625b951d40e7a4d8685/leLO3QA-5YAt8CYRtqp1t.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Xialie Zhuang&quot;,&quot;user&quot;:&quot;Lie24&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;Lie24&quot;},&quot;name&quot;:&quot;Xialie Zhuang&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2026-10-15T16:45:05.481Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf32baabe004a210f26133&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;655b4f5cc11dee7f7e882a0c&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/655b4f5cc11dee7f7e882a0c/4GaAC5Qt55eYlbNRJpVD5.png&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;zunhaisu&quot;,&quot;user&quot;:&quot;zunhai&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;zunhai&quot;},&quot;name&quot;:&quot;Zunhai Su&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2026-10-17T08:45:04.807Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf32baabe004a210f26134&quot;,&quot;name&quot;:&quot;Jia Pan&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf32baabe004a210f26135&quot;,&quot;name&quot;:&quot;Ngai Wong&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf32baabe004a210f26136&quot;,&quot;name&quot;:&quot;Guanhua Chen&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf32baabe004a210f26137&quot;,&quot;name&quot;:&quot;Chuan-Wei Kuo&quot;,&quot;hidden&quot;:false}],&quot;mediaUrls&quot;:[&quot;https://cdn-uploads.huggingface.co/production/uploads/6575a625b951d40e7a4d8685/K8v_BuPg3dCy8YIbZV-Hu.png&quot;],&quot;publishedAt&quot;:&quot;2026-10-12T00:00:00.000Z&quot;,&quot;submittedOnDailyAt&quot;:&quot;2026-10-15T00:00:00.000Z&quot;,&quot;title&quot;:&quot;StartLux-Decision: AutoThink Decision Models with Reinforcement Learning for Calibrated Deliberative Decisions&quot;,&quot;submittedOnDailyBy&quot;:{&quot;_id&quot;:&quot;6575a625b951d40e7a4d8685&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/6575a625b951d40e7a4d8685/leLO3QA-5YAt8CYRtqp1t.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Xialie Zhuang&quot;,&quot;user&quot;:&quot;Lie24&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;Lie24&quot;},&quot;summary&quot;:&quot;We introduce StartLux-Decision, decision models from 0.8B to 27B parameters that combine efficient single-pass prediction with adaptive, confidence-guided reasoning. The Instant models use bidirectional attention in full-attention layers to improve decision accuracy while keeping single-pass inference. The AutoThink models invoke explicit reasoning for uncertain decisions and answer confident cases directly. A three-stage training pipeline establishes shared decision capabilities, specializes the two variants, and equips AutoThink with reasoning through reasoning supervision and reinforcement learning. We introduce Reinforcement Learning for Calibrated Deliberative Decisions (RLCD^2), which uses a frozen model and proper scoring rules to reward improvements in decision probability quality and applies a soft penalty to overlong reasoning traces. RLCD^2 raises the share of reasoning traces that terminate within the generation limit by up to 48 percentage points and cuts average reasoning length by up to 65%, while largely preserving decision accuracy. On the public subset of Decision Index 0.3, the Instant models outperform the strongest evaluated comparable-scale open-weight decision models by 7.4-16.9 points, and the 27B AutoThink model reaches 73.4. We also introduce DecisionPivot, a programmatically verifiable benchmark of computational decisions built from contrast pairs that differ in a single answer-changing detail. On DecisionPivot, AutoThink outperforms its Instant counterparts by 11.5-18.4 points in pair accuracy and leads among evaluated systems. The models run on vLLM, llama.cpp and MLX, with quantized variants for lower memory use.&quot;,&quot;upvotes&quot;:20,&quot;discussionId&quot;:&quot;6acf32bbabe004a210f26138&quot;,&quot;projectPage&quot;:&quot;https://decision.startlux.com/&quot;,&quot;githubRepo&quot;:&quot;https://github.com/StartLuxLabs/StartLux-Decision&quot;,&quot;githubRepoAddedBy&quot;:&quot;user&quot;,&quot;ai_summary&quot;:&quot;StartLux-Decision introduces efficient and adaptive decision models using single-pass prediction and confidence-guided reasoning, trained via a three-stage pipeline with RLCD² reinforcement learning, and evaluates them on Decision Index and the DecisionPivot benchmark.&quot;,&quot;ai_keywords&quot;:[&quot;bidirectional attention&quot;,&quot;cross-attention&quot;,&quot;reasoning supervision&quot;,&quot;reinforcement learning&quot;,&quot;RLCD²&quot;,&quot;proper scoring rules&quot;,&quot;decision probability&quot;,&quot;reasoning traces&quot;,&quot;DecisionPivot&quot;,&quot;contrast pairs&quot;,&quot;vLLM&quot;,&quot;llama.cpp&quot;,&quot;MLX&quot;],&quot;ai_summary_model&quot;:&quot;thinkingmachines/Inkling-Small&quot;,&quot;githubStars&quot;:830,&quot;organization&quot;:{&quot;_id&quot;:&quot;6a7c4cc758cb28f623454ea4&quot;,&quot;name&quot;:&quot;startlux-models&quot;,&quot;fullname&quot;:&quot;StartLux&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64d33626465b6039259b9c72/6xsdrTfPBTVyKxaNDVi16.png&quot;}},&quot;publishedAt&quot;:&quot;2026-10-11T20:00:00.000Z&quot;,&quot;title&quot;:&quot;StartLux-Decision: AutoThink Decision Models with Reinforcement Learning for Calibrated Deliberative Decisions&quot;,&quot;summary&quot;:&quot;We introduce StartLux-Decision, decision models from 0.8B to 27B parameters that combine efficient single-pass prediction with adaptive, confidence-guided reasoning. The Instant models use bidirectional attention in full-attention layers to improve decision accuracy while keeping single-pass inference. The AutoThink models invoke explicit reasoning for uncertain decisions and answer confident cases directly. A three-stage training pipeline establishes shared decision capabilities, specializes the two variants, and equips AutoThink with reasoning through reasoning supervision and reinforcement learning. We introduce Reinforcement Learning for Calibrated Deliberative Decisions (RLCD^2), which uses a frozen model and proper scoring rules to reward improvements in decision probability quality and applies a soft penalty to overlong reasoning traces. RLCD^2 raises the share of reasoning traces that terminate within the generation limit by up to 48 percentage points and cuts average reasoning length by up to 65%, while largely preserving decision accuracy. On the public subset of Decision Index 0.3, the Instant models outperform the strongest evaluated comparable-scale open-weight decision models by 7.4-16.9 points, and the 27B AutoThink model reaches 73.4. We also introduce DecisionPivot, a programmatically verifiable benchmark of computational decisions built from contrast pairs that differ in a single answer-changing detail. On DecisionPivot, AutoThink outperforms its Instant counterparts by 11.5-18.4 points in pair accuracy and leads among evaluated systems. The models run on vLLM, llama.cpp and MLX, with quantized variants for lower memory use.&quot;,&quot;mediaUrls&quot;:[&quot;https://cdn-uploads.huggingface.co/production/uploads/6575a625b951d40e7a4d8685/K8v_BuPg3dCy8YIbZV-Hu.png&quot;],&quot;thumbnail&quot;:&quot;https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2610.17309.png&quot;,&quot;numComments&quot;:2,&quot;upvoted&quot;:false,&quot;submittedBy&quot;:{&quot;_id&quot;:&quot;6575a625b951d40e7a4d8685&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/6575a625b951d40e7a4d8685/leLO3QA-5YAt8CYRtqp1t.jpeg&quot;,&quot;fullname&quot;:&quot;Xialie Zhuang&quot;,&quot;name&quot;:&quot;Lie24&quot;,&quot;type&quot;:&quot;user&quot;,&quot;isPro&quot;:false,&quot;isHf&quot;:false,&quot;isHfAdmin&quot;:false,&quot;isMod&quot;:false,&quot;followerCount&quot;:11,&quot;isUserFollowing&quot;:false},&quot;organization&quot;:{&quot;_id&quot;:&quot;6a7c4cc758cb28f623454ea4&quot;,&quot;name&quot;:&quot;startlux-models&quot;,&quot;fullname&quot;:&quot;StartLux&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64d33626465b6039259b9c72/6xsdrTfPBTVyKxaNDVi16.png&quot;},&quot;isAuthorParticipating&quot;:true},{&quot;paper&quot;:{&quot;id&quot;:&quot;2610.23839&quot;,&quot;authors&quot;:[{&quot;_id&quot;:&quot;6ad574fe60556d9547d94dea&quot;,&quot;name&quot;:&quot;Jianyuan Zhong&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94deb&quot;,&quot;name&quot;:&quot;Chenwei Wu&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94dec&quot;,&quot;name&quot;:&quot;Zhaochen Yu&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94ded&quot;,&quot;name&quot;:&quot;Xixian Jiang&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94dee&quot;,&quot;name&quot;:&quot;Xuewei Li&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94def&quot;,&quot;name&quot;:&quot;Hao Xiao&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94df0&quot;,&quot;name&quot;:&quot;Xilin Dai&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94df1&quot;,&quot;name&quot;:&quot;Junyang Wang&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94df2&quot;,&quot;name&quot;:&quot;Jiaru Zou&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94df3&quot;,&quot;name&quot;:&quot;Zhiqing Cui&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94df4&quot;,&quot;name&quot;:&quot;Boyuan Zheng&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94df5&quot;,&quot;name&quot;:&quot;Jing Xiong&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94df6&quot;,&quot;name&quot;:&quot;Zhen Zhang&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94df7&quot;,&quot;name&quot;:&quot;Qiang Gao&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94df8&quot;,&quot;name&quot;:&quot;Michael Morley&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94df9&quot;,&quot;name&quot;:&quot;Luis Nakayama&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94dfa&quot;,&quot;name&quot;:&quot;Qiang Xu&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94dfb&quot;,&quot;name&quot;:&quot;Liyue Shen&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94dfc&quot;,&quot;name&quot;:&quot;Tao Gui&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94dfd&quot;,&quot;name&quot;:&quot;Leo Anthony Celi&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94dfe&quot;,&quot;name&quot;:&quot;James Zou&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94dff&quot;,&quot;name&quot;:&quot;Zhenfei Yin&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94e00&quot;,&quot;name&quot;:&quot;Yingcheng Wu&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ad574fe60556d9547d94e01&quot;,&quot;name&quot;:&quot;Ling Yang&quot;,&quot;hidden&quot;:false}],&quot;publishedAt&quot;:&quot;2026-10-16T00:00:00.000Z&quot;,&quot;submittedOnDailyAt&quot;:&quot;2026-10-19T00:00:00.000Z&quot;,&quot;title&quot;:&quot;DiscoveryRSI: Recursively Learning to Discover Valuable Hypotheses&quot;,&quot;submittedOnDailyBy&quot;:{&quot;_id&quot;:&quot;64fde4e252e82dd432b74ce9&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64fde4e252e82dd432b74ce9/-CQZbBP7FsPPyawYrsi4z.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Ling Yang&quot;,&quot;user&quot;:&quot;Lingaaaaaaa&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;Lingaaaaaaa&quot;},&quot;summary&quot;:&quot;Scientific discovery requires developing worthwhile hypotheses into practical investigations, yet learning from this evolving research process remains challenging. We introduce an operational definition of valuable and testable research hypotheses: evidence-grounded claims about consequential uncertainties, coupled with feasible investigations, explicit decision criteria, and alternative explanations. Our DiscoveryRSI framework develops hypothesis trees through multi-agent evolutionary search, compiles selected investigations into executable Harbor tasks, and recursively learns through three mechanisms: hypothesis credit optimization attributes scientific assessments to documented research contributions; harness replay identifies productive strategies and recurring failures to refine research workflows; and rediscovery applies accepted improvements to new investigations, generating further experience for subsequent learning. We also introduce DFM-Bench, which provides comprehensive assessment of hypothesis quality and cumulative research progress at the levels of hypotheses, revisions, development paths and research runs. Across four life-science domains, automated evaluation shows that hypothesis quality rises from 4.86 for the base model to 5.39 after two rounds of self-improvement, with the large gains in falsifiability and data resolvability. We further validate hypothesis quality through expert review, comparing our DiscoveryRSI-27B with other research agents. Preliminary human assessments show that DiscoveryRSI-27B scores higher than GPT-6 Luna on hypothesis importance and whether claims are plausible and evidence-bounded. DiscoveryRSI-27B achieved a 6.3% rate of hypothesis correspondence with research published after the model cutoff, largely outperform GPT-6 with 2.5% and Claude Opus 5 with 2.3%, while delivering greater human-rated improvement along research paths.&quot;,&quot;upvotes&quot;:14,&quot;discussionId&quot;:&quot;6ad574fe60556d9547d94e02&quot;,&quot;projectPage&quot;:&quot;https://huggingface.co/Gen-Verse/DiscoveryRSI-27B&quot;,&quot;githubRepo&quot;:&quot;https://github.com/Gen-Verse/DiscoveryRSI&quot;,&quot;githubRepoAddedBy&quot;:&quot;user&quot;,&quot;ai_summary&quot;:&quot;DiscoveryRSI uses multi-agent evolutionary search and recursive learning to generate testable scientific hypotheses, improving quality through self-improvement and outperforming baseline agents on life-science benchmarks.&quot;,&quot;ai_keywords&quot;:[&quot;multi-agent evolutionary search&quot;,&quot;hypothesis trees&quot;,&quot;hypothesis credit optimization&quot;,&quot;harness replay&quot;,&quot;rediscovery&quot;,&quot;DFM-Bench&quot;,&quot;falsifiability&quot;,&quot;data resolvability&quot;],&quot;ai_summary_model&quot;:&quot;thinkingmachines/Inkling-Small&quot;,&quot;githubStars&quot;:72,&quot;organization&quot;:{&quot;_id&quot;:&quot;6aab7c097e5721f5e005ff0a&quot;,&quot;name&quot;:&quot;PhAILabs&quot;,&quot;fullname&quot;:&quot;PhAI Labs&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64fde4e252e82dd432b74ce9/5-hyYwAMko5JVJz5qWxEj.png&quot;}},&quot;publishedAt&quot;:&quot;2026-10-15T20:00:00.000Z&quot;,&quot;title&quot;:&quot;DiscoveryRSI: Recursively Learning to Discover Valuable Hypotheses&quot;,&quot;summary&quot;:&quot;Scientific discovery requires developing worthwhile hypotheses into practical investigations, yet learning from this evolving research process remains challenging. We introduce an operational definition of valuable and testable research hypotheses: evidence-grounded claims about consequential uncertainties, coupled with feasible investigations, explicit decision criteria, and alternative explanations. Our DiscoveryRSI framework develops hypothesis trees through multi-agent evolutionary search, compiles selected investigations into executable Harbor tasks, and recursively learns through three mechanisms: hypothesis credit optimization attributes scientific assessments to documented research contributions; harness replay identifies productive strategies and recurring failures to refine research workflows; and rediscovery applies accepted improvements to new investigations, generating further experience for subsequent learning. We also introduce DFM-Bench, which provides comprehensive assessment of hypothesis quality and cumulative research progress at the levels of hypotheses, revisions, development paths and research runs. Across four life-science domains, automated evaluation shows that hypothesis quality rises from 4.86 for the base model to 5.39 after two rounds of self-improvement, with the large gains in falsifiability and data resolvability. We further validate hypothesis quality through expert review, comparing our DiscoveryRSI-27B with other research agents. Preliminary human assessments show that DiscoveryRSI-27B scores higher than GPT-6 Luna on hypothesis importance and whether claims are plausible and evidence-bounded. DiscoveryRSI-27B achieved a 6.3% rate of hypothesis correspondence with research published after the model cutoff, largely outperform GPT-6 with 2.5% and Claude Opus 5 with 2.3%, while delivering greater human-rated improvement along research paths.&quot;,&quot;thumbnail&quot;:&quot;https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2610.23839.png&quot;,&quot;numComments&quot;:2,&quot;upvoted&quot;:false,&quot;submittedBy&quot;:{&quot;_id&quot;:&quot;64fde4e252e82dd432b74ce9&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64fde4e252e82dd432b74ce9/-CQZbBP7FsPPyawYrsi4z.jpeg&quot;,&quot;fullname&quot;:&quot;Ling Yang&quot;,&quot;name&quot;:&quot;Lingaaaaaaa&quot;,&quot;type&quot;:&quot;user&quot;,&quot;isPro&quot;:false,&quot;isHf&quot;:false,&quot;isHfAdmin&quot;:false,&quot;isMod&quot;:false,&quot;followerCount&quot;:22,&quot;isUserFollowing&quot;:false},&quot;organization&quot;:{&quot;_id&quot;:&quot;6aab7c097e5721f5e005ff0a&quot;,&quot;name&quot;:&quot;PhAILabs&quot;,&quot;fullname&quot;:&quot;PhAI Labs&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64fde4e252e82dd432b74ce9/5-hyYwAMko5JVJz5qWxEj.png&quot;},&quot;isAuthorParticipating&quot;:false},{&quot;paper&quot;:{&quot;id&quot;:&quot;2610.08699&quot;,&quot;authors&quot;:[{&quot;_id&quot;:&quot;6ac6e1244eb8005165aed294&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;64d761b98ebc40443831f82a&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64d761b98ebc40443831f82a/DHBOtOstiFp2-lDY6b9gb.png&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Guangyi Liu&quot;,&quot;user&quot;:&quot;lgy0404&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;lgy0404&quot;},&quot;name&quot;:&quot;Guangyi Liu&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2026-10-08T13:56:00.504Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ac6e1244eb8005165aed295&quot;,&quot;name&quot;:&quot;Yong Liu&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6ac6e1244eb8005165aed296&quot;,&quot;name&quot;:&quot;Jiangning Zhang&quot;,&quot;hidden&quot;:false}],&quot;mediaUrls&quot;:[&quot;https://cdn-uploads.huggingface.co/production/uploads/64d761b98ebc40443831f82a/6EEDcp2yMHSgKNeAI6HxO.mp4&quot;,&quot;https://cdn-uploads.huggingface.co/production/uploads/64d761b98ebc40443831f82a/MRp8DMVyMd1Y14s83KQpk.png&quot;],&quot;publishedAt&quot;:&quot;2026-10-06T00:00:00.000Z&quot;,&quot;submittedOnDailyAt&quot;:&quot;2026-10-08T00:00:00.000Z&quot;,&quot;title&quot;:&quot;nanoMuse: An Open-Source Personal Agent for Every Device You Own&quot;,&quot;submittedOnDailyBy&quot;:{&quot;_id&quot;:&quot;64d761b98ebc40443831f82a&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64d761b98ebc40443831f82a/DHBOtOstiFp2-lDY6b9gb.png&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Guangyi Liu&quot;,&quot;user&quot;:&quot;lgy0404&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;lgy0404&quot;},&quot;summary&quot;:&quot;Assistants from 2011 answered and waited, and agents from 2023 did a task and stopped. In September 2026 Meta's Muse showed an agent for one person, with accounts, devices, memory and a conversation that lasts, closed, in a vendor's cloud, in one country. Such an agent is expected to act on a person's accounts and devices, remember them across weeks, speak first when it is worth it, and answer for what it did. It is a kind of software, not a model, and until now had no open counterpart. This report defines the personal agent in five questions and three horizons. It reads how Muse is built from Meta's public record and a copy of its production prompt, each statement marked by its source. It then presents nanoMuse, the open-source counterpart under the GPL-3.0, one agent on every device a person owns, with hands on the phone's screen and the computer's. They share one conversation over a relay anyone can run; every action goes through a Sentinel, memory is files the person can read, and the model is their choice. Its size and cost are given as estimates. What is open, memory with provenance, an evaluation suite for the hands and an open model for them, is set out as a roadmap.&quot;,&quot;upvotes&quot;:115,&quot;discussionId&quot;:&quot;6ac6e1264eb8005165aed297&quot;,&quot;projectPage&quot;:&quot;https://nanomuse.cn/&quot;,&quot;githubRepo&quot;:&quot;https://github.com/nano-muse/nanoMuse&quot;,&quot;githubRepoAddedBy&quot;:&quot;user&quot;,&quot;githubStars&quot;:1524,&quot;organization&quot;:{&quot;_id&quot;:&quot;61bac2af530e5c78d7b99667&quot;,&quot;name&quot;:&quot;zju&quot;,&quot;fullname&quot;:&quot;Zhejiang University&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/5e1058e9fcf41d740b69966d/7G1xjlxwCdMEmKcxNR0n5.png&quot;}},&quot;publishedAt&quot;:&quot;2026-10-05T20:00:00.000Z&quot;,&quot;title&quot;:&quot;nanoMuse: An Open-Source Personal Agent for Every Device You Own&quot;,&quot;summary&quot;:&quot;Assistants from 2011 answered and waited, and agents from 2023 did a task and stopped. In September 2026 Meta's Muse showed an agent for one person, with accounts, devices, memory and a conversation that lasts, closed, in a vendor's cloud, in one country. Such an agent is expected to act on a person's accounts and devices, remember them across weeks, speak first when it is worth it, and answer for what it did. It is a kind of software, not a model, and until now had no open counterpart. This report defines the personal agent in five questions and three horizons. It reads how Muse is built from Meta's public record and a copy of its production prompt, each statement marked by its source. It then presents nanoMuse, the open-source counterpart under the GPL-3.0, one agent on every device a person owns, with hands on the phone's screen and the computer's. They share one conversation over a relay anyone can run; every action goes through a Sentinel, memory is files the person can read, and the model is their choice. Its size and cost are given as estimates. What is open, memory with provenance, an evaluation suite for the hands and an open model for them, is set out as a roadmap.&quot;,&quot;mediaUrls&quot;:[&quot;https://cdn-uploads.huggingface.co/production/uploads/64d761b98ebc40443831f82a/6EEDcp2yMHSgKNeAI6HxO.mp4&quot;,&quot;https://cdn-uploads.huggingface.co/production/uploads/64d761b98ebc40443831f82a/MRp8DMVyMd1Y14s83KQpk.png&quot;],&quot;thumbnail&quot;:&quot;https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2610.08699.png&quot;,&quot;numComments&quot;:3,&quot;upvoted&quot;:false,&quot;submittedBy&quot;:{&quot;_id&quot;:&quot;64d761b98ebc40443831f82a&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/64d761b98ebc40443831f82a/DHBOtOstiFp2-lDY6b9gb.png&quot;,&quot;fullname&quot;:&quot;Guangyi Liu&quot;,&quot;name&quot;:&quot;lgy0404&quot;,&quot;type&quot;:&quot;user&quot;,&quot;isPro&quot;:false,&quot;isHf&quot;:false,&quot;isHfAdmin&quot;:false,&quot;isMod&quot;:false,&quot;followerCount&quot;:4,&quot;isUserFollowing&quot;:false},&quot;organization&quot;:{&quot;_id&quot;:&quot;61bac2af530e5c78d7b99667&quot;,&quot;name&quot;:&quot;zju&quot;,&quot;fullname&quot;:&quot;Zhejiang University&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/5e1058e9fcf41d740b69966d/7G1xjlxwCdMEmKcxNR0n5.png&quot;},&quot;isAuthorParticipating&quot;:true},{&quot;paper&quot;:{&quot;id&quot;:&quot;2512.14692&quot;,&quot;authors&quot;:[{&quot;_id&quot;:&quot;6942c666fb33037a39577c28&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;6513df3175940371506cb73e&quot;,&quot;avatarUrl&quot;:&quot;/avatars/5f48fd02377f62864c5db5555b9bf413.svg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Jianfeng Xiang&quot;,&quot;user&quot;:&quot;JeffreyXiang&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;JeffreyXiang&quot;},&quot;name&quot;:&quot;Jianfeng Xiang&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2025-12-29T14:25:19.582Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6942c666fb33037a39577c29&quot;,&quot;name&quot;:&quot;Xiaoxue Chen&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6942c666fb33037a39577c2a&quot;,&quot;name&quot;:&quot;Sicheng Xu&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6942c666fb33037a39577c2b&quot;,&quot;name&quot;:&quot;Ruicheng Wang&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6942c666fb33037a39577c2c&quot;,&quot;name&quot;:&quot;Zelong Lv&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6942c666fb33037a39577c2d&quot;,&quot;name&quot;:&quot;Yu Deng&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6942c666fb33037a39577c2e&quot;,&quot;name&quot;:&quot;Hongyuan Zhu&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6942c666fb33037a39577c2f&quot;,&quot;name&quot;:&quot;Yue Dong&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6942c666fb33037a39577c30&quot;,&quot;name&quot;:&quot;Hao Zhao&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6942c666fb33037a39577c31&quot;,&quot;name&quot;:&quot;Nicholas Jing Yuan&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6942c666fb33037a39577c32&quot;,&quot;name&quot;:&quot;Jiaolong Yang&quot;,&quot;hidden&quot;:false}],&quot;publishedAt&quot;:&quot;2025-12-16T18:58:28.000Z&quot;,&quot;title&quot;:&quot;Native and Compact Structured Latents for 3D Generation&quot;,&quot;summary&quot;:&quot;Recent advancements in 3D generative modeling have significantly improved the generation realism, yet the field is still hampered by existing representations, which struggle to capture assets with complex topologies and detailed appearance. This paper present an approach for learning a structured latent representation from native 3D data to address this challenge. At its core is a new sparse voxel structure called O-Voxel, an omni-voxel representation that encodes both geometry and appearance. O-Voxel can robustly model arbitrary topology, including open, non-manifold, and fully-enclosed surfaces, while capturing comprehensive surface attributes beyond texture color, such as physically-based rendering parameters. Based on O-Voxel, we design a Sparse Compression VAE which provides a high spatial compression rate and a compact latent space. We train large-scale flow-matching models comprising 4B parameters for 3D generation using diverse public 3D asset datasets. Despite their scale, inference remains highly efficient. Meanwhile, the geometry and material quality of our generated assets far exceed those of existing models. We believe our approach offers a significant advancement in 3D generative modeling.&quot;,&quot;upvotes&quot;:9,&quot;discussionId&quot;:&quot;6942c666fb33037a39577c33&quot;,&quot;projectPage&quot;:&quot;https://microsoft.github.io/TRELLIS.2/&quot;,&quot;githubRepo&quot;:&quot;https://github.com/microsoft/TRELLIS.2&quot;,&quot;githubRepoAddedBy&quot;:&quot;user&quot;,&quot;ai_summary&quot;:&quot;A new sparse voxel representation called O-Voxel enables high-quality 3D generative modeling with efficient inference and robust topology handling.&quot;,&quot;ai_keywords&quot;:[&quot;sparse voxel structure&quot;,&quot;O-Voxel&quot;,&quot;omni-voxel representation&quot;,&quot;geometry&quot;,&quot;appearance&quot;,&quot;physically-based rendering parameters&quot;,&quot;Sparse Compression VAE&quot;,&quot;flow-matching models&quot;],&quot;ai_summary_model&quot;:&quot;Qwen/Qwen2.5-Coder-32B-Instruct&quot;,&quot;githubStars&quot;:12305,&quot;organization&quot;:{&quot;_id&quot;:&quot;5e6485f787403103f9f1055e&quot;,&quot;name&quot;:&quot;microsoft&quot;,&quot;fullname&quot;:&quot;Microsoft&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/1583646260758-5e64858c87403103f9f1055d.png&quot;}},&quot;publishedAt&quot;:&quot;2025-12-16T13:58:28.000Z&quot;,&quot;title&quot;:&quot;Native and Compact Structured Latents for 3D Generation&quot;,&quot;summary&quot;:&quot;Recent advancements in 3D generative modeling have significantly improved the generation realism, yet the field is still hampered by existing representations, which struggle to capture assets with complex topologies and detailed appearance. This paper present an approach for learning a structured latent representation from native 3D data to address this challenge. At its core is a new sparse voxel structure called O-Voxel, an omni-voxel representation that encodes both geometry and appearance. O-Voxel can robustly model arbitrary topology, including open, non-manifold, and fully-enclosed surfaces, while capturing comprehensive surface attributes beyond texture color, such as physically-based rendering parameters. Based on O-Voxel, we design a Sparse Compression VAE which provides a high spatial compression rate and a compact latent space. We train large-scale flow-matching models comprising 4B parameters for 3D generation using diverse public 3D asset datasets. Despite their scale, inference remains highly efficient. Meanwhile, the geometry and material quality of our generated assets far exceed those of existing models. We believe our approach offers a significant advancement in 3D generative modeling.&quot;,&quot;thumbnail&quot;:&quot;https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2512.14692.png&quot;,&quot;numComments&quot;:2,&quot;upvoted&quot;:false,&quot;organization&quot;:{&quot;_id&quot;:&quot;5e6485f787403103f9f1055e&quot;,&quot;name&quot;:&quot;microsoft&quot;,&quot;fullname&quot;:&quot;Microsoft&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/1583646260758-5e64858c87403103f9f1055d.png&quot;},&quot;isAuthorParticipating&quot;:false},{&quot;paper&quot;:{&quot;id&quot;:&quot;2610.18861&quot;,&quot;authors&quot;:[{&quot;_id&quot;:&quot;6acf03c0abe004a210f25c7e&quot;,&quot;name&quot;:&quot;Jiaru Zou&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf03c0abe004a210f25c7f&quot;,&quot;name&quot;:&quot;Yunzhe Qi&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf03c0abe004a210f25c80&quot;,&quot;name&quot;:&quot;Sirui Chen&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf03c0abe004a210f25c81&quot;,&quot;name&quot;:&quot;Federico Bianchi&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf03c0abe004a210f25c82&quot;,&quot;name&quot;:&quot;Shang Zhu&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf03c0abe004a210f25c83&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;60f5f68fa7fd83d025749234&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/60f5f68fa7fd83d025749234/gCeJAZfzaANAcEvI6v5-P.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Pan Lu&quot;,&quot;user&quot;:&quot;lupantech&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;lupantech&quot;},&quot;name&quot;:&quot;Pan Lu&quot;,&quot;status&quot;:&quot;claimed_verified&quot;,&quot;statusLastChangedAt&quot;:&quot;2026-10-15T08:45:06.620Z&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf03c0abe004a210f25c84&quot;,&quot;name&quot;:&quot;Jingrui He&quot;,&quot;hidden&quot;:false},{&quot;_id&quot;:&quot;6acf03c0abe004a210f25c85&quot;,&quot;name&quot;:&quot;James Zou&quot;,&quot;hidden&quot;:false}],&quot;mediaUrls&quot;:[&quot;https://cdn-uploads.huggingface.co/production/uploads/65c288280aa2d53135734a42/weQ2uwvNYnlUxwIJVc_ou.mp4&quot;],&quot;publishedAt&quot;:&quot;2026-10-13T00:00:00.000Z&quot;,&quot;submittedOnDailyAt&quot;:&quot;2026-10-15T00:00:00.000Z&quot;,&quot;title&quot;:&quot;Hybrid Reasoning Agents&quot;,&quot;submittedOnDailyBy&quot;:{&quot;_id&quot;:&quot;65c288280aa2d53135734a42&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/65c288280aa2d53135734a42/5WHmau52EaRS01TOMI3Qg.jpeg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Jiaru (Rubin) Zou&quot;,&quot;user&quot;:&quot;jiaruz2&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;jiaruz2&quot;},&quot;summary&quot;:&quot;How can we build an agent that thinks beyond human language, yet still acts through it in the external environment? Modern LLM agents still reason and interact through text, while latent reasoning offers an efficient internal medium but lacks native tool access and reasoning transparency. We bridge these two directions with Hybrid Reasoning Agents (HybridAgents), which dynamically navigate between latent reasoning and text-based interaction throughout a unified generation process. Architecturally, a lightweight HybridLink enables seamless transitions between text and latent modes, while the agent's continuous working memory preserves lossless hybrid context across multiple turns. These designs preserve tool-integrated agentic capabilities while making latent thoughts directly inspectable. Building on this architecture, we further develop dedicated post-training algorithms for hybrid reasoning: HybridSFT stabilizes tool-integrated hybrid generation by teaching the backbone to coordinate with HybridLink, then HybridRL scales reasoning by learning when to think in latent space and when to act through text. We evaluate HybridAgent at 3 model scales across 11 benchmarks covering mathematics, science, medicine, search, and agentic reasoning. Compared with frontier LLM Agents and agentic frameworks spanning both text-based and latent methods, HybridAgent consistently improves performance by 10.4%, while delivering 35.5%-54.7% token reduction, 1.8x-2.6x faster inference, and 2.7x-3.7x cost savings. Code and data are available at https://github.com/togethercomputer/HybridAgent.&quot;,&quot;upvotes&quot;:38,&quot;discussionId&quot;:&quot;6acf03c0abe004a210f25c86&quot;,&quot;githubRepo&quot;:&quot;https://github.com/togethercomputer/HybridAgent&quot;,&quot;githubRepoAddedBy&quot;:&quot;user&quot;,&quot;ai_summary&quot;:&quot;Hybrid Reasoning Agents combine latent internal reasoning with text-based external interaction via a unified architecture and specialized post-training, improving agent performance while reducing inference cost and token usage.&quot;,&quot;ai_keywords&quot;:[&quot;Hybrid Reasoning Agents&quot;,&quot;HybridLink&quot;,&quot;latent reasoning&quot;,&quot;text-based interaction&quot;,&quot;working memory&quot;,&quot;HybridSFT&quot;,&quot;HybridRL&quot;,&quot;tool-integrated agentic capabilities&quot;],&quot;ai_summary_model&quot;:&quot;thinkingmachines/Inkling-Small&quot;,&quot;githubStars&quot;:281,&quot;organization&quot;:{&quot;_id&quot;:&quot;672c672dcf09d152f4da04c4&quot;,&quot;name&quot;:&quot;StanfordUniversity&quot;,&quot;fullname&quot;:&quot;Stanford University&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/68e396f2b5bb631e9b2fac9a/vJI0POlzGMXL2878t1vz2.jpeg&quot;}},&quot;publishedAt&quot;:&quot;2026-10-12T20:00:00.000Z&quot;,&quot;title&quot;:&quot;Hybrid Reasoning Agents&quot;,&quot;summary&quot;:&quot;How can we build an agent that thinks beyond human language, yet still acts through it in the external environment? Modern LLM agents still reason and interact through text, while latent reasoning offers an efficient internal medium but lacks native tool access and reasoning transparency. We bridge these two directions with Hybrid Reasoning Agents (HybridAgents), which dynamically navigate between latent reasoning and text-based interaction throughout a unified generation process. Architecturally, a lightweight HybridLink enables seamless transitions between text and latent modes, while the agent's continuous working memory preserves lossless hybrid context across multiple turns. These designs preserve tool-integrated agentic capabilities while making latent thoughts directly inspectable. Building on this architecture, we further develop dedicated post-training algorithms for hybrid reasoning: HybridSFT stabilizes tool-integrated hybrid generation by teaching the backbone to coordinate with HybridLink, then HybridRL scales reasoning by learning when to think in latent space and when to act through text. We evaluate HybridAgent at 3 model scales across 11 benchmarks covering mathematics, science, medicine, search, and agentic reasoning. Compared with frontier LLM Agents and agentic frameworks spanning both text-based and latent methods, HybridAgent consistently improves performance by 10.4%, while delivering 35.5%-54.7% token reduction, 1.8x-2.6x faster inference, and 2.7x-3.7x cost savings. Code and data are available at https://github.com/togethercomputer/HybridAgent.&quot;,&quot;mediaUrls&quot;:[&quot;https://cdn-uploads.huggingface.co/production/uploads/65c288280aa2d53135734a42/weQ2uwvNYnlUxwIJVc_ou.mp4&quot;],&quot;thumbnail&quot;:&quot;https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2610.18861.png&quot;,&quot;numComments&quot;:2,&quot;upvoted&quot;:false,&quot;submittedBy&quot;:{&quot;_id&quot;:&quot;65c288280aa2d53135734a42&quot;,&quot;avatarUrl&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/65c288280aa2d53135734a42/5WHmau52EaRS01TOMI3Qg.jpeg&quot;,&quot;fullname&quot;:&quot;Jiaru (Rubin) Zou&quot;,&quot;name&quot;:&quot;jiaruz2&quot;,&quot;type&quot;:&quot;user&quot;,&quot;isPro&quot;:false,&quot;isHf&quot;:false,&quot;isHfAdmin&quot;:false,&quot;isMod&quot;:false,&quot;followerCount&quot;:17,&quot;isUserFollowing&quot;:false},&quot;organization&quot;:{&quot;_id&quot;:&quot;672c672dcf09d152f4da04c4&quot;,&quot;name&quot;:&quot;StanfordUniversity&quot;,&quot;fullname&quot;:&quot;Stanford University&quot;,&quot;avatar&quot;:&quot;https://cdn-avatars.huggingface.co/v1/production/uploads/68e396f2b5bb631e9b2fac9a/vJI0POlzGMXL2878t1vz2.jpeg&quot;},&quot;isAuthorParticipating&quot;:false},{&quot;paper&quot;:{&quot;id&quot;:&quot;2509.22186&quot;,&quot;authors&quot;:[{&quot;_id&quot;:&quot;68d9ebf80177a6054b013a58&quot;,&quot;user&quot;:{&quot;_id&quot;:&quot;650abbb71aece923f21d87fc&quot;,&quot;avatarUrl&quot;:&quot;/avatars/f09ff031c278bc42bfd7a563853e142c.svg&quot;,&quot;isPro&quot;:false,&quot;fullname&quot;:&quot;Junbo Niu&quot;,&quot;user&quot;:&quot;Niujunbo2002&quot;,&quot;type&quot;:&quot;user&quot;,&quot;name&quot;:&quot;Ni