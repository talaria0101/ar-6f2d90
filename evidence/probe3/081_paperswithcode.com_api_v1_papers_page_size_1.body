loading="lazy" src="https://cdn-thumbnails.huggingface.co/social-thumbnails/papers/2504.19413.png" decoding="async" alt="" class="size-full object-cover object-center opacity-80 dark:opacity-70 dark:invert invisible" onload="this.__e=event" onerror="this.__e=event"/></div><!----></a><!--]--> <!--[0--><div class="shadow-xs pointer-events-none absolute bottom-2 right-2 flex h-6 items-center gap-1 whitespace-nowrap rounded-md border bg-white px-2 text-xs leading-none text-gray-700 dark:bg-gray-900 dark:text-gray-400">Submitted by <div class="flex-none  "><img alt="" loading="lazy" class="max-w-none size-2.5 rounded-full  flex-none select-none " src="https://cdn-avatars.huggingface.co/v1/production/uploads/1674929746905-60f1abe7544c2adfd699860c.jpeg" crossorigin="anonymous"/> <!--[-1--><!--]--></div><!----> akhaliq</div><!--]--></div> <div class="from-gray-50-to-white bg-linear-to-b p-4"><h3 class="mb-2 text-lg font-semibold text-gray-900 hover:underline dark:text-white"><a href="/papers/2504.19413" class="line-clamp-2 cursor-pointer">Mem0: Building Production-Ready AI Agents with Scalable Long-Term Memory</a></h3> <!--[0--><div class="mb-2"><p class="line-clamp-2 text-sm text-gray-600 dark:text-gray-300">Mem0, a memory-centric architecture with graph-based memory, enhances long-term conversational coherence in LLMs by efficiently extracting, consolidating, and retrieving information, outperforming existing memory systems in terms of accuracy and computational efficiency.</p></div><!--]--> <div class="mb-3 flex items-center text-sm text-gray-500 dark:text-gray-400"><!--[-1--><!--[0--><ul class="flex items-center text-gray-600  flex-row-reverse    text-xs mr-1.5"><!--[--><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="Taranjeet Singh" style="content-visibility:auto;"><!--[-1--><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="Saket Aryan" style="content-visibility:auto;"><!--[-1--><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="Dev Khant" style="content-visibility:auto;"><!--[-1--><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="deshrajdry" style="content-visibility:auto;"><!--[1--><img class="overflow-hidden" alt="" src="https://cdn-avatars.huggingface.co/v1/production/uploads/64b397bf93679cd00945624e/yQnWK5uve6pMavzn4bR33.jpeg" loading="lazy"/><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="prateekchhikara" style="content-visibility:auto;"><!--[1--><img class="overflow-hidden" alt="" src="https://cdn-avatars.huggingface.co/v1/production/uploads/1675107437601-noauth.png" loading="lazy"/><!--]--></li><!--]--> <!--[0--><li class="text-xs hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300 order-first ml-2"><!--[--><span>5 authors</span><!--]--></li><!--]--></ul><!--]--><!--]--> <!--[0--><span class="mx-1">·</span> <span>Apr 28, 2025</span><!--]--></div> <div class="flex flex-col gap-2"><div class="flex flex-wrap items-center gap-2.5 pt-1 !pt-0 z-1 lg:sticky lg:top-8"><!--[0--><a href="/login?next=%2Fpapers%2F2504.19413" class="self-start"><!--[0--><!----><div role="checkbox" class="shadow-alternate group flex h-9 cursor-pointer select-none items-center gap-2 rounded-lg border pl-3 pr-3.5 border-gray-300 bg-w