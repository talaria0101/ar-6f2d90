" decoding="async" alt="" class="size-full object-cover object-center opacity-80 dark:opacity-70 dark:invert invisible" onload="this.__e=event" onerror="this.__e=event"/></div><!----></a><!--]--> <!--[0--><div class="shadow-xs pointer-events-none absolute bottom-2 right-2 flex h-6 items-center gap-1 whitespace-nowrap rounded-md border bg-white px-2 text-xs leading-none text-gray-700 dark:bg-gray-900 dark:text-gray-400">Submitted by <div class="flex-none  "><img alt="" loading="lazy" class="max-w-none size-2.5 rounded-full  flex-none select-none " src="https://cdn-avatars.huggingface.co/v1/production/uploads/6039478ab3ecf716b1a5fd4d/_Thy4E7taiSYBLKxEKJbT.jpeg" crossorigin="anonymous"/> <!--[-1--><!--]--></div><!----> taesiri</div><!--]--></div> <div class="from-gray-50-to-white bg-linear-to-b p-4"><h3 class="mb-2 text-lg font-semibold text-gray-900 hover:underline dark:text-white"><a href="/papers/2509.22186" class="line-clamp-2 cursor-pointer">MinerU2.5: A Decoupled Vision-Language Model for Efficient
  High-Resolution Document Parsing</a></h3> <!--[0--><div class="mb-2"><p class="line-clamp-2 text-sm text-gray-600 dark:text-gray-300">MinerU2.5, a 1.2B-parameter document parsing vision-language model, achieves state-of-the-art recognition accuracy with computational efficiency through a coarse-to-fine parsing strategy.</p></div><!--]--> <div class="mb-3 flex items-center text-sm text-gray-500 dark:text-gray-400"><!--[-1--><!--[0--><ul class="flex items-center text-gray-600  flex-row-reverse    text-xs "><!--[--><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="ouyanglinke" style="content-visibility:auto;"><!--[1--><img class="overflow-hidden" alt="" src="/avatars/8f7c252675fd8a096794d12971903722.svg" loading="lazy"/><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="wanderkid" style="content-visibility:auto;"><!--[1--><img class="overflow-hidden" alt="" src="https://cdn-avatars.huggingface.co/v1/production/uploads/1672388558183-noauth.jpeg" loading="lazy"/><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="Chokoyo" style="content-visibility:auto;"><!--[1--><img class="overflow-hidden" alt="" src="/avatars/a83a185edd78157e459b4c0fa6aabfde.svg" loading="lazy"/><!--]--></li><li class="    -mr-1.5 h-3 w-3 md:h-4 md:w-4 bg-linear-to-br block flex-none rounded-full border-2 border-white from-gray-300 to-gray-100 dark:border-gray-900 dark:from-gray-600 dark:to-gray-800 " title="starriver030515" style="content-visibility:auto;"><!--[1--><img class="overflow-hidden" alt="" src="/avatars/22f201dc