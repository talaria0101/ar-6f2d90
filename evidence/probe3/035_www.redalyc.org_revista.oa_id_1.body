<body>
<script type="text/javascript">
	  /**
		evento de visita
	  */
	  gtag('event', 'screen_view', {
	    'app_name': 'PortalRedalyc',
	    'screen_name': 'HomeRevista'
	  });
	  gtag('event', 'page_view', {
		  'page_title': 'HomeRevista',
		  'page_location': 'https://redalyc.org/revista.oa'
	  });
	</script>
	<header class="header">
		<input id="pageLanguaje" type="hidden" />
	
		<input id="circle1Data1" type="hidden" />
