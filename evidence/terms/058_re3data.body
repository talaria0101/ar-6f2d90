    <script id="swagger-data" type="application/json">{"spec":{"swagger":"2.0","info":{"title":"re3data - registry of research data repositories","version":"1.0.0"},"paths":{"/api/v40/repositories":{"get":{"summary":"Returns an index list of repositories","description":"The easiest way to build a filter query is to use the search and facetting at\n\u003Ca href=\"https://www.re3data.org/search\"\u003Ere3data.org\u003C/a\u003E, apply the desired\nfilters, and then copy the query string from the browser URL directly to this endpoint.","produces":["application/xml"],"parameters":[{"name":"query","in":"query","required":false,"description":"Filter by search term, e.g. 'WDCC'","type":"string"},{"name":"aidSystems[]","in":"query","required":false,"description":"Filter by author identifier systems, e.g. 'ORCID'","type":"string"},{"name":"apis[]","in":"query","required":false,"description":"Filter by APIs, e.g. 'SPARQL'","type":"string"},{"name":"certificates[]","in":"query","required":false,"description":"Filter by certificates, e.g. 'CoreTrustSeal'","type":"string"},{"name":"citationReferences[]","in":"query","required":false,"description":"Filter by citation references, e.g. 'SCOPUS'","type":"string"},{"name":"contentType40[]","in":"query","required":false,"description":"Filter by content types (schema 4.0), e.g. 'software'","type":"string"},{"name":"countries[]","in":"query","required":false,"description":"Filter by institution countries, e.g. 'NZL'","type":"string"},{"name":"dataAccess[]","in":"query","required":false,"description":"Filter by data access, e.g. 'open'","type":"string"},{"name":"dataAccessRestrictions[]","in":"query","required":false,"description":"Filter by data access restrictions, e.g. 'feeRequired'","type":"string"},{"name":"databaseAccess[]","in":"query","required":false,"description":"Filter by database access, e.g. 'restricted'","type":"string"},{"name":"databaseAccessRestrictions[]","in":"query","required":false,"description":"Filter by database access restrictions, e.g. 'registration'","type":"string"},{"name":"databaseLicenses[]","in":"query","required":false,"description":"Filter by database licenses, e.g. 'CC0'","type":"string"},{"name":"dataLicenses[]","in":"query","required":false,"description":"Filter by data licenses, e.g. 'BSD'","type":"string"},{"name":"dataUploads[]","in":"query","required":false,"description":"Filter by data upload, e.g. 'closed'","type":"string"},{"name":"dataUploadRestrictions[]","in":"query","required":false,"description":"Filter by data upload restrictions, e.g. 'institutional membership'","type":"string"},{"name":"enhancedPublication[]","in":"query","required":false,"description":"Filter by enhanced publication, e.g. 'yes'","type":"string"},{"name":"institutionType[]","in":"query","required":false,"description":"Filter by institution type, e.g. 'commercial'","type":"string"},{"name":"keywords[]","in":"query","required":false,"description":"Filter by keywords, e.g. 'FAIR'","type":"string"},{"name":"metadataStandard40[]","in":"query","required":false,"description":"Filter by metadata standards (schema 4.0), e.g. 'DCAT-AP'","type":"string"},{"name":"metrics[]","in":"query","required":false,"description":"Filter by metrics, e.g. 'Altmetric'","type":"string"},{"name":"pidSystems[]","in":"query","required":false,"description":"Filter by persistent identifier systems, e.g. 'DOI'","type":"string"},{"name":"profiles[]","in":"query","required":false,"description":"Filter by profiles, e.g. 'Helmholtz Association'","type":"string"},{"name":"providerTypes[]","in":"query","required":false,"description":"Filter by provider type, e.g. 'serviceProvider'","type":"string"},{"name":"qualityManagement[]","in":"query","required":false,"description":"Filter by quality management, e.g. 'yes'","type":"string"},{"name":"repositoryLanguages[]","in":"query","required":false,"description":"Filter by repository languages, e.g. 'fin'","type":"string"},{"name":"responsibilityTypes[]","in":"query","required":false,"description":"Filter by institution responsibility types, e.g. 'technical'","type":"string"},{"name":"software[]","in":"query","required":false,"description":"Filter by software, e.g. 'CKAN'","type":"string"},{"name":"subjects[]","in":"query","required":false,"description":"Filter by subjects (schema 4.0), e.g. '11204'","type":"string"},{"name":"syndications[]","in":"query","required":false,"description":"Filter by syndications, e.g. 'RSS'","type":"string"},{"name":"types[]","in":"query","required":false,"description":"Filter by repository types, e.g. 'institutional'","type":"string"},{"name":"versioning[]","in":"query","required":false,"description":"Filter by versioning capabilities, e.g. 'yes'","type":"string"}],"responses":{"200":{"description":"Returned when the list could be successfully generated."},"404":{"description":"Returned when an error occurred. Please send a bug report in this case."},"500":{"description":"Returned when an error occurred. Please send a bug report in this case."}},"tags":["Version 4.0"]}},"/api/v40/repository/{id}":{"get":{"summary":"Returns a repository description","produces":["application/xml"],"parameters":[{"name":"id","in":"path","required":true,"description":"The re3data identifier of the repository, e.g. 'r3d100000001'","type":"string"}],"responses":{"200":{"description":"Returned when the repository was found."},"404":{"description":"Returned when the repository could not be found."},"500":{"description":"Returned when an error occurred. Please send a bug report in this case."}},"tags":["Version 4.0"]}},"/api/beta/repositories":{"get":{"summary":"Returns a index list of repositories","description":"A GET-Request will return a an XML-Document following the HATEOAS-Principles\n\nExample:\u003Cbr\u003E\n&lt;list&gt;\u003Cbr\u003E\n     &nbsp;&lt;repository&gt;\u003Cbr\u003E\n          &nbsp;&nbsp;&lt;id&gt;r3d100000000&lt;/id&gt;\u003Cbr\u003E\n          &nbsp;&nbsp;&lt;doi&gt;https://doi.org/10.17616/R3D&lt;/doi&gt;\u003Cbr\u003E\n          &nbsp;&nbsp;&lt;link href=&quot;/api/beta/repository/r3d100000000&quot; rel=&quot;self&quot;/&gt;\u003Cbr\u003E\n     &nbsp;&lt;/repository&gt;\u003Cbr\u003E\n&lt;/list&gt;\u003Cbr\u003E\n\nYou can parse the list and follow the links pointing to the repositorios\nto retrieve a detailed representation.\n\nIn addition to that it is possible to filter the list via GET-Parameters.\nThe filter parameters (except the \"query\") are designed as arrays so you\ncan apply them multiple times.\n\nHere is an example in which all repositories in Canada within the life and\nnatural sciences providing DOIs are queried \u003Ca href=\"https://www.re3data.org/api/beta/repositories?query=&countries%5B%5D=CAN&subjects%5B%5D=2%20Life%20Sciences&subjects%5B%5D=3%20Natural%20Sciences&pidSystems%5B%5D=DOI\"\u003EExample \u003C/a\u003E","produces":["application/xml"],"parameters":[{"name":"query","in":"query","required":false,"description":"Filter by search term, e.g. 'biosharing'","type":"string"},{"name":"aidSystems[]","in":"query","required":false,"description":"Filter by the author identifier systems, e.g. 'ORCID'","type":"string"},{"name":"apis[]","in":"query","required":false,"description":"Filter by APIs, e.g. 'SPARQL'","type":"string"},{"name":"certificates[]","in":"query","required":false,"description":"Filter by certificates, e.g. 'DSA'","type":"string"},{"name":"contentTypes[]","in":"query","required":false,"description":"Filter by content types, e.g. 'Raw data'","type":"string"},{"name":"countries[]","in":"query","required":false,"description":"Filter by institution countries, e.g. 'CAN'","type":"string"},{"name":"dataAccess[]","in":"query","required":false,"description":"Filter by data access , e.g. 'open'","type":"string"},{"name":"dataAccessRestrictions[]","in":"query","required":false,"description":"Filter by data access restrictions, e.g. 'feeRequired'","type":"string"},{"name":"databaseAccess[]","in":"query","required":false,"description":"Filter by database access, e.g. 'restricted'","type":"string"},{"name":"databaseAccessRestrictions[]","in":"query","required":false,"description":"Filter by database access, e.g. 'registration'","type":"string"},{"name":"databaseLicenses[]","in":"query","required":false,"description":"Filter by database licenses, e.g. 'Public Domain'","type":"string"},{"name":"dataLicenses[]","in":"query","required":false,"description":"Filter by data licenses, e.g. 'CC0'","type":"string"},{"name":"dataUploads[]","in":"query","required":false,"description":"Filter by data upload, e.g. 'open'","type":"string"},{"name":"dataUploadRestrictions[]","in":"query","required":false,"description":"Filter by data upload restrictions, e.g. 'institutional membership'","type":"string"},{"name":"enhancedPublication[]","in":"query","required":false,"description":"Filter by enhanced publication, e.g. 'yes'","type":"string"},{"name":"institutionType[]","in":"query","required":false,"description":"Filter by the institution types, e.g. 'commercial'","type":"string"},{"name":"keywords[]","in":"query","required":false,"description":"Filter by keywords, e.g. 'DNA'","type":"string"},{"name":"metadataStandards[]","in":"query","required":false,"description":"Filter by metadata standards, e.g. 'DCAT - Data Catalog Vocabulary'","type":"string"},{"name":"pidSystems[]","in":"query","required":false,"description":"Filter by persistent identifier systems, e.g. 'DOI'","type":"string"},{"name":"providerTypes[]","in":"query","required":false,"description":"Filter by provider type, e.g. 'dataProvider'","type":"string"},{"name":"qualityManagement[]","in":"query","required":false,"description":"Filter by quality management, e.g. 'yes'","type":"string"},{"name":"repositoryLanguages[]","in":"query","required":false,"description":"Filter by repository languages, e.g. 'deu'","type":"string"},{"name":"responsibilityTypes[]","in":"query","required":false,"description":"Filter by institutions responsibility types, e.g. 'funding'","type":"string"},{"name":"software[]","in":"query","required":false,"description":"Filter by software, e.g. 'CKAN'","type":"string"},{"name":"subjects[]","in":"query","required":false,"description":"Filter by subjects, e.g. '104 Linguistics'","type":"string"},{"name":"syndications[]","in":"query","required":false,"description":"Filter by syndications, e.g. 'RSS'","type":"string"},{"name":"types[]","in":"query","required":false,"description":"Filter by repository types, e.g. 'disciplinary'","type":"string"},{"name":"versioning[]","in":"query","required":false,"description":"Filter by versioning capabilities, e.g. 'yes'","type":"string"}],"responses":{"200":{"description":"Returned when the list could be successfully generated."},"404":{"description":"Returned when error occured. Please send a bug report in this case."},"500":{"description":"Returned when error occured. Please send a bug report in this case."}},"tags":["Beta"]}},"/api/beta/repository/{id}":{"get":{"summary":"Returns a repository description","produces":["application/xml"],"parameters":[{"name":"id","in":"path","required":true,"type":"string"}],"responses":{"200":{"description":"Returned when the list could be successfully generated."},"404":{"description":"Returned when repository could not be found."},"500":{"description":"Returned when error occured. Please send a bug report in this case."}},"tags":["Beta"]}},"/api/v1/repositories":{"get":{"summary":"Returns a index list of repositories","description":"A GET-Request will return a an XML-Document following the HATEOAS-Principles\n\nExample:\u003Cbr\u003E\n&lt;list&gt;\u003Cbr\u003E\n     &nbsp;&lt;repository&gt;\u003Cbr\u003E\n          &nbsp;&nbsp;&lt;id&gt;r3d100000000&lt;/id&gt;\u003Cbr\u003E\n          &nbsp;&nbsp;&lt;doi&gt;https://doi.org/10.17616/R3D&lt;/doi&gt;\u003Cbr\u003E\n          &nbsp;&nbsp;&lt;link href=&quot;/api/beta/repository/r3d100000000&quot; rel=&quot;self&quot;/&gt;\u003Cbr\u003E\n     &nbsp;&lt;/repository&gt;\u003Cbr\u003E\n&lt;/list&gt;\u003Cbr\u003E\n\nYou can parse the content and follow the links related to the repositorios\nto retrieve a detailed representation.","produces":["application/xml"],"responses":{"200":{"description":"Returned when the list could be successfully generated."},"404":{"description":"Returned when error occured. Please send a bug report in this case."},"500":{"description":"Returned when error occured. Please send a bug report in this case."}},"tags":["Version 1"]}},"/api/v1/repository/{id}":{"get":{"summary":"Returns a repository description","produces":["application/xml"],"parameters":[{"name":"id","in":"path","required":true,"type":"string"}],"responses":{"200":{"description":"Returned when the list could be successfully generated."},"404":{"description":"Returned when repository could not be found."},"500":{"description":"Returned when error occured. Please send a bug report in this case."}},"tags":["Version 1"]}},"/api/opensearch/suggest":{"get":{"summary":"Returns suggestions for open search","parameters":[{"name":"search","in":"query","required":false,"description":"Search string","type":"string"}],"responses":{"200":{"description":"Returned when successful"}},"tags":["OpenSearch"]}},"/api/opensearch/opensearch.xml":{"get":{"summary":"Returns XML for open search","responses":{"200":{"description":"Returned when successful"}},"tags":["OpenSearch"]}}},"tags":[{"name":"Version 4.0","description":"Current API based on the re3data metadata schema 4.0"},{"name":"OpenSearch","description":"OpenSearch interface"},{"name":"Beta","description":"Deprecated"},{"name":"Version 1","description":"Deprecated"}]}}</script>
    </head>
